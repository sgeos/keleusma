// A fixed-point scaling round trip, written so the native differential can
// COMPARE the two conversion opcodes rather than merely accept them.
//
// `opcode_witness.kel` witnesses many opcodes but refuses to lower as a whole,
// because one refusing chunk exempts the module. Nothing in it is compared. This
// file uses ONLY opcodes the backend accepts, so it lowers, executes, and is
// checked against the virtual machine on every argument vector.
//
// WHAT IS EXERCISED, and the boundary is deliberate:
//
//   `w as Fixed<16>` -> WordToFixed(16), which the VM SATURATES at the word's
//                       MAX/MIN rather than wrapping.
//   `f as Word`      -> FixedToWord(16), an arithmetic right shift.
//
// The `lsl 46` puts the saturation boundary inside the range the harness drives:
// the conversion shifts a further 16 bits, so `w << 62` is representable at
// w = 1 and saturates from w = 2 upward. Both regimes are therefore compared,
// and w = 0 covers the zero case the VM handles separately.
//
// That shift is chosen to span the boundary, and saying so is the point: this
// is a coverage program, not an application, and the file declares it rather
// than pretending otherwise.

fn scale_and_back(w: Word) -> Word {
  let big = w lsl 46;
  let f = big as Fixed<16>;
  f as Word
}

// A Q-format multiply, added once `FixedMul` lowered. The VM SATURATES here
// rather than wrapping -- `fixed_checked_outputs` in `vm.rs` states the contrast
// with the checked families explicitly -- so a large product is a compared case
// and not an edge one.
fn scaled_square(w: Word) -> Word {
  // `lsl 30` before the conversion is what puts the PRODUCT past the saturation
  // boundary. Without it the harness drives w in 0..19, the square stays around
  // 2.4 million, and the clamp is never reached -- measured, not assumed:
  // bypassing the clamp produced NO disagreement until this shift was added.
  let f = (w lsl 30) as Fixed<16>;
  let p = f * f;
  p as Word
}

// **THE NEGATIVE SATURATION BRANCH, which nothing reached until this existed.**
//
// Every argument vector the differential supplies is NON-NEGATIVE:
// `args_for_seed` yields `(i+1)*3+1`, `5`, `0`, `(n-i)*3+1`, then `k-4` for
// k in 4..23. So `shifted < MIN` could never fire, and the MIN clamp of both
// conversions and the multiply was unverified while the suite was green.
// Measured, not assumed: disabling the MIN clamp alone produced NO disagreement.
//
// The PROGRAM produces the negative rather than the harness being reshaped to
// supply one -- changing `args_for_seed` to emit negatives would be tuning the
// input generator to this file, which is the move refused elsewhere in this
// corpus for the same reason.
fn negative_scale(w: Word) -> Word {
  let neg = 0 - w;
  let big = neg lsl 46;
  let f = big as Fixed<16>;
  f as Word
}

// **A NEGATIVE PRODUCT.** `scaled_square` cannot reach `FixedMul`'s MIN clamp:
// a square is never negative. Measured the same way -- disabling that clamp
// alone produced no disagreement until this function existed.
fn negative_product(w: Word) -> Word {
  let a = ((0 - w) lsl 30) as Fixed<16>;
  let b = (w lsl 30) as Fixed<16>;
  let p = a * b;
  p as Word
}

fn main(w: Word) -> Word {
  scale_and_back(w) + scaled_square(w) + negative_scale(w) + negative_product(w)
}
