// src/selfhost/kel/verify_types.kel -- the self-hosted TYPE REJECTION stage.
//
// **Rejection only, and that is a measured scope rather than a simplification.**
// Two spikes shrank the Order-1 type-checker obligation to this. Monomorphization is an identity
// transform on all ten stage sources, pinned by `tests/selfhost_monomorphize_identity.rs`. And
// clearing `program.fn_expr_types` leaves every stage module byte-identical, so the emitter's
// structural fallback covers everything the subset reaches and INFERENCE FOR EMISSION IS NOT
// REQUIRED. What remains is deciding that an ill-typed program is ill-typed, and this stage needs
// exactly as much type propagation as that decision takes.
//
// **The oracle is VERDICT agreement, not message agreement.** Accept versus reject, which is what
// the `verify_*.kel` family already uses. Reproducing the reference's English would commit this
// stage to diagnostics the reference is free to reword.
//
// **The two directions are NOT symmetric, unlike the structural verifier's.** `verify_structural`
// and friends may over-approximate and defer to a runtime guard. A type checker may not: rejecting
// a valid program is a LANGUAGE CHANGE, not a conservative choice. So:
//
//   the reference accepts  ->  this stage MUST accept. A false rejection narrows the language.
//   the reference rejects  ->  this stage must reject, for the enumerated shapes.
//
// The second is bounded by a corpus; the first is not, which is why the well-typed side of the
// corpus grows with every slice rather than staying at the controls the sizing spike used.
//
// SLICES 1 to 5: operand agreement, call arity and argument types, name resolution, conditions,
// and structural claims about composites.
//
// SLICE 0, WHICH THIS REPLACED: no rules, `verdict` always ACCEPT. That is the point rather than
// a placeholder -- the corpus must then show every well-typed case agreeing and every ill-typed
// case DISAGREEING, and a harness reporting success here is broken. Finding that out costs nothing
// before a rule exists, and costs a great deal afterwards.
//
// See `docs/decisions/TYPECHECK_IMPLEMENTATION_PLAN.md` for the six slices and the fifteen shapes.
require word >= 32;

// The host-facing block. `cmd` selects the operation; `verdict` carries the answer out.
//
// The input surface is deliberately EMPTY at slice 0. The stage cannot yet see the program, and
// stating that in the encoding is better than accepting a table nothing reads: a reader of this
// file can tell at a glance that a passing corpus here proves the harness works and nothing about
// type checking.
// SLICE 1 gives the stage its first input: a table of OPERAND PAIRS, each a
// place where two values must agree in type.
//
// **The tags are SYNTACTIC, and that is what keeps the oracle honest.** They
// come from literal kinds in the parse tree -- `1` is an integer, `true` is a
// bool -- not from the reference's inference. Marshalling inferred types would
// make the stage agree with the reference by construction and prove nothing.
// An operand whose type is not syntactically evident is tag 0, UNKNOWN, and an
// unknown pair is not a rejection: this stage may not reject a valid program.
shared data ty {
    cmd: Word,
    verdict: Word,
    // Operand pairs. `n` rows of (left tag, right tag).
    n: Word,
    lhs: [Word; 256],
    rhs: [Word; 256],
    // SLICE 2: call sites, as (declared parameter count, actual argument
    // count). Arity is PURELY SYNTACTIC -- it needs no types at all -- which is
    // why it is the cheapest of the fifteen shapes to reach and why two of them
    // fall to one comparison.
    //
    // A call to a name with no declaration contributes NO row. Undefined
    // functions are slice 3, and inventing a declared count of zero for one
    // would reject it here for a reason this slice cannot defend.
    cn: Word,
    cdecl: [Word; 128],
    cact: [Word; 128],
    // SLICES 4 and 5: conditions that must be bool, and structural claims about
    // a composite. Both are "a tag must equal a required tag", so they share one
    // table of (actual, required) rather than growing a channel each.
    //
    // A required tag of 0 means "no requirement" and never rejects, which is how
    // a construct this stage cannot type stays silent rather than guessing.
    qn: Word,
    qact: [Word; 256],
    qreq: [Word; 256],
    // THE LAST TWO SHAPES: a field access naming a field its type does not
    // declare, and a body whose type differs from the declared return type.
    //
    // Membership is a table of 1/0 rather than names, because the stage compares
    // rather than searches: the host supplies the syntactic fact "this field is
    // among that type's declared fields", and the RULE -- that a referenced
    // field must exist -- is the stage's. That is the same division the
    // verify_*.kel family uses, where the host marshals op tables and the stage
    // applies the algorithm.
    mn: Word,
    member: [Word; 256],
    // PART 2 SLICE a: declarations and call sites arrive SEPARATELY and the
    // stage joins them.
    //
    // **A migrated channel that still receives the answer is not a migration.**
    // The host may say "this call names declaration 3 and passes 2 arguments";
    // it may NOT say "this call has the wrong arity". The lookup is the work,
    // and the work is what moves.
    //
    //   dparams[f]  the declared parameter count of function f
    //   csite[c]    the declaration index this call names
    //   cargs[c]    how many arguments it passes
    //
    // APPENDED LAST, so no existing slot index moves. Inserting these in the
    // middle is exactly what broke four tests on the first attempt: the shared
    // block is addressed by SLOT, and every field after the insertion point
    // silently shifted.
    dn: Word,
    dparams: [Word; 128],
    csn: Word,
    csite: [Word; 128],
    cargs: [Word; 128],
    // PART 2 SLICE b: struct field sets and field accesses arrive SEPARATELY
    // and the stage SEARCHES.
    //
    // This is the channel where the copy was most obvious: the host answered
    // "is this field declared" and the stage compared its answer to zero. Now
    // the host says "type 2, field name 7" and the stage looks.
    //
    // Names are compared as interned INDICES rather than bytes, because the
    // stage has no string type and the host already assigns every name an
    // index. Two spellings of one name would be two indices and the search
    // would miss -- so the index space must be shared, which it is: one table
    // for every name mentioned by either side.
    //
    //   sfirst[t]/scount[t]  type t's declared field names, as a run in sfield
    //   sfield[i]            a declared field name index
    //   atype[a]/aname[a]    an access: the type, and the field name it names
    //
    // Appended last, per the convention slice a learned the hard way.
    stn: Word,
    sfirst: [Word; 64],
    scount: [Word; 64],
    sfield: [Word; 256],
    an: Word,
    atype: [Word; 256],
    aname: [Word; 256],
    // Scratch for the field search. A field rather than a local because this
    // file follows `wire.kel`'s convention of carrying loop state in the data
    // block, and because a total language has no early exit: the search sets a
    // flag and runs to its bound rather than returning from inside the loop.
    hit: Word,
    // PART 2 SLICE c: name occurrences and the declared sets arrive SEPARATELY
    // and the stage CLASSIFIES.
    //
    // The host says "occurrence 4 names index 12, and it is a call". It does
    // not say "that is an undefined function". Classification is the work.
    //
    //   dname[d]   a declared name index, for the whole top-level set
    //   oname[o]   the name index this occurrence mentions
    //   olocal[o]  1 when the occurrence resolves to a local or parameter
    //   ocall[o]   1 when the occurrence is a CALL rather than a value read
    //
    // Appended last.
    dnn: Word,
    dname: [Word; 128],
    on: Word,
    oname: [Word; 256],
    olocal: [Word; 256],
    ocall: [Word; 256],
    // A program the collector could not decide about at all, for instance one
    // with a wildcard import bringing in names it cannot enumerate. The stage
    // then makes no resolution claim, because a name it cannot see is not
    // evidence of anything and a rejection would narrow the language.
    oskip: Word,
    // PART 2 SLICE d: EXPRESSION NODES, the last channel and the largest.
    //
    // A flat table, one row per node the checker cares about. The host reports
    // the SHAPE; the stage decides what the shape means.
    //
    //   ekind[e]   what the node is        1 binop  2 array element
    //                                      3 condition  4 branch pair
    //                                      5 field access on a value
    //                                      6 index on a value
    //                                      7 struct literal
    //                                      8 function tail against its return
    //   ea[e]/eb[e]  the two quantities the kind compares. For a binop they are
    //                operand tags; for a struct literal, declared and actual
    //                field counts; for a condition, the tag and 0.
    //
    // ONE TABLE RATHER THAN ONE PER KIND. Every rule here is "these two must
    // agree" or "this must be bool", and a channel per kind would multiply the
    // slot chain that has already produced two off-by-one defects.
    //
    // Appended last.
    en: Word,
    ekind: [Word; 256],
    ea: [Word; 256],
    eb: [Word; 256],
    // SLICE 6: LOCAL RESOLUTION. Until this, `ea`/`eb` were always tags, so a
    // rule could only fire where the operand was a literal. Every ill-typed case
    // in the corpus placed its operands as literals, so that limit was invisible
    // and the stage accepted `let b = true; 1 + b`, which the reference rejects.
    //
    // `eaf[e]`/`ebf[e]` give the FORM of each operand:
    //   0  the value is a TAG, as before
    //   1  the value is a NAME id, and the stage resolves it here
    //
    // THE HOST SUPPLIES SYNTAX; THE STAGE DOES THE JOIN. A declared parameter
    // type, a declared return type and a literal initialiser are all written in
    // the source, so the host may read them off and hand over `(name, tag)`
    // rows. What it may NOT hand over is the conclusion that a given OPERAND has
    // a given type -- that join is this stage's whole job, and marshalling it
    // would make the stage agree with the reference by construction, which is
    // the same objection recorded at the top of this file against inferred tags.
    //
    // Appended last.
    bn: Word,
    bname: [Word; 128],
    btag: [Word; 128],
    // The FORM of each binding row, so an initialiser that is not a literal can
    // still be reported syntactically:
    //   0  `btag[b]` is a tag        -- `fn f(a: Word)`, `let b = true`
    //   1  `btag[b]` is a NAME id    -- `let a = g()`, which binds `a` to `g`
    //
    // Form 1 exists so the host does not have to chain. `let a = g()` says only
    // that `a` takes whatever `g` returns; turning that into a TAG needs `g`'s
    // declared return row as well, and performing that join host-side is exactly
    // what this slice moved into the stage.
    bform: [Word; 128],
    alias: Word,
    eaf: [Word; 256],
    ebf: [Word; 256],
}

// The verdict constants, named rather than spelled as bare integers at the call sites, so a later
// slice adding a rejection code cannot collide with the accept value by accident.
fn ty_accept() -> Word { 0 }

fn ty_reject() -> Word { 0 - 1 }

fn ty_unknown() -> Word { 0 }

// Two operands disagree when BOTH are known and they differ.
//
// **The unknown case accepts, and the asymmetry is the whole of the soundness
// argument.** `verify_*.kel` may over-approximate because an over-approximation
// defers to a runtime guard. A type checker has no such latitude in the
// accepting direction: rejecting a valid program is a LANGUAGE CHANGE. So an
// operand this slice cannot type is not evidence of anything, and silence is
// the only sound answer.
fn ty_pair_disagrees(l: Word, r: Word) -> Word {
    if l == ty_unknown() { 0 } else {
    if r == ty_unknown() { 0 } else {
    if l == r { 0 } else { 1 } } }
}

// Slice 1: reject when any operand pair disagrees.
//
// The loop runs to completion rather than stopping at the first disagreement,
// because the language is total and there is nothing to break out of. The
// verdict is sticky, which also means a second disagreement cannot un-reject a
// program.
// Whether type `t` declares field name `f`.
//
// A linear walk of the type's own run, which is the right shape here for the
// same reason the interner's dedup scan is: the language is TOTAL and has no
// early exit, so a loop that finds the answer on its first step still costs its
// full bound. A structure that beat a scan would have to beat it at field
// counts a struct actually has, and those are single digits.
//
// `nm.found`-style state rather than a return inside the loop, because there is
// nothing to return early from.
fn ty_field_declared(t: Word, f: Word) -> Word {
    ty.hit = 0;
    for i in 0..ty_bounded(ty.scount[t]) limit 64 {
        ty.hit = if ty.sfield[ty.sfirst[t] + i] == f { 1 } else { ty.hit };
    }
    ty.hit
}

// A count clamped to its table bound.
//
// `for .. limit` traps on ENTRY when the runtime range exceeds the static cap,
// so an oversize count must never reach a loop. The same shape the producer's
// `mi_bounded` uses, for the same reason.
fn ty_bounded(v: Word) -> Word {
    if v > 64 { 0 } else { v }
}

// How many occurrences to classify. Zero when the collector could not decide.
fn ty_occurrences() -> Word {
    if ty.oskip == 1 { 0 } else { ty.on }
}

// Whether a top-level declaration carries this name.
fn ty_declared(f: Word) -> Word {
    ty.hit = 0;
    for i in 0..ty_bounded128(ty.dnn) limit 128 {
        ty.hit = if ty.dname[i] == f { 1 } else { ty.hit };
    }
    ty.hit
}

fn ty_bounded128(v: Word) -> Word {
    if v > 128 { 0 } else { v }
}

// The two refusals, derived rather than received.
//
//   a local that is CALLED  -- a V0.2.0 SURFACE RESTRICTION, not a type error,
//                              and the one shape carrying no `type error:`
//                              prefix in the reference
//   neither local nor declared -- an unresolved name
//
// A local read as a VALUE is fine, and a declared name called or read is fine,
// so the two conditions are written out rather than folded into one test.
fn ty_occurrence_bad(o: Word) -> Word {
    if ty.olocal[o] == 1 {
        if ty.ocall[o] == 1 { 1 } else { 0 }
    } else {
        if ty_declared(ty.oname[o]) == 1 { 0 } else { 1 }
    }
}

// A node kind requiring its two quantities to be EQUAL.
//
// Binops, array elements, branch pairs, struct-literal field counts and a
// function tail against its return type are all one claim wearing five names.
fn ty_kind_is_equality(k: Word) -> Word {
    if k == 1 { 1 } else {
    if k == 2 { 1 } else {
    if k == 4 { 1 } else {
    if k == 7 { 1 } else {
    if k == 8 { 1 } else { 0 } } } } }
}

// A node kind requiring a COMPOSITE rather than a scalar.
fn ty_kind_needs_composite(k: Word) -> Word {
    if k == 5 { 1 } else {
    if k == 6 { 1 } else { 0 } }
}

// Whether a node is a rejection.
//
// The unknown tag never rejects, for the reason established in slice 1: this
// stage may not reject a valid program, so a shape it cannot type is silence
// rather than a guess. A struct-literal count of 0 is a real count and not an
// unknown, which is why the equality kinds test the KIND before the values.
fn ty_node_bad(k: Word, a: Word, b: Word) -> Word {
    if ty_kind_is_equality(k) == 1 {
        if k == 7 {
            // Counts, where 0 is a real value rather than "unknown".
            if a == b { 0 } else { 1 }
        } else { ty_pair_disagrees(a, b) }
    } else {
    if ty_kind_needs_composite(k) == 1 {
        // The operand is a known scalar, which a field access or an index
        // cannot be. The host reports the tag; a 0 means it could not tell.
        if a == ty_unknown() { 0 } else { 1 }
    } else {
    if k == 3 {
        // A condition must be bool.
        ty_pair_disagrees(a, 2)
    } else { 0 } } }
}

// Resolve one operand to a tag.
//
// Form 0 is already a tag. Form 1 is a NAME id, looked up in the binding table;
// **a name with no binding resolves to UNKNOWN, not to a rejection.** That is the
// direction the whole file leans: an operand this stage cannot type is not an
// operand it may refuse, because rejecting a valid program is a language change
// rather than a conservative choice.
//
// A LINEAR SCAN, capped at the table size. The subset binds few names per
// function and a total language has no early exit, so a map would cost more than
// it saves -- the same reasoning `intern_run`'s batch-local scan records.
fn ty_direct(v: Word) -> Word {
    ty.hit = ty_unknown();
    for b in 0..ty.bn limit 128 {
        ty.hit = if ty.bname[b] == v {
            // Form 0 states a tag outright. Form 2 is a DERIVED initialiser whose
            // tag the solver proved before the fold began; both are direct as far
            // as a lookup is concerned, and keeping them in one arm is what stops
            // a rule from reaching one and missing the other.
            if ty.bform[b] == 0 { ty.btag[b] } else {
            if ty.bform[b] == 2 { tyb.bres[b] } else { ty.hit } }
        } else { ty.hit };
    }
    ty.hit
}

fn ty_alias_of(v: Word) -> Word {
    ty.alias = 0;
    for b in 0..ty.bn limit 128 {
        ty.alias = if ty.bname[b] == v {
            if ty.bform[b] == 1 { ty.btag[b] } else { ty.alias }
        } else { ty.alias };
    }
    ty.alias
}

// THE DERIVED-OPERAND SOLVER'S SCRATCH.
//
// `bres[b]` is the tag the solver has proved for binding `b`, or 0 for "not
// proved". PRIVATE, for the same reason the cursors below are: the host supplies
// SYNTAX, and a conclusion it could write here is exactly the join this stage
// exists to perform.
private data tyb {
    bres: [Word; 128],
    // Set when a round proved something it had not proved before, so the loop can
    // stop early on a fixpoint instead of always running its full cap.
    moved: Word,
    // Scratch for one node's two operand tags while a round resolves them.
    la: Word,
    lb: Word,
}

// HOW MANY ROUNDS THE DERIVED-OPERAND SOLVER RUNS.
//
// A DECLARED CAP, NOT A DISCOVERED ONE. Each round can prove a binding whose
// operands were proved in the round before, so `k` rounds reach a chain of `k`
// derived bindings: `let a = 1 + 2; let b = a + 1; let c = b + 1` needs three.
// Four is what the corpus needs plus margin; a program with a longer chain
// resolves to UNKNOWN and is therefore ACCEPTED, which is the safe direction and
// the same one `ty_resolve`'s single alias hop already takes.
//
// **This must never become "as many rounds as it takes".** The language is total
// and every loop needs a static bound; a fixpoint that runs until nothing moves
// still needs a cap, and naming it here is what keeps the bound visible.
fn tyb_rounds() -> Word { 4 }

// The tag of binding `b` as the solver has proved it, or 0.
fn tyb_of(v: Word) -> Word {
    ty.hit = ty_unknown();
    for b in 0..ty.bn limit 128 {
        ty.hit = if ty.bname[b] == v {
            if tyb.bres[b] != 0 { tyb.bres[b] } else { ty.hit }
        } else { ty.hit };
    }
    ty.hit
}

// One operand of an expression row, resolved to a tag.
//
// Form 0 is already a tag. Form 1 is a NAME, which resolves first against the
// solver's proved bindings and then against the declared rows, so a derived
// binding and a declared one are reached by the same call.
fn tyb_operand(v: Word, f: Word) -> Word {
    if f == 0 { v } else {
        ty.hit = tyb_of(v);
        if ty.hit != 0 { ty.hit } else { ty_resolve(1, v) }
    }
}

// The tag expression node `e` yields, or 0 when the stage cannot prove one.
//
// ONLY A BINOP, AND ONLY WHEN BOTH OPERANDS AGREE. A binop over two operands of
// the same type yields that type; over disagreeing operands it yields nothing,
// because the disagreement is itself the rejection and inventing a result would
// hide it. Every other node kind yields 0, which accepts.
fn tyb_node_tag(e: Word) -> Word {
    if ty.ekind[e] == 1 {
        tyb.la = tyb_operand(ty.ea[e], ty.eaf[e]);
        tyb.lb = tyb_operand(ty.eb[e], ty.ebf[e]);
        if tyb.la != 0 andalso tyb.la == tyb.lb { tyb.la } else { ty_unknown() }
    } else {
        ty_unknown()
    }
}

// Prove what can be proved, in at most `tyb_rounds()` passes.
//
// A BOUNDED FIXPOINT RATHER THAN A LOOKUP, which is what the derived-operand gap
// always needed: `let a = 1 + 2` is knowable only after both its operands are,
// and `let b = a + 1` only after `a`. Each round walks every binding once; a
// round that proves nothing new stops the loop.
fn tyb_solve() -> Word {
    for b in 0..ty.bn limit 128 {
        tyb.bres[b] = 0;
    }
    tyb.moved = 1;
    for r in 0..tyb_rounds() limit 8 {
        if tyb.moved == 1 {
            tyb.moved = 0;
            for b in 0..ty.bn limit 128 {
                if ty.bform[b] == 2 andalso tyb.bres[b] == 0 {
                    tyb.bres[b] = tyb_node_tag(ty.btag[b]);
                    tyb.moved = if tyb.bres[b] != 0 { 1 } else { tyb.moved };
                }
            }
        }
    }
    0
}

fn ty_resolve(f: Word, v: Word) -> Word {
    if f == 0 { v } else {
        ty.hit = ty_direct(v);
        if ty.hit == 0 {
            // ONE ALIAS HOP, AND THE BOUND IS DELIBERATE. `let a = g()` binds
            // `a` to the name `g`, whose declared return type is a direct row,
            // so one hop reaches it. A longer chain -- `let a = g(); let c = a;`
            // -- resolves to UNKNOWN and therefore ACCEPTS, which is the safe
            // direction: this stage may not refuse a program it cannot type.
            //
            // A bounded hop count rather than a fixpoint because the language is
            // total and every loop needs a static cap. Raising the bound is a
            // decision about how much chaining to admit, not a bug fix.
            ty.alias = ty_alias_of(v);
            if ty.alias == 0 { ty_unknown() } else { ty_direct(ty.alias) }
        } else { ty.hit }
    }
}

// --- THE FOLD, AS A RESUMABLE STREAM ----------------------------------------
//
// `ty_check` used to run all eight tables in ONE call and return the verdict.
// The rules were already a single forward fold, so nothing about the analysis
// needed the whole corpus resident -- only the ENTRY did. This stage is now a
// coroutine in the same shape as its nine siblings (`lexer`, `parse`,
// `reconstruct`, `codegen`, `analyze` and the four other verifiers), which is
// what the windowed-compiler goal asks for.
//
// WHY THE CURSORS ARE PRIVATE AND NOT SHARED. `ty` is a shared block, so the
// host may rewrite any of it between resumes -- that is the point of shared
// data. A cursor living there could be reset mid-fold, and the stage would
// silently re-walk a table or skip one with no signal. Private data persists
// across the loop's RESET and the host cannot reach it, so the position is the
// stage's own.
private data tyc {
    // Which table is being folded, 0..=7. `tyc_phases()` means finished.
    phase: Word,
    // Row cursor within the current table.
    i: Word,
    // The running verdict, folded across every row of every table.
    verdict: Word,
}

fn tyc_phases() -> Word { 8 }

// PENDING, yielded by a step that advanced the fold without finishing it.
//
// 63 rather than a fresh number, because that is what the streaming stages
// already use and a second convention for the same idea is how two readers come
// to disagree. It cannot collide with a verdict: `ty_accept` is 0 and
// `ty_reject` is -1, so a yielded 63 is unambiguously "not done yet".
fn tyc_pending() -> Word { 63 }

// How many rows the current window holds for phase `p`.
//
// Read from the shared block on every step rather than captured once, so a host
// that refills a table between resumes is honoured rather than ignored.
fn tyc_count(p: Word) -> Word {
    if p == 0 { ty.n } else {
    if p == 1 { ty.cn } else {
    if p == 2 { ty.csn } else {
    if p == 3 { ty_occurrences() } else {
    if p == 4 { ty.en } else {
    if p == 5 { ty.qn } else {
    if p == 6 { ty.mn } else {
    if p == 7 { ty.an } else {
    0 }}}}}}}}
}

// Whether row `i` of phase `p` rejects. One arm per rule, and every arm is the
// SAME predicate the one-shot fold applied, moved rather than rewritten.
fn tyc_row_rejects(p: Word, i: Word) -> Word {
    if p == 0 {
        ty_pair_disagrees(ty.lhs[i], ty.rhs[i])
    } else {
    if p == 1 {
        // Arity is exact rather than a bound: too FEW and too MANY arguments are
        // both rejections, and they are the same comparison rather than two rules.
        if ty.cdecl[i] == ty.cact[i] { 0 } else { 1 }
    } else {
    if p == 2 {
        // THE JOIN. Each call site names a declaration; the stage reads that
        // declaration's parameter count and compares. A site naming an index
        // outside the declaration table is REFUSED rather than skipped: an
        // out-of-range index means the host and the stage disagree about the
        // table, and guessing which is right would hide it.
        if ty.csite[i] >= ty.dn { 1 } else {
            if ty.dparams[ty.csite[i]] == ty.cargs[i] { 0 } else { 1 } }
    } else {
    if p == 3 {
        // A local that is CALLED is refused, and so is a name that is neither
        // local nor declared. Both are computed from facts, not received as
        // verdicts.
        ty_occurrence_bad(i)
    } else {
    if p == 4 {
        // THE EXPRESSION RULES, applied from shapes rather than received as
        // verdicts, with each operand resolved through the binding table.
        ty_node_bad(ty.ekind[i], ty_resolve(ty.eaf[i], ty.ea[i]), ty_resolve(ty.ebf[i], ty.eb[i]))
    } else {
    if p == 5 {
        // A required tag of 0 is no requirement, so this reuses the operand
        // pairs' disagreement predicate: unknown never rejects.
        ty_pair_disagrees(ty.qact[i], ty.qreq[i])
    } else {
    if p == 6 {
        // A referenced field must be declared. Only 0 rejects: a row the host
        // could not decide is not written at all, so absence and denial stay
        // distinct.
        if ty.member[i] == 0 { 1 } else { 0 }
    } else {
    if p == 7 {
        // THE SEARCH. Each access names a type and a field; the stage walks that
        // type's declared run looking for the name.
        if ty.atype[i] >= ty.stn { 1 } else {
            if ty_field_declared(ty.atype[i], ty.aname[i]) == 1 { 0 } else { 1 } }
    } else {
    0 }}}}}}}}
}

// One step of the fold: at most one row, and no unbounded work.
//
// Three cases, in this order. Finished, so repeated resumes keep reporting the
// same verdict rather than running off the end. A table exhausted, so advance to
// the next one. Otherwise fold one row.
//
// ADVANCING THE PHASE COSTS ITS OWN STEP rather than looping to the next
// non-empty table. A loop here would be bounded by the phase count and so still
// total, but it would make the number of steps depend on how many tables are
// empty, and a host counting resumes against a bound should not have to model
// that.
fn ty_step() -> Word {
    // THE SOLVER RUNS ONCE, BEFORE THE FIRST ROW OF THE FIRST TABLE.
    //
    // It reads the whole binding table and the whole expression table, so it is
    // the one part of this stage that is not row-at-a-time. That is inherent
    // rather than incidental: a derived binding's tag depends on operands that
    // may be bound later in the table, so no forward pass over rows can prove it.
    // The cost is bounded by `tyb_rounds()` passes over at most 128 bindings.
    //
    // Guarded on `phase == 0 andalso i == 0` rather than on a "did I run" flag,
    // because the host may refill the tables and restart the fold, and a flag
    // would leave the second run using the first run's conclusions.
    if tyc.phase == 0 andalso tyc.i == 0 {
        tyb_solve();
    }
    if tyc.phase >= tyc_phases() {
        tyc.verdict
    } else {
    if tyc.i >= tyc_count(tyc.phase) {
        tyc.phase = tyc.phase + 1;
        tyc.i = 0;
        tyc_pending()
    } else {
        tyc.verdict = if tyc_row_rejects(tyc.phase, tyc.i) == 1 {
            ty_reject()
        } else {
            tyc.verdict
        };
        tyc.i = tyc.i + 1;
        tyc_pending()
    } }
}

// The most resumes a complete fold can need, so a host can bound its drive loop
// rather than trusting the stage to terminate.
//
// One step per row across every table at its cap, one step per phase boundary,
// and one to report the verdict. Stated as a function so the host reads it from
// here instead of restating a sum that would drift the moment a cap moves.
fn ty_max_steps() -> Word { 256 + 128 + 128 + 256 + 256 + 256 + 256 + 256 + 8 + 1 }

// `resume` is unused: this stage has one job and no commands. It is named rather
// than dropped because a Stream function's parameter slot is rewritten on every
// resume, so a reader should see that nothing depends on it.
loop main(resume: Word) -> Word {
    yield ty_step()
}
