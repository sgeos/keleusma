// compiler/kel/verify_datalayout.kel -- the self-hosted module-level data-layout validation of
// the A.2.1 typed pass (reference `verify_typed.rs::validate_data_layout`), audit findings B6 and
// C4, over the field-based layout of Encoding F, one entry per declared field.
//
// The checks, see the reference for the full rationale:
//   * Tiling: no field has a zero count, each field's first slot is the running sum of the counts
//     before it, and the total stays within the 24-bit slot space.
//   * B6 prefix: every shared field precedes every private field.
//   * B6 bounds: a shared field has an offset, carries the host-initialised form, and its last
//     element's extent (`offset + (count - 1) * stride + size`) lies within the shared buffer.
//     The host precomputes `size`, the composite body length or the scalar size at the module
//     widths, as -1 for an undecodable kind.
//   * Initialiser: a private field taking the zero of its kind needs a kind that has one. The
//     host supplies `zeroable` from the one kind-to-zero table, `crate::bytecode::data_kind_zero`.
//   * C4 placement: a private field without an offset carries no stride; a pooled private field
//     holds a flat composite with a non-zero body, its elements do not overlap, and the pooled
//     fields are ascending, disjoint, and end within the persistent composite pool.
//
// The fields are fed to this stage in batches of 256 by resuming the coroutine: phase 0 resets
// the running state, phase 1 checks the batch the host wrote with its `count`, and phase 2
// returns the verdict. The running state `io_*` persists in the shared buffer across resumes.
// The stage self-hosts the tiling, prefix, bounds and placement algorithm; the driver
// orchestrates the batching, as it does the topological resource-bound resolution for
// analyze.kel.
require word >= 32;

// The host-facing block: the batch descriptor (`phase`/`count`), the layout scalars, the running
// state `io_*` (read at the start of each batch, written back at the end), and one array per
// field column.
shared data dl {
    phase: Word,
    count: Word,
    buffer: Word,
    pool: Word,
    io_next: Word,
    io_private: Word,
    io_pool_end: Word,
    io_bad: Word,
    vis: [Word; 256],
    first: [Word; 256],
    cnt: [Word; 256],
    off: [Word; 256],
    stride: [Word; 256],
    size: [Word; 256],
    elen: [Word; 256],
    comp: [Word; 256],
    init: [Word; 256],
    zeroable: [Word; 256],
}

// One shared field, entry `i` of the batch.
fn check_shared(i: Word) -> Word {
    if dl.io_private == 1 { dl.io_bad = 1; }
    if dl.init[i] != 0 { dl.io_bad = 1; }
    if dl.off[i] < 0 { dl.io_bad = 1; }
    if dl.size[i] < 0 { dl.io_bad = 1; }
    if dl.off[i] >= 0 andalso dl.size[i] >= 0 {
        if dl.off[i] + (dl.cnt[i] - 1) * dl.stride[i] + dl.size[i] > dl.buffer { dl.io_bad = 1; }
    }
    0
}

// One private field, entry `i` of the batch.
fn check_private(i: Word) -> Word {
    dl.io_private = 1;
    if dl.init[i] == 0 andalso dl.zeroable[i] == 0 { dl.io_bad = 1; }
    if dl.off[i] < 0 {
        if dl.stride[i] != 0 { dl.io_bad = 1; }
    } else {
        if dl.comp[i] == 0 orelse dl.elen[i] == 0 { dl.io_bad = 1; }
        if dl.cnt[i] > 1 andalso dl.stride[i] < dl.elen[i] { dl.io_bad = 1; }
        if dl.off[i] < dl.io_pool_end { dl.io_bad = 1; }
        dl.io_pool_end = dl.off[i] + (dl.cnt[i] - 1) * dl.stride[i] + dl.elen[i];
        if dl.io_pool_end > dl.pool { dl.io_bad = 1; }
    }
    0
}

// Process one batch of the current `phase`, updating the running `io_*` state.
fn run() -> Word {
    if dl.phase == 0 {
        dl.io_next = 0; dl.io_private = 0; dl.io_pool_end = 0; dl.io_bad = 0;
        0
    } else { if dl.phase == 2 {
        dl.io_bad
    } else {
        for i in 0..256 limit 256 {
            if dl.count > i {
                // Tiling: a zero count, a gap or an overlap would resolve a slot to the wrong
                // field or to none.
                if dl.cnt[i] < 1 { dl.io_bad = 1; }
                if dl.first[i] != dl.io_next { dl.io_bad = 1; }
                dl.io_next = dl.io_next + dl.cnt[i];
                if dl.io_next > 16777216 { dl.io_bad = 1; }
                if dl.cnt[i] >= 1 {
                    if dl.vis[i] == 1 { check_shared(i); } else { check_private(i); }
                }
            }
        }
        0
    } }
}

loop main(resume: Word) -> Word {
    yield run()
}
