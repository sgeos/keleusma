// src/selfhost/kel/wire.kel — the wire format, written in Keleusma.
//
// Step 6 of the six-step wire-format programme: the format the Rust runtime
// reads and writes must also be producible by the self-hosted compiler, so the
// emitted artifact is made end to end by the Keleusma-written path. The plan and
// its slices are in docs/decisions/WIRE_FORMAT_SELFHOST_PLAN.md; the format
// itself is specified in docs/spec/WIRE_FORMAT.md.
//
// SLICE 1 (this file, so far): CRC-32/ISO-HDLC. A pure function over a byte
// range, computed bitwise with no lookup table, so it needs no data-dependent
// load and eight fixed iterations per byte. It is deliberately the smallest
// slice: its job is to establish the byte-buffer harness every later slice
// reuses, not to be interesting on its own. Later slices add the container
// primitives and prologue, the region directory, record tables and byte pools,
// the schema layer, the opcode stream, and the framing header.
//
// This file is NOT yet a pipeline stage. `src/selfhost/mod.rs`'s `read_stage`
// deliberately does not list it, because the self-hosted compile driver does not
// run it; `tests/selfhost_wire.rs` compiles it directly. It moves into the
// driver when it emits an artifact rather than a checksum.

// WORD WIDTH. This is `>= 64`, not the `>= 32` every pipeline stage declares, and
// the difference is load-bearing rather than cautious. The accumulator holds a
// 32-bit unsigned value in a SIGNED word, so a 32-bit word cannot represent it:
// both the initial value and the polynomial exceed the positive range of a signed
// 32-bit integer. Nothing else catches this. A source carrying those literals
// compiles for a 32-bit target without complaint when no `require` is present,
// which was verified against the reference rather than assumed, so the guard has
// to be written here or the miscompile is silent.
require word >= 64;

// The artifact buffer, used both as the input a checksum runs over and as the
// output the emitters write into. The host fills or reads `bytes`, sets the
// inputs, and drives `main` with a command.
//
// `len` may be shorter than the array; a `len` LONGER than the array does not
// read out of bounds, because the loop's `limit` caps iteration at the array size
// and the overrun then traps as `LoopLimitExceeded` rather than truncating
// silently.
//
// SLOT ORDER MATTERS TO THE HOST. `set_shared` addresses slots, not byte
// offsets, so `len` is slot 0 and `bytes[i]` is slot `1 + i`. New scalars are
// appended AFTER the array so that mapping does not shift; `lexer.kel` orders its
// shared block the same way and for the same reason.
//
// The capacity is 65536, which clears the header area at the format's 1024-region
// ceiling (48 + 48 * 1024 = 49200 bytes) with room for a small payload. The
// shared segment's own ceiling is 16 MB, so this is not close to a limit.
shared data wire {
    len: Word,
    bytes: [Byte; 65536],
    nregions: Word,
    // Per-region inputs to the directory emitter, indexed 0..nregions. `rlen` is
    // the payload length in BYTES; the emitter converts to words. `rcovers` is
    // meaningful only for a parity plane and is zero otherwise.
    rkind: [Word; 1024],
    rflags: [Word; 1024],
    rlen: [Word; 1024],
    rcovers: [Word; 1024],
    // General arguments for commands that take them: a region index, a kind to
    // look up, a record stride, a record index, a field offset. Appended last so
    // no existing slot index moves.
    warg: Word,
    warg2: Word,
    warg3: Word,
    warg4: Word,
    warg5: Word,
    // Record-field inputs for the schema emitters, in declaration order for the
    // record being written. A record has more fields than there are `warg`
    // slots, and adding a slot per field does not scale past the first record
    // kind, so the emitters read from here instead.
    //
    // It is a BATCH buffer, not a whole region. The largest real region holds
    // roughly 395,784 records, so a region's fields cannot be resident at once
    // and the host feeds them in batches while appending the output. That is
    // the staged shape the sizing measurement forced.
    //
    // Appended last so no existing slot index moves.
    fin: [Word; 1024],
    // Byte-pool input. A pool has no stride and no fields, so `fin` is the wrong
    // channel for it: a word per byte would cost eight times the space and cap a
    // batch at 1024 bytes, and `STRING_POOL` runs to 6,609,960.
    //
    // Also a BATCH buffer. 8192 bytes covers `PARAM_TYPES` whole, and the host
    // feeds the large pools in successive batches while appending the output.
    bin: [Byte; 8192],
    // Flattener scratch (slice 13). `fq` is the breadth-first queue, holding
    // PREORDER indices in the order their records are emitted; `fsz` is each
    // preorder node's subtree size, which is what locates a later sibling.
    //
    // Both are 1024 against a 341-node cap so that a malformed input cannot
    // index out of range even before the guards report it: the sibling cursor
    // is bounded by `nnodes + sum(sizes) <= 682`. Memory safety first, the
    // error code second.
    //
    // Appended last so no existing slot index moves.
    fq: [Word; 1024],
    fsz: [Word; 1024],
    // THE INTERNER'S OWN CHANNELS, split out from `fin` in slice 13b.
    //
    // Slice 12 ran the interner through `fin`, reading (length, mode) pairs and
    // compacting (offset, length) pairs back over them. That worked while the
    // interner was the only thing using `fin`. The flattener now needs `fin` for
    // a six-word-per-node preorder, which fills all 1024 words at the 170-node
    // cap, so the two cannot share it — and slice 13b has them running in ONE
    // call, because `flatten` interns as it walks.
    //
    // `nin` is (length, mode) pairs in; `nout` is (offset, length) pairs out for
    // `[0, 2*cnt)` and the input-to-index map from `nm_map_base()`. The pool is
    // still compacted in place in `bin`, which is sound for the reason recorded
    // at `intern_run`: the output cursor never overtakes the input cursor.
    nin: [Word; 1024],
    nout: [Word; 1024],
    // THE POOL'S OUTPUT BUFFER, separate from its input.
    //
    // Slice 12 compacted the pool over its own input in `bin`, justified by the
    // output cursor never overtaking the input cursor. That holds only while
    // names are interned IN INPUT ORDER. Slice 13b interns during a
    // breadth-first walk, and then it breaks: with two ten-byte names, reaching
    // the second one first copies input 10..19 over output 0..9, destroying the
    // first name's source bytes before it is read.
    //
    // A separate buffer makes the aliasing question disappear rather than
    // answering it. `bin` is now read-only to the interner.
    bout: [Byte; 8192],
}

// The running checksum. It lives in a data block because locals are immutable:
// `a = a bxor b` on a local is rejected outright with "assignment is only
// supported for data block fields", so an accumulator has nowhere else to live.
// The consequence for callers is that the checksum is STATEFUL — `crc_begin`
// must run before each independent message.
private data crc {
    acc: Word,
}

// Scratch for the disagreement scan, which needs an accumulator across loop
// iterations for the same reason the checksum does.
private data st {
    dis: Word,
    // The running word cursor while emitting the directory. A local cannot carry
    // it across iterations, for the same reason the checksum accumulator cannot.
    cur: Word,
    // A pool's pad length. Its own field rather than a borrowed one: `dis` is the
    // vote-disagreement accumulator, and reusing it here would read as a bug to
    // anyone tracing a vote.
    pad: Word,
}

// THE RANGE INVARIANT, which is why no masking appears below.
//
// `acc` is always in [0, 2^32). It starts at 2^32 - 1; folding a byte xors in a
// value under 256; a logical shift right by one leaves it under 2^31; and xoring
// the polynomial, itself under 2^32, keeps it under 2^32. So the emulated
// unsigned-32 arithmetic never needs a `band` against a 32-bit mask, and adding
// one would be dead work rather than a safety net.
//
// The invariant is what makes the shift choice non-load-bearing: `acc` is never
// negative, so `asr` would compute the same values as `lsr` here. `lsr` is still
// the correct spelling, because it is the operation the algorithm calls for and
// it stays correct if the invariant is ever weakened. A test pins the equivalence
// so that a reader who notices it finds it recorded as deliberate.

// Begin a new message. Returns the seeded accumulator so the function has a
// useful value rather than a placeholder.
fn crc_begin() -> Word {
    crc.acc = 0xFFFFFFFF;
    crc.acc
}

// Fold one byte into the running checksum and return the new accumulator.
// `byte` is expected in [0, 255]; a wider value simply xors more bits in, which
// is the caller's error rather than a fault here.
//
// The eight-iteration inner loop is a fixed range, so it needs no `limit` and
// contributes a constant factor to the worst-case bound.
fn crc_fold(byte: Word) -> Word {
    crc.acc = crc.acc bxor byte;
    for j in 0..8 {
        crc.acc = if (crc.acc band 1) == 1 {
            (crc.acc lsr 1) bxor 0xEDB88320
        } else {
            crc.acc lsr 1
        };
    }
    crc.acc
}

// Finish a message. The final complement is separate from `crc_fold` so an
// incremental producer can keep folding bytes and take the checksum only at the
// end, which is the shape the region emitters in later slices need.
fn crc_end() -> Word {
    crc.acc bxor 0xFFFFFFFF
}

// Checksum `wire.bytes[at .. at + n]`.
//
// The `limit` equals the array capacity, so the loop is statically bounded at
// 65536 iterations of eight inner steps. An `n` beyond the capacity overruns the
// cap and traps, which is the fail-loud default and is preferable to checksumming
// a silently truncated prefix.
fn crc_range(at: Word, n: Word) -> Word {
    crc_begin();
    for i in 0..n limit 65536 {
        crc_fold(wire.bytes[at + i] as Word);
    }
    crc_end()
}

// SLICE 2: container primitives, the prologue, and the majority-of-three vote.
//
// The container layout is specified in docs/spec/WIRE_FORMAT.md and implemented
// by `keleusma-wire`. The prologue is 16 bytes held in three copies at the fixed
// offsets 0, 16 and 32:
//
//   0  u32  magic, 0x4B415558, which is "KAUX" read little-endian
//   4  u16  byte-order marker, 0xFEFF
//   6  u16  format version, 2
//   8  u16  region count
//   10 u16  flags, currently zero
//   12 u32  CRC-32 of bytes 0..12
//
// The copies sit at fixed offsets BY DEFINITION rather than at offsets derived
// from a field, which is what makes them votable with no prior knowledge. A
// directory placed inside the voted block would make locating the copies depend
// on `region_count`, a field inside the block those copies exist to repair.

// --- Little-endian place-value writers -----------------------------------
//
// `as Byte` TRUNCATES silently rather than faulting: `300 as Byte` is 44. The
// explicit `band 255` is therefore not redundant with the cast. It states the
// intent at the point the byte is formed, so a value that does not fit is
// narrowed where a reader can see it rather than at an implicit conversion.

// The masking is arithmetically redundant, since `as Byte` truncates anyway,
// but `300 as Byte` being 44 with no fault is exactly the kind of narrowing a
// reader should see stated rather than inferred.
fn put_u8(at: Word, v: Word) -> Word {
    wire.bytes[at] = (v band 255) as Byte;
    at + 1
}

// Two limbs, low first, because the format is little-endian and `Word` is the
// only integer the language has. `lsr` is logical over the full word, so this is
// correct for a NEGATIVE value too — which matters, since an enum discriminant
// is a signed 64-bit field and negative discriminants are legal.
fn put_u64(at: Word, v: Word) -> Word {
    put_u32(at, v band 0xFFFFFFFF);
    put_u32(at + 4, v lsr 32);
    at + 8
}

fn put_u16(at: Word, v: Word) -> Word {
    wire.bytes[at] = (v band 255) as Byte;
    wire.bytes[at + 1] = ((v lsr 8) band 255) as Byte;
    at + 2
}

fn put_u32(at: Word, v: Word) -> Word {
    wire.bytes[at] = (v band 255) as Byte;
    wire.bytes[at + 1] = ((v lsr 8) band 255) as Byte;
    wire.bytes[at + 2] = ((v lsr 16) band 255) as Byte;
    wire.bytes[at + 3] = ((v lsr 24) band 255) as Byte;
    at + 4
}

// --- Little-endian place-value readers -----------------------------------
//
// `Byte as Word` zero-extends, so no masking is needed on the way in either.

fn get_u16(at: Word) -> Word {
    (wire.bytes[at] as Word) + ((wire.bytes[at + 1] as Word) lsl 8)
}

fn get_u32(at: Word) -> Word {
    (wire.bytes[at] as Word)
        + ((wire.bytes[at + 1] as Word) lsl 8)
        + ((wire.bytes[at + 2] as Word) lsl 16)
        + ((wire.bytes[at + 3] as Word) lsl 24)
}

// --- Emission ------------------------------------------------------------

// Write the three prologue copies for `n` regions and return the number of bytes
// written. The checksum covers the first twelve bytes of the record, so it is
// computed after those fields are in place and before the record is replicated.
fn emit_prologue(n: Word) -> Word {
    put_u32(0, 0x4B415558);
    put_u16(4, 0xFEFF);
    put_u16(6, 2);
    put_u16(8, n);
    put_u16(10, 0);
    put_u32(12, crc_range(0, 12));
    for i in 0..16 {
        wire.bytes[16 + i] = wire.bytes[i];
        wire.bytes[32 + i] = wire.bytes[i];
    }
    48
}

// --- The majority-of-three vote ------------------------------------------

// Per-BIT majority, which is what the reference computes. It is not "pick the
// value that appears at least twice": where all three copies differ, this
// synthesises a byte from the per-bit majorities, which is the stronger result
// because independent single-bit faults in different copies are all repaired.
fn maj3(a: Word, b: Word, c: Word) -> Word {
    ((a band b) bor (a band c)) bor (b band c)
}

// One voted byte of prologue copy-space.
fn voted_byte(i: Word) -> Word {
    maj3(
        wire.bytes[i] as Word,
        wire.bytes[16 + i] as Word,
        wire.bytes[32 + i] as Word,
    )
}

fn voted_u16(at: Word) -> Word {
    voted_byte(at) + (voted_byte(at + 1) lsl 8)
}

fn voted_u32(at: Word) -> Word {
    voted_byte(at)
        + (voted_byte(at + 1) lsl 8)
        + (voted_byte(at + 2) lsl 16)
        + (voted_byte(at + 3) lsl 24)
}

// Checksum the first `n` VOTED bytes.
//
// This is deliberately not `crc_range`, and the difference is load-bearing. The
// reference checks the prologue's CRC against the voted record, so a vote that
// repaired a byte is confirmed rather than merely trusted. Checksumming the raw
// first copy would reject an artifact the vote had already fixed.
fn crc_voted(n: Word) -> Word {
    crc_begin();
    for i in 0..n limit 16 {
        crc_fold(voted_byte(i));
    }
    crc_end()
}

// 1 when `a` and `b` differ, 0 otherwise. Used instead of a bare `if` statement
// so the disagreement scan is straight-line arithmetic with no branching.
fn neq(a: Word, b: Word) -> Word {
    if a == b { 0 } else { 1 }
}

// 1 when any prologue copy disagrees with the vote.
//
// The artifact still reads correctly, which is what the vote is for, but it has
// taken damage and the margin that lets the NEXT fault also be survivable is
// gone. Unreported damage accumulates silently until a second fault in the same
// position defeats the vote, so this is a scrub trigger rather than a failure.
fn prologue_disagreed() -> Word {
    st.dis = 0;
    for i in 0..16 {
        st.dis = st.dis
            bor neq(wire.bytes[i] as Word, voted_byte(i))
            bor neq(wire.bytes[16 + i] as Word, voted_byte(i))
            bor neq(wire.bytes[32 + i] as Word, voted_byte(i));
    }
    st.dis
}

// Validate the voted prologue and return the region count, or a negative code.
//
// The checks and their ORDER follow the reference exactly, because the code a
// caller sees for a doubly-malformed artifact is part of the observable
// behaviour: magic, then byte order, then version, then the checksum, then the
// region ceiling.
//
//   -1  bad magic
//   -2  foreign byte order
//   -3  unsupported version
//   -4  bad prologue checksum
//   -5  region count above the format ceiling of 1024
fn parse_prologue() -> Word {
    if voted_u32(0) != 0x4B415558 { 0 - 1 } else {
    if voted_u16(4) != 0xFEFF { 0 - 2 } else {
    if voted_u16(6) != 2 { 0 - 3 } else {
    if crc_voted(12) != voted_u32(12) { 0 - 4 } else {
    if voted_u16(8) > 1024 { 0 - 5 } else {
    voted_u16(8) } } } } }
}


// --- SLICE 3: the region directory ----------------------------------------
//
// Three copies of an n-entry table live at byte 48, each entry 16 bytes:
//
//   0  u16  kind          8  u32  word length
//   2  u16  flags        12  u16  covers (parity planes only)
//   4  u32  word offset  14  u16  reserved, zero
//
// THE BOOTSTRAP IS THE PART THAT MATTERS. The directory's stride is
// `region_count * 16`, and `region_count` lives in the prologue. So the
// directory can only be located after the PROLOGUE vote has recovered that
// field. Taking the stride from an unvoted copy would desynchronise the search
// for the very copies that repair it, which is the reason the prologue is a
// separate fixed-size record in the first place.

// Words occupied by the whole header area: three copies of an n-entry directory
// plus the three 16-byte prologues. `48 + 48n` is always a multiple of 8, so
// this is exact and needs no rounding, unlike a payload length.
fn header_words(n: Word) -> Word {
    6 * (n + 1)
}

// Bytes in one directory copy.
fn dir_span() -> Word {
    wire.nregions lsl 4
}

// Payload bytes rounded up to whole words. The rounding is the part a
// transliteration drops: it is correct for a multiple of eight either way, and
// wrong for everything else.
fn words_for(nbytes: Word) -> Word {
    (nbytes + 7) lsr 3
}

// Write the three directory copies and return the header area's byte length.
// Offsets accumulate in emit order, starting past the header, exactly as the
// reference does before it writes a single byte.
fn emit_directory(n: Word) -> Word {
    st.cur = header_words(n);
    for i in 0..n limit 1024 {
        put_u16(48 + (i lsl 4), wire.rkind[i]);
        put_u16(48 + (i lsl 4) + 2, wire.rflags[i]);
        put_u32(48 + (i lsl 4) + 4, st.cur);
        put_u32(48 + (i lsl 4) + 8, words_for(wire.rlen[i]));
        put_u16(48 + (i lsl 4) + 12, wire.rcovers[i]);
        put_u16(48 + (i lsl 4) + 14, 0);
        st.cur = st.cur + words_for(wire.rlen[i]);
    }
    for i in 0..(n lsl 4) limit 16384 {
        wire.bytes[48 + (n lsl 4) + i] = wire.bytes[48 + i];
        wire.bytes[48 + ((n lsl 4) lsl 1) + i] = wire.bytes[48 + i];
    }
    48 + (3 * (n lsl 4))
}

// One voted byte of directory copy-space, at entry `i`, field offset `off`.
fn dir_voted_byte(i: Word, off: Word) -> Word {
    maj3(
        wire.bytes[48 + (i lsl 4) + off] as Word,
        wire.bytes[48 + dir_span() + (i lsl 4) + off] as Word,
        wire.bytes[48 + (dir_span() lsl 1) + (i lsl 4) + off] as Word,
    )
}

fn dir_u16(i: Word, off: Word) -> Word {
    dir_voted_byte(i, off) + (dir_voted_byte(i, off + 1) lsl 8)
}

fn dir_u32(i: Word, off: Word) -> Word {
    dir_voted_byte(i, off)
        + (dir_voted_byte(i, off + 1) lsl 8)
        + (dir_voted_byte(i, off + 2) lsl 16)
        + (dir_voted_byte(i, off + 3) lsl 24)
}

// 1 when any directory copy disagrees with the vote. Same scrub trigger as the
// prologue's, over the whole copy-space rather than one record.
fn directory_disagreed() -> Word {
    st.dis = 0;
    for i in 0..dir_span() limit 16384 {
        st.dis = st.dis
            bor neq(
                wire.bytes[48 + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            )
            bor neq(
                wire.bytes[48 + dir_span() + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            )
            bor neq(
                wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            );
    }
    st.dis
}

// Emit the whole header area: the three prologue copies, then the three
// directory copies. One call because the two share a buffer and a caller has no
// reason to want half a header; also the shape a real emitter takes, which fills
// the header before any payload.
fn emit_header() -> Word {
    emit_prologue(wire.nregions);
    emit_directory(wire.nregions)
}

// Index of the first region with `kind`, or 0 - 1 when absent. A linear scan is
// right here: the ceiling is 1024, the container assigns no ordering to kinds,
// and a bounded scan keeps the worst case obvious.
fn dir_find(kind: Word) -> Word {
    st.cur = 0 - 1;
    for i in 0..wire.nregions limit 1024 {
        st.cur = if st.cur == 0 - 1 {
            if dir_u16(i, 0) == kind { i } else { 0 - 1 }
        } else {
            st.cur
        };
    }
    st.cur
}

// --- SLICE 4: record tables and byte pools --------------------------------
//
// A region's payload is either a table of fixed-stride records or a
// byte-addressed pool; the container assigns no meaning beyond that, which is
// what keeps it reusable. Both are located from the VOTED directory, so every
// address here rests on slices 2 and 3 having repaired the header first.
//
// Element `i` of a table is at `base + i * stride`. The format constrains every
// record to a whole number of words specifically so that a stride which is also
// a power of two makes this a shift; the multiply is kept here because the
// container permits any word multiple, and a reader must handle the general
// case rather than the convenient one.

// A region's payload location, in bytes, from the voted directory.
fn region_base(i: Word) -> Word {
    dir_u32(i, 4) lsl 3
}

fn region_bytes(i: Word) -> Word {
    dir_u32(i, 8) lsl 3
}

// A stride is valid when it is non-zero and a whole number of words. Zero is
// rejected first and separately, because the divisibility test below divides by
// it and division by zero TRAPS rather than yielding a sentinel.
fn stride_ok(stride: Word) -> Word {
    if stride != 0 andalso (stride band 7) == 0 { 1 } else { 0 }
}

// Whether `stride` divides `total`. Expressed through division rather than a
// mask because a stride is only required to be a multiple of eight, not a power
// of two, so `band (stride - 1)` would silently give the wrong answer for a
// stride like 24.
fn divides(total: Word, stride: Word) -> Word {
    if (total / stride) * stride == total { 1 } else { 0 }
}

// Records in region `i` at `stride`, or 0 - 1 when the stride is inadmissible.
//
// The guard relies on `andalso` SHORT-CIRCUITING: `divides` divides by `stride`,
// so evaluating it with a zero stride would trap. A test pins the short circuit
// rather than trusting it.
fn rec_count(i: Word, stride: Word) -> Word {
    if stride_ok(stride) == 1 andalso divides(region_bytes(i), stride) == 1 {
        region_bytes(i) / stride
    } else {
        0 - 1
    }
}

// Byte address of field `off` within record `rec` of region `i`.
fn rec_at(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    region_base(i) + (rec * stride) + off
}

fn rec_u8(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    wire.bytes[rec_at(i, stride, rec, off)] as Word
}

fn rec_u16(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    get_u16(rec_at(i, stride, rec, off))
}

fn rec_u32(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    get_u32(rec_at(i, stride, rec, off))
}

fn put_rec_u16(i: Word, stride: Word, rec: Word, off: Word, v: Word) -> Word {
    put_u16(rec_at(i, stride, rec, off), v)
}

fn put_rec_u32(i: Word, stride: Word, rec: Word, off: Word, v: Word) -> Word {
    put_u32(rec_at(i, stride, rec, off), v)
}

// A byte pool is the same region viewed without a stride.
fn pool_u8(i: Word, off: Word) -> Word {
    wire.bytes[region_base(i) + off] as Word
}

// Fill region `i` with `n` two-word records whose fields are a function of the
// record index. The pattern is computed rather than supplied so the emitter can
// be compared byte-for-byte against a reference that computes the same thing,
// which tests the ADDRESSING arithmetic without also testing a data channel.
fn emit_pattern_records(i: Word, n: Word) -> Word {
    for r in 0..n limit 1024 {
        put_rec_u32(i, 16, r, 0, (r * 7) + 1);
        put_rec_u32(i, 16, r, 4, (r * 13) + 2);
        put_rec_u16(i, 16, r, 8, (r band 255) + 3);
        put_rec_u16(i, 16, r, 10, 0);
        put_rec_u32(i, 16, r, 12, 0);
    }
    n
}

// --- SLICE 5: the schema layer -------------------------------------------
//
// Slices 2 to 4 gave a container with no opinions: a prologue, a directory of
// numbered regions, and fixed-stride records inside them. The schema is what
// assigns meaning to those numbers, and it lives HERE rather than in the
// container so the container stays reusable by a project with different
// content. `src/wire_schema.rs` is the Rust side of the same layer.
//
// THE OFFSETS BELOW ARE TRANSCRIBED, NOT DERIVED, AND THAT IS DELIBERATE.
// `#[derive(WireRecord)]` packs fields with NO implicit padding and then rounds
// the stride up to a whole word, which is not what a C layout would give. The
// numbers therefore cannot be recomputed from the field types by eye. A test
// asserts every constant below against the derive's generated `OFFSET_*` and
// `STRIDE`, so a mistranscription fails immediately and a record that later
// gains a field fails then rather than silently reading the wrong bytes.
//
// Slice 5a covers the two records nothing else depends on. 5b to 5e follow, in
// docs/decisions/WIRE_FORMAT_SELFHOST_PLAN.md.

// Region kinds, from `wire_schema::kind`. Numbered from 0x0010 so a zeroed
// directory entry names no real region.
fn kind_string_pool() -> Word { 0x0010 }
fn kind_names() -> Word { 0x0011 }
fn kind_shapes() -> Word { 0x0015 }

// NameRef: a slice of the string pool. offset u32 @0, length u32 @4.
fn nameref_stride() -> Word { 8 }
fn nameref_off_offset() -> Word { 0 }
fn nameref_off_length() -> Word { 4 }

// ShapeRecord: a flat operand shape. tag u16 @0, kind u8 @2, reserved u8 @3,
// size u32 @4. It fits ONE word, which is why shapes need no side table where
// struct and enum constants do.
fn shape_stride() -> Word { 8 }
fn shape_off_tag() -> Word { 0 }
fn shape_off_kind() -> Word { 2 }
fn shape_off_reserved() -> Word { 3 }
fn shape_off_size() -> Word { 4 }

// Resolving a region BY KIND rather than by index is what makes this a schema
// layer. A reader asks for "the names table", not "region 4", so the artifact's
// region ordering is not part of the contract. Absent regions return 0 - 1 from
// `dir_find`, and the accessors below propagate that rather than reading from a
// negative base.
fn name_count() -> Word {
    if dir_find(kind_names()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_names()), nameref_stride())
    }
}

fn name_offset(i: Word) -> Word {
    rec_u32(dir_find(kind_names()), nameref_stride(), i, nameref_off_offset())
}

fn name_length(i: Word) -> Word {
    rec_u32(dir_find(kind_names()), nameref_stride(), i, nameref_off_length())
}

// Byte `j` of name `i`, resolved through the string pool. Two regions and a
// record are consulted to answer it, which is the whole point of the layer.
fn name_byte(i: Word, j: Word) -> Word {
    pool_u8(dir_find(kind_string_pool()), name_offset(i) + j)
}

fn shape_count() -> Word {
    if dir_find(kind_shapes()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_shapes()), shape_stride())
    }
}

fn shape_tag(i: Word) -> Word {
    rec_u16(dir_find(kind_shapes()), shape_stride(), i, shape_off_tag())
}

fn shape_kind(i: Word) -> Word {
    rec_u8(dir_find(kind_shapes()), shape_stride(), i, shape_off_kind())
}

fn shape_size(i: Word) -> Word {
    rec_u32(dir_find(kind_shapes()), shape_stride(), i, shape_off_size())
}

// The host drives the module through a one-argument entry point, so the argument
// selects the operation. An unrecognised command returns a distinct code rather
// than a plausible value, so a caller that passes the wrong one finds out.
//
//   0  checksum `bytes[0..len]`
//   1  emit the prologue for `nregions`, returning bytes written
//   2  validate the voted prologue, returning the region count or a negative code
//   3  report whether any prologue copy disagreed with the vote
//   4  emit the directory for `nregions`, returning the header byte length
//   5  find the region index whose kind is `warg`, or 0 - 1
//   6  report whether any directory copy disagreed with the vote
//   7  the voted word offset of region `warg`
//   8  the voted word length of region `warg`
//   9  the voted kind of region `warg`
//  10  emit the whole header area, returning its byte length
//  11  byte base of region `warg`'s payload
//  12  payload bytes of region `warg`
//  13  record count of region `warg` at stride `warg2`, or 0 - 1
//  14  u32 field `warg4` of record `warg3`, region `warg`, stride `warg2`
//  15  u16 field `warg4` of record `warg3`, region `warg`, stride `warg2`
//  16  byte `warg2` of region `warg` viewed as a pool
//  17  fill region `warg` with `warg2` pattern records, then re-emit nothing
//  18  number of names, 0 when the region is absent
//  19  byte offset of name `warg` into the string pool
//  20  byte length of name `warg`
//  21  byte `warg2` of name `warg`
//  22  number of shapes, 0 when the region is absent
//  23  tag of shape `warg`
//  24  kind of shape `warg`
//  25  size of shape `warg`
// --- SLICE 5b: the constant table and its two side tables ----------------
//
// A constant is two words. Struct and enum constants reference small SIDE
// TABLES rather than widening every record to their worst case, which would
// cost 32 bytes for an `Int` that needs 8.

// Constant tags, from `wire_schema::tag`.
fn tag_unit() -> Word { 1 }
fn tag_bool() -> Word { 2 }
fn tag_int() -> Word { 3 }
fn tag_byte() -> Word { 4 }
fn tag_fixed() -> Word { 5 }
fn tag_float() -> Word { 6 }
fn tag_static_str() -> Word { 7 }
fn tag_tuple() -> Word { 8 }
fn tag_array() -> Word { 9 }
fn tag_struct() -> Word { 10 }
fn tag_enum() -> Word { 11 }
fn tag_none() -> Word { 12 }

fn kind_consts() -> Word { 0x0012 }
fn kind_struct_aux() -> Word { 0x0013 }
fn kind_enum_aux() -> Word { 0x0014 }

// ConstRecord: tag u16 @0, flags u16 @2, aux u32 @4, payload u64 @8.
fn const_stride() -> Word { 16 }
fn const_off_tag() -> Word { 0 }
fn const_off_flags() -> Word { 2 }
fn const_off_aux() -> Word { 4 }
fn const_off_payload() -> Word { 8 }

// StructAux: type_name u32 @0, field_names_first u32 @4.
fn structaux_stride() -> Word { 8 }
fn structaux_off_type_name() -> Word { 0 }
fn structaux_off_field_names_first() -> Word { 4 }

// EnumAux: type_name u32 @0, variant u32 @4, discriminant i64 @8.
fn enumaux_stride() -> Word { 16 }
fn enumaux_off_type_name() -> Word { 0 }
fn enumaux_off_variant() -> Word { 4 }
fn enumaux_off_discriminant() -> Word { 8 }

// A SIGNED 64-bit read. `get_u32` and friends zero-extend, which is right for
// every other field, and wrong for a discriminant: they are declared with an
// optional unary minus and negative values are legal.
//
// No sign-extension step is needed because the top byte's shift lands on bit
// 63 and `lsl` is total and wrapping, so the two's-complement bit pattern comes
// out as the correct negative `Word` directly. A test pins a negative
// discriminant rather than leaving that to inspection.
fn get_i64(at: Word) -> Word {
    (wire.bytes[at] as Word)
        + ((wire.bytes[at + 1] as Word) lsl 8)
        + ((wire.bytes[at + 2] as Word) lsl 16)
        + ((wire.bytes[at + 3] as Word) lsl 24)
        + ((wire.bytes[at + 4] as Word) lsl 32)
        + ((wire.bytes[at + 5] as Word) lsl 40)
        + ((wire.bytes[at + 6] as Word) lsl 48)
        + ((wire.bytes[at + 7] as Word) lsl 56)
}

fn const_count() -> Word {
    if dir_find(kind_consts()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_consts()), const_stride())
    }
}

fn const_tag(i: Word) -> Word {
    rec_u16(dir_find(kind_consts()), const_stride(), i, const_off_tag())
}

fn const_flags(i: Word) -> Word {
    rec_u16(dir_find(kind_consts()), const_stride(), i, const_off_flags())
}

fn const_aux(i: Word) -> Word {
    rec_u32(dir_find(kind_consts()), const_stride(), i, const_off_aux())
}

// ONLY A COMPOSITE CARRIES A RANGE. A scalar overlays its VALUE on the same
// bytes, so asking a scalar for its range reads an integer's value as a child
// count. That has already happened once in the Rust implementation, where
// `Int(i64::MIN)` read as a child count of 0x80000000. The tag is the question,
// never the payload bytes.
fn const_is_composite(i: Word) -> Word {
    if const_tag(i) == tag_tuple() { 1 } else {
    if const_tag(i) == tag_array() { 1 } else {
    if const_tag(i) == tag_struct() { 1 } else {
    if const_tag(i) == tag_enum() { 1 } else { 0 } } } }
}

// The payload packs a composite's children as `first | (count << 32)`.
// Both accessors return 0 - 1 for a non-composite rather than a plausible
// number, so a caller that forgot the tag check finds out.
fn const_range_first(i: Word) -> Word {
    if const_is_composite(i) == 0 { 0 - 1 } else {
        rec_u32(dir_find(kind_consts()), const_stride(), i, const_off_payload())
    }
}

fn const_range_count(i: Word) -> Word {
    if const_is_composite(i) == 0 { 0 - 1 } else {
        rec_u32(dir_find(kind_consts()), const_stride(), i, const_off_payload() + 4)
    }
}

fn structaux_type_name(i: Word) -> Word {
    rec_u32(dir_find(kind_struct_aux()), structaux_stride(), i, structaux_off_type_name())
}

fn structaux_field_names_first(i: Word) -> Word {
    rec_u32(
        dir_find(kind_struct_aux()),
        structaux_stride(),
        i,
        structaux_off_field_names_first(),
    )
}

fn enumaux_type_name(i: Word) -> Word {
    rec_u32(dir_find(kind_enum_aux()), enumaux_stride(), i, enumaux_off_type_name())
}

fn enumaux_variant(i: Word) -> Word {
    rec_u32(dir_find(kind_enum_aux()), enumaux_stride(), i, enumaux_off_variant())
}

fn enumaux_discriminant(i: Word) -> Word {
    get_i64(
        rec_at(
            dir_find(kind_enum_aux()),
            enumaux_stride(),
            i,
            enumaux_off_discriminant(),
        ),
    )
}

// --- SLICE 5c: range-addressed runs --------------------------------------
//
// Each of these four records owns a RUN in another region: a signature's
// parameters run through `SHAPES`, a struct template's field names through
// `NAMES`, an enum layout's variants through `ENUM_VARIANTS`. Resolving
// `first + k` against `count` is the whole content of the slice, and the guard
// on `k` is the part worth testing, because an unguarded index reads a
// neighbouring run's record and returns a plausible wrong answer.
//
// A NOTE ON SENTINELS, which forced a design choice here. Every accessor so far
// returns 0 - 1 for absence, which is safe while the value is an index or a
// count. A variant's DISCRIMINANT is a full signed Word, so -1 is a legal
// value and cannot also mean "out of range". Rather than invent an
// unrepresentable sentinel, the bound is a SEPARATE query: ask
// `layout_variant_in_range` first, and read the discriminant only when it
// answers 1.

fn kind_signatures() -> Word { 0x0016 }
fn kind_struct_templates() -> Word { 0x0017 }
fn kind_enum_variants() -> Word { 0x0018 }
fn kind_enum_layouts() -> Word { 0x0019 }

// SignatureRecord: params_first u32 @0, params_count u32 @4, ret u32 @8,
// resume u32 @12.
fn sig_stride() -> Word { 16 }
fn sig_off_params_first() -> Word { 0 }
fn sig_off_params_count() -> Word { 4 }
fn sig_off_ret() -> Word { 8 }
fn sig_off_resume() -> Word { 12 }

// StructTemplateRecord: type_name u32 @0, field_names_first u32 @4,
// field_count u32 @8, reserved u32 @12.
fn tpl_stride() -> Word { 16 }
fn tpl_off_type_name() -> Word { 0 }
fn tpl_off_field_names_first() -> Word { 4 }
fn tpl_off_field_count() -> Word { 8 }
fn tpl_off_reserved() -> Word { 12 }

// EnumVariantRecord: name u32 @0, reserved u32 @4, disc i64 @8.
fn evar_stride() -> Word { 16 }
fn evar_off_name() -> Word { 0 }
fn evar_off_reserved() -> Word { 4 }
fn evar_off_disc() -> Word { 8 }

// EnumLayoutRecord: type_name u32 @0, variants_first u32 @4,
// variants_count u32 @8, min_payload u32 @12.
fn elay_stride() -> Word { 16 }
fn elay_off_type_name() -> Word { 0 }
fn elay_off_variants_first() -> Word { 4 }
fn elay_off_variants_count() -> Word { 8 }
fn elay_off_min_payload() -> Word { 12 }

fn sig_count() -> Word {
    if dir_find(kind_signatures()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_signatures()), sig_stride())
    }
}

fn sig_params_first(i: Word) -> Word {
    rec_u32(dir_find(kind_signatures()), sig_stride(), i, sig_off_params_first())
}

fn sig_params_count(i: Word) -> Word {
    rec_u32(dir_find(kind_signatures()), sig_stride(), i, sig_off_params_count())
}

fn sig_ret(i: Word) -> Word {
    rec_u32(dir_find(kind_signatures()), sig_stride(), i, sig_off_ret())
}

fn sig_resume(i: Word) -> Word {
    rec_u32(dir_find(kind_signatures()), sig_stride(), i, sig_off_resume())
}

// Parameter `k` of signature `i`, resolved to its shape index, or 0 - 1 when
// `k` is past the run. Without the guard this reads the next signature's
// parameters, which are in bounds and therefore silently wrong.
fn sig_param_shape(i: Word, k: Word) -> Word {
    if k >= sig_params_count(i) { 0 - 1 } else { sig_params_first(i) + k }
}

fn tpl_count() -> Word {
    if dir_find(kind_struct_templates()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_struct_templates()), tpl_stride())
    }
}

fn tpl_type_name(i: Word) -> Word {
    rec_u32(dir_find(kind_struct_templates()), tpl_stride(), i, tpl_off_type_name())
}

fn tpl_field_count(i: Word) -> Word {
    rec_u32(dir_find(kind_struct_templates()), tpl_stride(), i, tpl_off_field_count())
}

// Field `k`'s NAME INDEX. A template's names are interned consecutively and
// without sharing precisely so that `first + k` addresses them; a repeated name
// collapsing onto an earlier index would break the run.
fn tpl_field_name(i: Word, k: Word) -> Word {
    if k >= tpl_field_count(i) { 0 - 1 } else {
        rec_u32(
            dir_find(kind_struct_templates()),
            tpl_stride(),
            i,
            tpl_off_field_names_first(),
        ) + k
    }
}

fn elay_count() -> Word {
    if dir_find(kind_enum_layouts()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_enum_layouts()), elay_stride())
    }
}

fn elay_type_name(i: Word) -> Word {
    rec_u32(dir_find(kind_enum_layouts()), elay_stride(), i, elay_off_type_name())
}

fn elay_variants_count(i: Word) -> Word {
    rec_u32(dir_find(kind_enum_layouts()), elay_stride(), i, elay_off_variants_count())
}

fn elay_min_payload(i: Word) -> Word {
    rec_u32(dir_find(kind_enum_layouts()), elay_stride(), i, elay_off_min_payload())
}

// 1 when variant `k` of layout `i` exists. Ask this BEFORE reading the
// discriminant, which has no spare value to signal absence with.
fn elay_variant_in_range(i: Word, k: Word) -> Word {
    if k >= elay_variants_count(i) { 0 } else { 1 }
}

fn elay_variant_index(i: Word, k: Word) -> Word {
    rec_u32(dir_find(kind_enum_layouts()), elay_stride(), i, elay_off_variants_first()) + k
}

fn elay_variant_name(i: Word, k: Word) -> Word {
    if elay_variant_in_range(i, k) == 0 { 0 - 1 } else {
        rec_u32(
            dir_find(kind_enum_variants()),
            evar_stride(),
            elay_variant_index(i, k),
            evar_off_name(),
        )
    }
}

// Signed, like the constant table's discriminant, and meaningful only when
// `elay_variant_in_range` answers 1.
fn elay_variant_disc(i: Word, k: Word) -> Word {
    get_i64(
        rec_at(
            dir_find(kind_enum_variants()),
            evar_stride(),
            elay_variant_index(i, k),
            evar_off_disc(),
        ),
    )
}

// --- SLICE 5d: the data segment ------------------------------------------
//
// PRESENCE IS SEMANTIC HERE, WHICH IT IS NOWHERE ELSE IN THIS FILE.
//
// An absent `DATA_SLOTS` region means the module has NO data layout; an empty
// one means it has a layout with no slots. Those are different programs, and
// collapsing them is a silent wrong answer rather than a fault. Every other
// count accessor in this file returns 0 for an absent region, which is right
// for them and would be WRONG here — so the data segment splits the question in
// two, exactly as slice 5c split a variant's bound from its value:
// `data_layout_present` first, then the counts.

fn kind_data_slots() -> Word { 0x001A }
fn kind_shared_layout() -> Word { 0x001B }
fn kind_private_composite() -> Word { 0x001C }
fn kind_data_init() -> Word { 0x001D }

// DataSlotRecord: name u32 @0, visibility u8 @4, reserved u8 @5. Packed to six
// bytes, so the stride is the word it rounds up to, not the packed size.
fn dslot_stride() -> Word { 8 }
fn dslot_off_name() -> Word { 0 }
fn dslot_off_visibility() -> Word { 4 }
// The two reserved fields exist for the EMITTER, not the reader. A reader can
// ignore them; an emitter that leaves them to a zeroed buffer is the defect
// slice 4 argued against, and would diverge the moment a window is reused.
fn dslot_off_reserved() -> Word { 5 }
fn dslot_off_run() -> Word { 6 }

// SharedSlotRecord: offset u32 @0, kind u8 @4, reserved u8 @5, len u16 @6.
fn sslot_stride() -> Word { 8 }
fn sslot_off_offset() -> Word { 0 }
fn sslot_off_kind() -> Word { 4 }
fn sslot_off_len() -> Word { 6 }
fn sslot_off_reserved() -> Word { 5 }

// PrivateCompositeRecord: slot u16 @0, reserved u16 @2, offset u32 @4.
fn pcomp_stride() -> Word { 8 }
fn pcomp_off_slot() -> Word { 0 }
fn pcomp_off_reserved() -> Word { 2 }
fn pcomp_off_offset() -> Word { 4 }

// DataInitRecord: first u32 @0, count u32 @4. A range into the constant table.
fn dinit_stride() -> Word { 8 }
fn dinit_off_first() -> Word { 0 }
fn dinit_off_count() -> Word { 4 }

// 1 when the module has a data layout at all. Ask this BEFORE any count below;
// a zero from `data_slot_count` means "a layout with no slots", not "no layout".
fn data_layout_present() -> Word {
    if dir_find(kind_data_slots()) == 0 - 1 { 0 } else { 1 }
}

// The counts. Each returns 0 - 1 when its region is absent rather than 0, so an
// absent table is never mistaken for an empty one at any level, not just at the
// top. A caller that wants the lenient reading can compare against 0 - 1 itself.
fn data_slot_count() -> Word {
    if dir_find(kind_data_slots()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_data_slots()), dslot_stride())
    }
}

fn shared_slot_count() -> Word {
    if dir_find(kind_shared_layout()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_shared_layout()), sslot_stride())
    }
}

fn privcomp_count() -> Word {
    if dir_find(kind_private_composite()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_private_composite()), pcomp_stride())
    }
}

fn datainit_count() -> Word {
    if dir_find(kind_data_init()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_data_init()), dinit_stride())
    }
}

fn data_slot_name(i: Word) -> Word {
    rec_u32(dir_find(kind_data_slots()), dslot_stride(), i, dslot_off_name())
}

fn data_slot_visibility(i: Word) -> Word {
    rec_u8(dir_find(kind_data_slots()), dslot_stride(), i, dslot_off_visibility())
}

fn shared_slot_offset(i: Word) -> Word {
    rec_u32(dir_find(kind_shared_layout()), sslot_stride(), i, sslot_off_offset())
}

fn shared_slot_kind(i: Word) -> Word {
    rec_u8(dir_find(kind_shared_layout()), sslot_stride(), i, sslot_off_kind())
}

fn shared_slot_len(i: Word) -> Word {
    rec_u16(dir_find(kind_shared_layout()), sslot_stride(), i, sslot_off_len())
}

fn privcomp_slot(i: Word) -> Word {
    rec_u16(dir_find(kind_private_composite()), pcomp_stride(), i, pcomp_off_slot())
}

fn privcomp_offset(i: Word) -> Word {
    rec_u32(dir_find(kind_private_composite()), pcomp_stride(), i, pcomp_off_offset())
}

fn datainit_first(i: Word) -> Word {
    rec_u32(dir_find(kind_data_init()), dinit_stride(), i, dinit_off_first())
}

fn datainit_range_count(i: Word) -> Word {
    rec_u32(dir_find(kind_data_init()), dinit_stride(), i, dinit_off_count())
}

// --- SLICE 5e: the module level ------------------------------------------
//
// The chunk table, the natives, and the scalar header. These reference
// everything the earlier slices built, which is why they come last.
//
// TWO THINGS THE REFERENCE LEARNED THE HARD WAY, both preserved here.
//
// `ABSENT` is `u32::MAX`, the optional-index sentinel for an entry point, a
// native's return shape, and a chunk's debug pool. A sentinel rather than a
// parallel presence flag, because these index tables the container already
// bounds far below four billion entries, and a flag would have to be kept in
// step with the field it describes.
//
// NATIVES AND NATIVE_RETURNS ARE SEPARATE REGIONS. They were first encoded
// paired in one record, on the reasoning that two parallel vectors are exactly
// the arrangement that falls out of step. That reasoning was right about the
// risk and wrong about the fix: the two are ALREADY allowed to differ in
// length, and pairing them silently DROPPED the surplus instead of preventing
// it. Independent regions carry both lengths, so the counts are asked for
// separately here and a test gives them different lengths on purpose.

fn kind_param_types() -> Word { 0x001E }
fn kind_chunks() -> Word { 0x001F }
fn kind_natives() -> Word { 0x0020 }
fn kind_header() -> Word { 0x0021 }
fn kind_debug_pool() -> Word { 0x0022 }
fn kind_native_returns() -> Word { 0x0023 }

// The optional-index sentinel, `u32::MAX`.
fn absent_index() -> Word { 4294967295 }

// ChunkRecord, six words. Eleven u32 fields, then local_count u16,
// param_count u8, block_type u8.
fn chunk_stride() -> Word { 48 }
fn chunk_off_name() -> Word { 0 }
fn chunk_off_consts_first() -> Word { 4 }
fn chunk_off_consts_count() -> Word { 8 }
fn chunk_off_templates_first() -> Word { 12 }
fn chunk_off_templates_count() -> Word { 16 }
fn chunk_off_param_types_first() -> Word { 20 }
fn chunk_off_param_types_count() -> Word { 24 }
fn chunk_off_debug_first() -> Word { 28 }
fn chunk_off_debug_len() -> Word { 32 }
fn chunk_off_op_byte_offset() -> Word { 36 }
fn chunk_off_op_record_count() -> Word { 40 }
fn chunk_off_local_count() -> Word { 44 }
fn chunk_off_param_count() -> Word { 46 }
fn chunk_off_block_type() -> Word { 47 }

// NativeRecord and NativeReturnRecord: one index plus reserved, one word each.
fn native_stride() -> Word { 8 }
fn native_off_name() -> Word { 0 }
fn native_off_reserved() -> Word { 4 }
fn natret_stride() -> Word { 8 }
fn natret_off_shape() -> Word { 0 }
fn natret_off_reserved() -> Word { 4 }

// HeaderRecord, four words.
fn header_stride() -> Word { 32 }
fn header_off_entry_point() -> Word { 0 }
fn header_off_word_bits_log2() -> Word { 4 }
fn header_off_addr_bits_log2() -> Word { 5 }
fn header_off_float_bits_log2() -> Word { 6 }
fn header_off_flags() -> Word { 7 }
fn header_off_wcet_cycles() -> Word { 8 }
fn header_off_wcmu_bytes() -> Word { 12 }
fn header_off_shared_data_bytes() -> Word { 16 }
fn header_off_private_data_bytes() -> Word { 20 }
fn header_off_schema_hash() -> Word { 24 }
fn header_off_reserved() -> Word { 28 }

fn chunk_count() -> Word {
    if dir_find(kind_chunks()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_chunks()), chunk_stride())
    }
}

// A chunk's u32 field at `off`. Generic rather than fourteen named accessors,
// because the OFFSETS are what must be right and they are named and pinned
// above; a per-field command would multiply the dispatch without adding a
// checkable fact.
fn chunk_u32(i: Word, off: Word) -> Word {
    rec_u32(dir_find(kind_chunks()), chunk_stride(), i, off)
}

fn chunk_local_count(i: Word) -> Word {
    rec_u16(dir_find(kind_chunks()), chunk_stride(), i, chunk_off_local_count())
}

fn chunk_param_count(i: Word) -> Word {
    rec_u8(dir_find(kind_chunks()), chunk_stride(), i, chunk_off_param_count())
}

fn chunk_block_type(i: Word) -> Word {
    rec_u8(dir_find(kind_chunks()), chunk_stride(), i, chunk_off_block_type())
}

// 1 when chunk `i` carries a debug pool. `ABSENT` distinguishes "no debug
// metadata" from "an empty debug pool", which is a release build versus a
// debug build that emitted nothing.
fn chunk_has_debug(i: Word) -> Word {
    if chunk_u32(i, chunk_off_debug_first()) == absent_index() { 0 } else { 1 }
}

fn native_count() -> Word {
    if dir_find(kind_natives()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_natives()), native_stride())
    }
}

fn native_name(i: Word) -> Word {
    rec_u32(dir_find(kind_natives()), native_stride(), i, native_off_name())
}

// Asked SEPARATELY from `native_count`, and deliberately not derived from it.
fn native_return_count() -> Word {
    if dir_find(kind_native_returns()) == 0 - 1 { 0 - 1 } else {
        rec_count(dir_find(kind_native_returns()), natret_stride())
    }
}

fn native_return_shape(i: Word) -> Word {
    rec_u32(dir_find(kind_native_returns()), natret_stride(), i, natret_off_shape())
}

fn header_present() -> Word {
    if dir_find(kind_header()) == 0 - 1 { 0 } else { 1 }
}

fn header_u32(off: Word) -> Word {
    rec_u32(dir_find(kind_header()), header_stride(), 0, off)
}

fn header_u8(off: Word) -> Word {
    rec_u8(dir_find(kind_header()), header_stride(), 0, off)
}

// Write the module's HEADER record at byte address `at`, from `wire.fin`.
//
// THE FIRST SCHEMA EMITTER. Everything before this either emitted the container
// (prologue, directory) or emitted a synthetic pattern for a fixture; this
// writes a real record's real fields at the transcribed offsets, which is what
// the self-hosted path needs in order to produce an artifact rather than merely
// read one.
//
// IT TAKES A BYTE ADDRESS, NOT A REGION INDEX, AND THAT IS THE WHOLE POINT.
// The first version took a region index and located itself through
// `region_base`, an ABSOLUTE artifact offset. That works only for a region that
// happens to lie inside this 65536-byte buffer, which a one-region test
// artifact does and a real one does not: in a real layout `CHUNKS` sits after
// `STRING_POOL` and its base is in the millions. A staged emitter is handed a
// low WINDOW and the host appends the result at the true offset, so the address
// has to come from the caller.
//
// The inputs arrive in `wire.fin` in DECLARATION ORDER, which is the same order
// the offsets appear below. Reserved is written explicitly rather than left to
// a zeroed buffer, because an emitter that relies on its output starting zeroed
// is one that silently breaks the day it writes into reused space.
fn emit_header_record_at(at: Word) -> Word {
    put_u32(at + header_off_entry_point(), wire.fin[0]);
    put_u8(at + header_off_word_bits_log2(), wire.fin[1]);
    put_u8(at + header_off_addr_bits_log2(), wire.fin[2]);
    put_u8(at + header_off_float_bits_log2(), wire.fin[3]);
    put_u8(at + header_off_flags(), wire.fin[4]);
    put_u32(at + header_off_wcet_cycles(), wire.fin[5]);
    put_u32(at + header_off_wcmu_bytes(), wire.fin[6]);
    put_u32(at + header_off_shared_data_bytes(), wire.fin[7]);
    put_u32(at + header_off_private_data_bytes(), wire.fin[8]);
    put_u32(at + header_off_schema_hash(), wire.fin[9]);
    put_u32(at + header_off_reserved(), wire.fin[10]);
    header_stride()
}

// --- SLICE 3 OF THE WIRING INCREMENT: a multi-record region ----------------
//
// `CHUNKS` is the smallest region that cannot be emitted in one batch, at two,
// so the batching mechanism is built where a failure is legible rather than
// inside `DATA_SLOTS`, which needs 1547. `ChunkRecord` is also the WIDEST record
// in the format at fourteen fields, so it stresses the field marshalling at the
// same time.
//
// ONLY THE INPUT NEEDS BATCHING. `wire.fin` holds 1024 words and a field costs a
// whole word there while costing at most four bytes in the packed record, so one
// batch's OUTPUT is at most 5456 bytes across every record kind in the format,
// against a 65536-byte buffer. The emitter therefore never has to chunk what it
// writes, only what it is given.

fn chunk_fields() -> Word { 14 }
fn fin_capacity() -> Word { 1024 }

// One chunk record at byte address `at`, reading fourteen fields from `wire.fin`
// starting at `k`.
fn emit_chunk_record_at(at: Word, k: Word) -> Word {
    put_u32(at + chunk_off_name(), wire.fin[k]);
    put_u32(at + chunk_off_consts_first(), wire.fin[k + 1]);
    put_u32(at + chunk_off_consts_count(), wire.fin[k + 2]);
    put_u32(at + chunk_off_templates_first(), wire.fin[k + 3]);
    put_u32(at + chunk_off_templates_count(), wire.fin[k + 4]);
    put_u32(at + chunk_off_param_types_first(), wire.fin[k + 5]);
    put_u32(at + chunk_off_param_types_count(), wire.fin[k + 6]);
    put_u32(at + chunk_off_debug_first(), wire.fin[k + 7]);
    put_u32(at + chunk_off_debug_len(), wire.fin[k + 8]);
    put_u32(at + chunk_off_op_byte_offset(), wire.fin[k + 9]);
    put_u32(at + chunk_off_op_record_count(), wire.fin[k + 10]);
    put_u16(at + chunk_off_local_count(), wire.fin[k + 11]);
    put_u8(at + chunk_off_param_count(), wire.fin[k + 12]);
    put_u8(at + chunk_off_block_type(), wire.fin[k + 13]);
    chunk_stride()
}

// `n` consecutive chunk records into the window starting at `at`.
//
// The guard is not decoration. `n` comes from the host, and a batch larger than
// `wire.fin` would read past the array's end — where the language would fault,
// but on a value the host chose rather than on a stated contract. Rejecting it
// with a distinct code says which contract was broken.
//
// The loop bound is `fin_capacity()` rather than the true maximum of 73. A
// tighter static bound would silently TRUNCATE if the field count or the array
// size ever changed, and a silent truncation here produces a short region that
// still parses. 1024 cannot be exceeded by any record kind, since a record costs
// at least one word of input.
fn emit_chunk_records(at: Word, n: Word) -> Word {
    if (n * chunk_fields()) > fin_capacity() { 0 - 200 } else {
        for j in 0..n limit 1024 {
            emit_chunk_record_at(at + (j * chunk_stride()), j * chunk_fields());
        }
        n * chunk_stride()
    }
}

// --- SLICE 4 OF THE WIRING INCREMENT: a byte pool --------------------------
//
// A pool is the other half of the format. It has no stride, no fields and no
// records, so none of the record machinery applies, and the one thing it has
// that a record table does not is a LOGICAL LENGTH DISTINCT FROM ITS STORED
// LENGTH. The container stores a region's length in whole words, so a pool of
// 101 bytes occupies 104 and the last three are pad.
//
// THE PAD IS THE ONLY PLACE A BUG CAN LIVE HERE, since copying bytes is
// otherwise a no-op transformation. The corpus is unusually good for it: across
// the ten stages `PARAM_TYPES` produces pads of 0, 3, 4, 5 and 7, including the
// extreme case of one logical byte in an eight-byte region. Residues 1, 2 and 6
// do not occur and are covered by a hand-built sweep instead.

fn bin_capacity() -> Word { 8192 }

// `bout` is the same size as `bin` TODAY, and that is a coincidence rather than
// a constraint. A guard on the output buffer that names the input one is right
// only until either is resized, and the two have already diverged in ROLE — bin
// is read-only to the interner, bout is written by it.
fn bout_capacity() -> Word { 8192 }

// Copy `n` input bytes into the window at `at`.
//
// The guard matters for the same reason the record one does: `n` comes from the
// host, and a batch larger than `wire.bin` would read past the array's end. A
// distinct code says which contract was broken rather than faulting on a value
// the host chose.
fn emit_pool_bytes(at: Word, n: Word) -> Word {
    if n > bin_capacity() { 0 - 201 } else {
        for j in 0..n limit 8192 {
            wire.bytes[at + j] = wire.bin[j];
        }
        n
    }
}

// Zero-fill from `at` to the word boundary implied by a pool of `total` bytes.
//
// Written EXPLICITLY rather than left to a zeroed buffer. The reference does
// emit zero pad, so relying on the buffer's initial state would pass every test
// here and break the day the emitter writes into space it has already used —
// which a staged emitter reusing one window across batches does by design.
// --- SLICE 5 OF THE WIRING INCREMENT: the two accumulator regions ----------
//
// `NAMES` and `STRING_POOL` are the pair the residency measurement singled out:
// `SchemaBuilder` writes them LAST, after every other contributor has interned
// into them, so they are the emission's resident set rather than transient
// buffers. Together they are 9,776,392 bytes for `lexer`, 58.3% of the shared
// ceiling.
//
// They are also one of each shape, which is why they go together: `NAMES` is a
// record table and `STRING_POOL` is the byte pool it indexes. The pool needs no
// new code at all — slice 4's `emit_pool_bytes` and `emit_pool_pad` already do
// it — so what is added here is the record side only.

fn nameref_fields() -> Word { 2 }

// `n` consecutive NameRef records into the window at `at`.
fn emit_name_records(at: Word, n: Word) -> Word {
    if (n * nameref_fields()) > fin_capacity() { 0 - 202 } else {
        for j in 0..n limit 1024 {
            put_u32(
                at + (j * nameref_stride()) + nameref_off_offset(),
                wire.fin[j * nameref_fields()],
            );
            put_u32(
                at + (j * nameref_stride()) + nameref_off_length(),
                wire.fin[(j * nameref_fields()) + 1],
            );
        }
        n * nameref_stride()
    }
}

// --- SLICE 6 OF THE WIRING INCREMENT: the two per-slot tables --------------
//
// `DATA_SLOTS` and `SHARED_LAYOUT` complete the four regions that together are
// 99.96% of `lexer`'s auxiliary body, alongside `NAMES` and `STRING_POOL`. All
// three record tables carry the SAME count, one entry per data slot, because
// every array element becomes its own slot.
//
// Both records are four fields in one word, and both include a reserved field
// that no reader consults. They are written anyway, for the reason slice 4
// established: an emitter that relies on its output starting zeroed breaks the
// day it writes into a reused window, which is what a staged emitter does.

fn dslot_fields() -> Word { 4 }

fn emit_data_slot_records(at: Word, n: Word) -> Word {
    if (n * dslot_fields()) > fin_capacity() { 0 - 203 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * dslot_stride()) + dslot_off_name(), wire.fin[j * dslot_fields()]);
            put_u8(
                at + (j * dslot_stride()) + dslot_off_visibility(),
                wire.fin[(j * dslot_fields()) + 1],
            );
            put_u8(
                at + (j * dslot_stride()) + dslot_off_reserved(),
                wire.fin[(j * dslot_fields()) + 2],
            );
            put_u16(
                at + (j * dslot_stride()) + dslot_off_run(),
                wire.fin[(j * dslot_fields()) + 3],
            );
        }
        n * dslot_stride()
    }
}

fn sslot_fields() -> Word { 4 }

fn emit_shared_slot_records(at: Word, n: Word) -> Word {
    if (n * sslot_fields()) > fin_capacity() { 0 - 204 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * sslot_stride()) + sslot_off_offset(), wire.fin[j * sslot_fields()]);
            put_u8(
                at + (j * sslot_stride()) + sslot_off_kind(),
                wire.fin[(j * sslot_fields()) + 1],
            );
            put_u8(
                at + (j * sslot_stride()) + sslot_off_reserved(),
                wire.fin[(j * sslot_fields()) + 2],
            );
            put_u16(
                at + (j * sslot_stride()) + sslot_off_len(),
                wire.fin[(j * sslot_fields()) + 3],
            );
        }
        n * sslot_stride()
    }
}

// --- SLICE 7 OF THE WIRING INCREMENT: the remaining populated tables -------
//
// Six record kinds, all mechanical now that the mechanism exists: every offset
// was already transcribed for the readers, and the batching, window addressing
// and oversize guard are unchanged from slice 3.
//
// TWO CARRY 64-BIT FIELDS, which is the one new thing here. `ConstRecord` has a
// `payload` and `EnumVariantRecord` a signed `disc`, both eight bytes, so
// `put_u64` writes them as two little-endian limbs. It is correct for a negative
// discriminant because `lsr` is logical over the whole word.

fn shape_fields() -> Word { 4 }

fn emit_shape_records(at: Word, n: Word) -> Word {
    if (n * shape_fields()) > fin_capacity() { 0 - 205 } else {
        for j in 0..n limit 1024 {
            put_u16(at + (j * shape_stride()) + shape_off_tag(), wire.fin[j * shape_fields()]);
            put_u8(at + (j * shape_stride()) + shape_off_kind(), wire.fin[(j * shape_fields()) + 1]);
            put_u8(
                at + (j * shape_stride()) + shape_off_reserved(),
                wire.fin[(j * shape_fields()) + 2],
            );
            put_u32(at + (j * shape_stride()) + shape_off_size(), wire.fin[(j * shape_fields()) + 3]);
        }
        n * shape_stride()
    }
}

fn sig_fields() -> Word { 4 }

fn emit_signature_records(at: Word, n: Word) -> Word {
    if (n * sig_fields()) > fin_capacity() { 0 - 206 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * sig_stride()) + sig_off_params_first(), wire.fin[j * sig_fields()]);
            put_u32(
                at + (j * sig_stride()) + sig_off_params_count(),
                wire.fin[(j * sig_fields()) + 1],
            );
            put_u32(at + (j * sig_stride()) + sig_off_ret(), wire.fin[(j * sig_fields()) + 2]);
            put_u32(at + (j * sig_stride()) + sig_off_resume(), wire.fin[(j * sig_fields()) + 3]);
        }
        n * sig_stride()
    }
}

fn evar_fields() -> Word { 3 }

fn emit_enum_variant_records(at: Word, n: Word) -> Word {
    if (n * evar_fields()) > fin_capacity() { 0 - 207 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * evar_stride()) + evar_off_name(), wire.fin[j * evar_fields()]);
            put_u32(
                at + (j * evar_stride()) + evar_off_reserved(),
                wire.fin[(j * evar_fields()) + 1],
            );
            put_u64(at + (j * evar_stride()) + evar_off_disc(), wire.fin[(j * evar_fields()) + 2]);
        }
        n * evar_stride()
    }
}

fn elay_fields() -> Word { 4 }

fn emit_enum_layout_records(at: Word, n: Word) -> Word {
    if (n * elay_fields()) > fin_capacity() { 0 - 208 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * elay_stride()) + elay_off_type_name(), wire.fin[j * elay_fields()]);
            put_u32(
                at + (j * elay_stride()) + elay_off_variants_first(),
                wire.fin[(j * elay_fields()) + 1],
            );
            put_u32(
                at + (j * elay_stride()) + elay_off_variants_count(),
                wire.fin[(j * elay_fields()) + 2],
            );
            put_u32(
                at + (j * elay_stride()) + elay_off_min_payload(),
                wire.fin[(j * elay_fields()) + 3],
            );
        }
        n * elay_stride()
    }
}

fn dinit_fields() -> Word { 2 }

fn emit_data_init_records(at: Word, n: Word) -> Word {
    if (n * dinit_fields()) > fin_capacity() { 0 - 209 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * dinit_stride()) + dinit_off_first(), wire.fin[j * dinit_fields()]);
            put_u32(
                at + (j * dinit_stride()) + dinit_off_count(),
                wire.fin[(j * dinit_fields()) + 1],
            );
        }
        n * dinit_stride()
    }
}

fn const_fields() -> Word { 4 }

fn emit_const_records(at: Word, n: Word) -> Word {
    if (n * const_fields()) > fin_capacity() { 0 - 210 } else {
        for j in 0..n limit 1024 {
            put_u16(at + (j * const_stride()) + const_off_tag(), wire.fin[j * const_fields()]);
            put_u16(
                at + (j * const_stride()) + const_off_flags(),
                wire.fin[(j * const_fields()) + 1],
            );
            put_u32(at + (j * const_stride()) + const_off_aux(), wire.fin[(j * const_fields()) + 2]);
            put_u64(
                at + (j * const_stride()) + const_off_payload(),
                wire.fin[(j * const_fields()) + 3],
            );
        }
        n * const_stride()
    }
}

// --- SLICE 8 OF THE WIRING INCREMENT: the kinds the corpus never populates --
//
// Six record shapes are emitted as EMPTY regions by every one of the ten stages,
// so no differential against real output can reach them. For a reader an empty
// region and a populated one are different cases and both were covered; for an
// EMITTER they are the same problem, because no record of that kind is ever
// written and a mistranscribed offset would go unseen.
//
// These do NOT block the driver — a zero-record region is declared in the
// directory with length zero and needs no emitter at all. They are what a
// general compiler needs the day a program declares a struct template or a
// native, which the toolchain's own sources happen never to do.
//
// The oracle is therefore not the corpus but INDEPENDENT CONSTRUCTION: the
// derive's own `write_record` builds the expected bytes, and every field is
// given a distinct value so a swapped pair cannot hide.

fn saux_fields() -> Word { 2 }

fn emit_struct_aux_records(at: Word, n: Word) -> Word {
    if (n * saux_fields()) > fin_capacity() { 0 - 211 } else {
        for j in 0..n limit 1024 {
            put_u32(
                at + (j * structaux_stride()) + structaux_off_type_name(),
                wire.fin[j * saux_fields()],
            );
            put_u32(
                at + (j * structaux_stride()) + structaux_off_field_names_first(),
                wire.fin[(j * saux_fields()) + 1],
            );
        }
        n * structaux_stride()
    }
}

fn eaux_fields() -> Word { 3 }

fn emit_enum_aux_records(at: Word, n: Word) -> Word {
    if (n * eaux_fields()) > fin_capacity() { 0 - 212 } else {
        for j in 0..n limit 1024 {
            put_u32(
                at + (j * enumaux_stride()) + enumaux_off_type_name(),
                wire.fin[j * eaux_fields()],
            );
            put_u32(
                at + (j * enumaux_stride()) + enumaux_off_variant(),
                wire.fin[(j * eaux_fields()) + 1],
            );
            put_u64(
                at + (j * enumaux_stride()) + enumaux_off_discriminant(),
                wire.fin[(j * eaux_fields()) + 2],
            );
        }
        n * enumaux_stride()
    }
}

fn tpl_fields() -> Word { 4 }

fn emit_struct_template_records(at: Word, n: Word) -> Word {
    if (n * tpl_fields()) > fin_capacity() { 0 - 213 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * tpl_stride()) + tpl_off_type_name(), wire.fin[j * tpl_fields()]);
            put_u32(
                at + (j * tpl_stride()) + tpl_off_field_names_first(),
                wire.fin[(j * tpl_fields()) + 1],
            );
            put_u32(
                at + (j * tpl_stride()) + tpl_off_field_count(),
                wire.fin[(j * tpl_fields()) + 2],
            );
            put_u32(
                at + (j * tpl_stride()) + tpl_off_reserved(),
                wire.fin[(j * tpl_fields()) + 3],
            );
        }
        n * tpl_stride()
    }
}

fn pcomp_fields() -> Word { 3 }

fn emit_private_composite_records(at: Word, n: Word) -> Word {
    if (n * pcomp_fields()) > fin_capacity() { 0 - 214 } else {
        for j in 0..n limit 1024 {
            put_u16(at + (j * pcomp_stride()) + pcomp_off_slot(), wire.fin[j * pcomp_fields()]);
            put_u16(
                at + (j * pcomp_stride()) + pcomp_off_reserved(),
                wire.fin[(j * pcomp_fields()) + 1],
            );
            put_u32(
                at + (j * pcomp_stride()) + pcomp_off_offset(),
                wire.fin[(j * pcomp_fields()) + 2],
            );
        }
        n * pcomp_stride()
    }
}

fn native_fields() -> Word { 2 }

fn emit_native_records(at: Word, n: Word) -> Word {
    if (n * native_fields()) > fin_capacity() { 0 - 215 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * native_stride()) + native_off_name(), wire.fin[j * native_fields()]);
            put_u32(
                at + (j * native_stride()) + native_off_reserved(),
                wire.fin[(j * native_fields()) + 1],
            );
        }
        n * native_stride()
    }
}

fn natret_fields() -> Word { 2 }

fn emit_native_return_records(at: Word, n: Word) -> Word {
    if (n * natret_fields()) > fin_capacity() { 0 - 216 } else {
        for j in 0..n limit 1024 {
            put_u32(at + (j * natret_stride()) + natret_off_shape(), wire.fin[j * natret_fields()]);
            put_u32(
                at + (j * natret_stride()) + natret_off_reserved(),
                wire.fin[(j * natret_fields()) + 1],
            );
        }
        n * natret_stride()
    }
}

// --- SLICE 10: the driver's region table ------------------------------------
//
// The first piece of the DRIVER rather than of the emitters. Everything so far
// took its region lengths from the host; this computes them, which means the
// stride of every record kind now lives on the Keleusma side.
//
// SPLIT INTO TWO CHAINS ON PURPOSE. Twenty arms in one `if/else` chain would sit
// four below the parser's depth-24 ceiling, which is close enough that the next
// region kind would break it — the same limit that has already forced two splits
// in this file. Two chains of ten leave real headroom.
//
// A POOL RETURNS ZERO, and that is a sentinel with a real meaning rather than an
// absence: a byte pool has no stride, so its length is its byte count and the
// caller passes bytes rather than a record count. Splitting the two would need a
// second array; zero is unambiguous here because no record kind has stride zero.

fn stride_of_kind_a(k: Word) -> Word {
    if k == kind_string_pool() { 0 } else {
    if k == kind_names() { nameref_stride() } else {
    if k == kind_consts() { const_stride() } else {
    if k == kind_struct_aux() { structaux_stride() } else {
    if k == kind_enum_aux() { enumaux_stride() } else {
    if k == kind_shapes() { shape_stride() } else {
    if k == kind_signatures() { sig_stride() } else {
    if k == kind_struct_templates() { tpl_stride() } else {
    if k == kind_enum_variants() { evar_stride() } else {
    if k == kind_enum_layouts() { elay_stride() } else {
    0 - 1 }}}}}}}}}}
}

fn stride_of_kind_b(k: Word) -> Word {
    if k == kind_data_slots() { dslot_stride() } else {
    if k == kind_shared_layout() { sslot_stride() } else {
    if k == kind_private_composite() { pcomp_stride() } else {
    if k == kind_data_init() { dinit_stride() } else {
    if k == kind_param_types() { 0 } else {
    if k == kind_chunks() { chunk_stride() } else {
    if k == kind_natives() { native_stride() } else {
    if k == kind_native_returns() { natret_stride() } else {
    if k == kind_header() { header_stride() } else {
    if k == kind_debug_pool() { 0 } else {
    0 - 1 }}}}}}}}}}
}

// Stride in bytes for a record kind, 0 for a byte pool, -1 for an unknown kind.
fn stride_of_kind(k: Word) -> Word {
    if k < kind_data_slots() { stride_of_kind_a(k) } else { stride_of_kind_b(k) }
}

// Rewrite `wire.rlen[0..n]` from COUNTS into BYTES, then emit the header area.
//
// `rlen[i]` arrives as a record count for a record kind and as a byte length for
// a pool, and leaves as a byte length in both cases. An unknown kind is rejected
// rather than silently sized zero, because a zero-length region parses fine and
// the mistake would surface as a wrong offset much later.
fn build_region_table(n: Word) -> Word {
    st.cur = 0;
    for i in 0..n limit 1024 {
        st.pad = stride_of_kind(wire.rkind[i]);
        st.cur = if st.pad < 0 { 0 - 1 } else { st.cur };
        wire.rlen[i] = if st.pad > 0 { st.pad * wire.rlen[i] } else { wire.rlen[i] };
    }
    if st.cur < 0 { 0 - 220 } else { emit_header() }
}

fn emit_pool_pad(at: Word, total: Word) -> Word {
    st.pad = (words_for(total) lsl 3) - total;
    for j in 0..st.pad limit 8 {
        wire.bytes[at + j] = 0 as Byte;
    }
    st.pad
}

// 1 when the module declares no entry point.
fn entry_point_absent() -> Word {
    if header_u32(header_off_entry_point()) == absent_index() { 1 } else { 0 }
}

// --- SLICE 6a: the opcode record -----------------------------------------
//
// Every instruction is four bytes:
//
//   byte 0   bit 7 parity, bits 0..6 the opcode identifier
//   byte 1   operand byte 0, low
//   byte 2   operand byte 1
//   byte 3   operand byte 2, high
//
// The operand is inline when it fits in twenty-four bits and is a pool index
// otherwise; the pool is slice 6b. This slice is the record itself.
//
// THE PARITY IS COMPUTED BY A FOLD, NOT BY COUNTING BITS, and the equivalence
// is worth stating because it is not obvious. The reference defines the parity
// as the low bit of the TOTAL POPCOUNT of the four bytes, with the parity bit
// itself masked to zero. That equals the bit-parity of `b0 bxor b1 bxor b2 bxor
// b3`: bit `i` of the exclusive-or is the parity of bit `i` across the four
// bytes, so summing those bits modulo two sums every bit of every byte modulo
// two. Folding is three shifts instead of thirty-two, and a test compares the
// two definitions across the whole opcode range rather than trusting the
// algebra.

// Bit-parity of one byte: 1 when an odd number of its bits are set.
fn byte_parity(v: Word) -> Word {
    ((((v bxor (v lsr 4)) bxor ((v bxor (v lsr 4)) lsr 2))
        bxor (((v bxor (v lsr 4)) bxor ((v bxor (v lsr 4)) lsr 2)) lsr 1))
        band 1)
}

// The parity bit for a record with opcode `id` and three operand bytes. The
// identifier is masked to seven bits first, because the eighth is where the
// answer goes and must not be counted.
fn oprec_parity(id: Word, b1: Word, b2: Word, b3: Word) -> Word {
    byte_parity(((id band 127) bxor b1) bxor (b2 bxor b3))
}

// Write one opcode record at byte offset `at`, returning the next offset.
fn oprec_write(at: Word, id: Word, b1: Word, b2: Word, b3: Word) -> Word {
    wire.bytes[at] = ((id band 127) bor (oprec_parity(id, b1, b2, b3) lsl 7)) as Byte;
    wire.bytes[at + 1] = (b1 band 255) as Byte;
    wire.bytes[at + 2] = (b2 band 255) as Byte;
    wire.bytes[at + 3] = (b3 band 255) as Byte;
    at + 4
}

// The opcode identifier, with the parity bit removed.
fn oprec_id(at: Word) -> Word {
    (wire.bytes[at] as Word) band 127
}

// Operand byte `k`, for k in 0..3.
fn oprec_operand_byte(at: Word, k: Word) -> Word {
    wire.bytes[at + 1 + k] as Word
}

// The inline operand as a little-endian twenty-four-bit value.
fn oprec_operand_u24(at: Word) -> Word {
    (wire.bytes[at + 1] as Word)
        + ((wire.bytes[at + 2] as Word) lsl 8)
        + ((wire.bytes[at + 3] as Word) lsl 16)
}

// The parity bit as stored.
fn oprec_stored_parity(at: Word) -> Word {
    ((wire.bytes[at] as Word) lsr 7) band 1
}

// 1 when the record's stored parity matches its contents. The parity covers
// the whole record, so a single bit flip anywhere in the four bytes is
// detected at the consumer.
fn oprec_parity_ok(at: Word) -> Word {
    if oprec_stored_parity(at)
        == oprec_parity(
            oprec_id(at),
            oprec_operand_byte(at, 0),
            oprec_operand_byte(at, 1),
            oprec_operand_byte(at, 2),
        )
    { 1 } else { 0 }
}

// --- SLICE 6b: the operand pool ------------------------------------------
//
// An operand that does not fit in the record's twenty-four inline bits spills
// to an eight-byte pool entry, and the record then carries the pool index
// instead. An entry is:
//
//   byte 0    type tag
//   byte 1    parity byte
//   bytes 2-7 payload, laid out by the tag
//
// THE TWO PARITY SCHEMES IN THIS FORMAT ARE DIFFERENT, and conflating them is
// the easy mistake. An opcode record carries a single BIT, the even parity of
// the popcount of its four bytes. A pool entry carries a whole BYTE, the
// exclusive-or of the tag byte and the six payload bytes — byte one is skipped,
// because that is where the answer goes. A byte-wide check localises damage to
// a bit position as well as detecting it, which is worth more in an
// eight-byte entry than in a four-byte record.

fn pool_stride() -> Word { 8 }
fn pool_tag_u16_u16() -> Word { 1 }
fn pool_tag_u16_u16_u8() -> Word { 2 }
fn pool_tag_u16_u16_u16() -> Word { 3 }
fn pool_tag_u24_u24() -> Word { 4 }

// The parity byte for the entry at `at`: the exclusive-or of byte 0 and bytes
// 2 through 7. Byte 1 is excluded by construction, not by masking.
fn pool_parity_of(at: Word) -> Word {
    ((((wire.bytes[at] as Word) bxor (wire.bytes[at + 2] as Word))
        bxor ((wire.bytes[at + 3] as Word) bxor (wire.bytes[at + 4] as Word)))
        bxor (((wire.bytes[at + 5] as Word) bxor (wire.bytes[at + 6] as Word))
            bxor (wire.bytes[at + 7] as Word)))
}

fn pool_tag(at: Word) -> Word {
    wire.bytes[at] as Word
}

fn pool_stored_parity(at: Word) -> Word {
    wire.bytes[at + 1] as Word
}

fn pool_parity_ok(at: Word) -> Word {
    if pool_stored_parity(at) == pool_parity_of(at) { 1 } else { 0 }
}

// Stamp the parity byte over an entry whose tag and payload are already
// written. Separate from the constructors so each of them ends the same way
// and none can forget it.
fn pool_seal(at: Word) -> Word {
    wire.bytes[at + 1] = (pool_parity_of(at) band 255) as Byte;
    at + 8
}

fn pool_write_u16_u16(at: Word, a: Word, b: Word) -> Word {
    wire.bytes[at] = pool_tag_u16_u16() as Byte;
    wire.bytes[at + 1] = 0 as Byte;
    put_u16(at + 2, a);
    put_u16(at + 4, b);
    wire.bytes[at + 6] = 0 as Byte;
    wire.bytes[at + 7] = 0 as Byte;
    pool_seal(at)
}

fn pool_write_u16_u16_u8(at: Word, a: Word, b: Word, c: Word) -> Word {
    wire.bytes[at] = pool_tag_u16_u16_u8() as Byte;
    wire.bytes[at + 1] = 0 as Byte;
    put_u16(at + 2, a);
    put_u16(at + 4, b);
    wire.bytes[at + 6] = (c band 255) as Byte;
    wire.bytes[at + 7] = 0 as Byte;
    pool_seal(at)
}

fn pool_write_u16_u16_u16(at: Word, a: Word, b: Word, c: Word) -> Word {
    wire.bytes[at] = pool_tag_u16_u16_u16() as Byte;
    wire.bytes[at + 1] = 0 as Byte;
    put_u16(at + 2, a);
    put_u16(at + 4, b);
    put_u16(at + 6, c);
    pool_seal(at)
}

// Two twenty-four-bit values, packed three bytes each with no padding, which is
// why this tag exists at all: a pair of u32 would not fit in six bytes.
fn pool_write_u24_u24(at: Word, a: Word, b: Word) -> Word {
    wire.bytes[at] = pool_tag_u24_u24() as Byte;
    wire.bytes[at + 1] = 0 as Byte;
    wire.bytes[at + 2] = (a band 255) as Byte;
    wire.bytes[at + 3] = ((a lsr 8) band 255) as Byte;
    wire.bytes[at + 4] = ((a lsr 16) band 255) as Byte;
    wire.bytes[at + 5] = (b band 255) as Byte;
    wire.bytes[at + 6] = ((b lsr 8) band 255) as Byte;
    wire.bytes[at + 7] = ((b lsr 16) band 255) as Byte;
    pool_seal(at)
}

// Payload readers. `k` selects the field: 0, 1, 2 for the u16 forms, 0 or 1 for
// the u24 pair. Reading with the wrong tag yields the bytes that are there,
// which is why a caller checks `pool_tag` first.
fn pool_u16(at: Word, k: Word) -> Word {
    get_u16(at + 2 + (k lsl 1))
}

fn pool_u8_field(at: Word) -> Word {
    wire.bytes[at + 6] as Word
}

fn pool_u24(at: Word, k: Word) -> Word {
    (wire.bytes[at + 2 + (k * 3)] as Word)
        + ((wire.bytes[at + 3 + (k * 3)] as Word) lsl 8)
        + ((wire.bytes[at + 4 + (k * 3)] as Word) lsl 16)
}

// --- SLICE 7: the framing header and the CRC trailer ---------------------
//
// The outermost layer, and the last of step 6. Sixty-four fixed bytes name the
// artifact and locate its three sections, and a four-byte CRC closes the file.
//
//   0  4  magic, "KELE"          32  4  opcode stream offset
//   4  2  version                36  4  opcode stream length
//   6  2  header length          40  4  operand pool offset
//   8  4  total length           44  4  operand pool length
//  12  1  word bits log2         48  4  auxiliary body offset
//  13  1  addr bits log2         52  4  auxiliary body length
//  14  1  float bits log2        56  4  auxiliary arena bytes
//  15  1  flags                  60  4  persistent composite bytes
//  16  4  declared WCET cycles
//  20  4  declared WCMU bytes
//  24  4  shared data bytes
//  28  4  private data bytes
//
// THE TRAILER IS VALIDATED BY A RESIDUE, NOT BY RECOMPUTATION. A reader does
// not checksum the body and compare against the stored trailer. It runs CRC-32
// over the WHOLE artifact, trailer included, and checks the result against a
// fixed constant. That works because appending a message's own CRC makes the
// checksum of the extended message a constant — 0x2144DF1C for this
// polynomial and this convention. One pass, no special-casing of the last four
// bytes, and nothing to get wrong about where the checksummed region ends.

fn header_bytes_len() -> Word { 64 }
fn bytecode_version() -> Word { 2 }
fn crc32_residue() -> Word { 0x2144DF1C }

fn flag_ephemeral() -> Word { 1 }
fn flag_requires_signature() -> Word { 2 }
fn flag_encrypted() -> Word { 4 }

fn fh_off_magic() -> Word { 0 }
fn fh_off_version() -> Word { 4 }
fn fh_off_header_length() -> Word { 6 }
fn fh_off_total_length() -> Word { 8 }
fn fh_off_word_bits_log2() -> Word { 12 }
fn fh_off_addr_bits_log2() -> Word { 13 }
fn fh_off_float_bits_log2() -> Word { 14 }
fn fh_off_flags() -> Word { 15 }
fn fh_off_wcet_cycles() -> Word { 16 }
fn fh_off_wcmu_bytes() -> Word { 20 }
fn fh_off_shared_data_bytes() -> Word { 24 }
fn fh_off_private_data_bytes() -> Word { 28 }
fn fh_off_opcode_offset() -> Word { 32 }
fn fh_off_opcode_length() -> Word { 36 }
fn fh_off_pool_offset() -> Word { 40 }
fn fh_off_pool_length() -> Word { 44 }
fn fh_off_aux_offset() -> Word { 48 }
fn fh_off_aux_length() -> Word { 52 }
fn fh_off_aux_arena_bytes() -> Word { 56 }
fn fh_off_persistent_composite_bytes() -> Word { 60 }

// "KELE" as a little-endian u32: bytes K, E, L, E.
fn magic_word() -> Word { 0x454C454B }

fn fh_u32(off: Word) -> Word { get_u32(off) }
fn fh_u16(off: Word) -> Word { get_u16(off) }
fn fh_u8(off: Word) -> Word { wire.bytes[off] as Word }

// 1 when the artifact's magic and version are the ones this reader knows.
// The VERSION IS CHECKED BEFORE ANYTHING ELSE that depends on layout, which is
// what makes an older artifact reject cleanly rather than be misread: every
// field position below is a version-2 fact.
fn fh_magic_ok() -> Word {
    if fh_u32(fh_off_magic()) == magic_word() { 1 } else { 0 }
}

fn fh_version_ok() -> Word {
    if fh_u16(fh_off_version()) == bytecode_version() { 1 } else { 0 }
}

fn fh_flag_set(mask: Word) -> Word {
    if (fh_u8(fh_off_flags()) band mask) == 0 { 0 } else { 1 }
}

// Write the sixty-four fixed bytes. Section offsets and lengths are supplied by
// the caller, because they are only known once the sections have been laid out.
fn emit_framing_header(total_len: Word, wlog2: Word, alog2: Word, flog2: Word) -> Word {
    put_u32(fh_off_magic(), magic_word());
    put_u16(fh_off_version(), bytecode_version());
    put_u16(fh_off_header_length(), header_bytes_len());
    put_u32(fh_off_total_length(), total_len);
    wire.bytes[fh_off_word_bits_log2()] = (wlog2 band 255) as Byte;
    wire.bytes[fh_off_addr_bits_log2()] = (alog2 band 255) as Byte;
    wire.bytes[fh_off_float_bits_log2()] = (flog2 band 255) as Byte;
    wire.bytes[fh_off_flags()] = 0 as Byte;
    for i in 0..48 limit 48 {
        wire.bytes[16 + i] = 0 as Byte;
    }
    header_bytes_len()
}

// Set one section's offset and length. Separate from the header emitter
// because the two are known at different times, and folding them together
// would force the caller to compute a layout before it has one.
fn set_section(off_field: Word, len_field: Word, offset: Word, length: Word) -> Word {
    put_u32(off_field, offset);
    put_u32(len_field, length);
    offset + length
}

// Append the four-byte CRC trailer over `[0, len)` and return the new total.
fn seal_artifact(len: Word) -> Word {
    put_u32(len, crc_range(0, len));
    len + 4
}

// 1 when the whole artifact, trailer included, checksums to the residue.
fn artifact_intact(total_len: Word) -> Word {
    if crc_range(0, total_len) == crc32_residue() { 1 } else { 0 }
}

// THE DISPATCH IS SPLIT INTO CHAINS, AND THE REASON IS A HARD LANGUAGE LIMIT.
//
// The parser rejects an expression nested more than 24 deep, with
// "parser recursion depth 24 exceeded; deeply nested expressions are rejected
// to prevent stack overflow". An `if / else if / ...` chain is right-nested, so
// one arm costs one level, which caps a flat dispatch at roughly two dozen
// commands. The diagnostic is clean rather than a crash, which is the language
// behaving well.
//
// Each chain below stays far under the limit. The thresholds are arbitrary and
// only have to keep the chains short; add a chain rather than lengthening one.

fn dispatch_container(cmd: Word) -> Word {
    if cmd == 0 { crc_range(0, wire.len) } else {
    if cmd == 1 { emit_prologue(wire.nregions) } else {
    if cmd == 2 { parse_prologue() } else {
    if cmd == 3 { prologue_disagreed() } else {
    if cmd == 4 { emit_directory(wire.nregions) } else {
    if cmd == 5 { dir_find(wire.warg) } else {
    if cmd == 6 { directory_disagreed() } else {
    if cmd == 7 { dir_u32(wire.warg, 4) } else {
    if cmd == 8 { dir_u32(wire.warg, 8) } else {
    if cmd == 9 { dir_u16(wire.warg, 0) } else {
    if cmd == 10 { emit_header() } else {
    if cmd == 11 { region_base(wire.warg) } else {
    if cmd == 12 { region_bytes(wire.warg) } else {
    0 - 98 }}}}}}}}}}}}}
}

fn dispatch_schema(cmd: Word) -> Word {
    if cmd == 13 { rec_count(wire.warg, wire.warg2) } else {
    if cmd == 14 { rec_u32(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 15 { rec_u16(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 16 { pool_u8(wire.warg, wire.warg2) } else {
    if cmd == 17 { emit_header(); emit_pattern_records(wire.warg, wire.warg2) } else {
    if cmd == 18 { name_count() } else {
    if cmd == 19 { name_offset(wire.warg) } else {
    if cmd == 20 { name_length(wire.warg) } else {
    if cmd == 21 { name_byte(wire.warg, wire.warg2) } else {
    if cmd == 22 { shape_count() } else {
    if cmd == 23 { shape_tag(wire.warg) } else {
    if cmd == 24 { shape_kind(wire.warg) } else {
    if cmd == 25 { shape_size(wire.warg) } else {
    0 - 97 }}}}}}}}}}}}}
}

fn dispatch_consts(cmd: Word) -> Word {
    if cmd == 26 { const_count() } else {
    if cmd == 27 { const_tag(wire.warg) } else {
    if cmd == 28 { const_flags(wire.warg) } else {
    if cmd == 29 { const_aux(wire.warg) } else {
    if cmd == 30 { const_is_composite(wire.warg) } else {
    if cmd == 31 { const_range_first(wire.warg) } else {
    if cmd == 32 { const_range_count(wire.warg) } else {
    if cmd == 33 { structaux_type_name(wire.warg) } else {
    if cmd == 34 { structaux_field_names_first(wire.warg) } else {
    if cmd == 35 { enumaux_type_name(wire.warg) } else {
    if cmd == 36 { enumaux_variant(wire.warg) } else {
    if cmd == 37 { enumaux_discriminant(wire.warg) } else {
    0 - 96 }}}}}}}}}}}}
}

fn dispatch_runs(cmd: Word) -> Word {
    if cmd == 38 { sig_count() } else {
    if cmd == 39 { sig_params_first(wire.warg) } else {
    if cmd == 40 { sig_params_count(wire.warg) } else {
    if cmd == 41 { sig_ret(wire.warg) } else {
    if cmd == 42 { sig_resume(wire.warg) } else {
    if cmd == 43 { sig_param_shape(wire.warg, wire.warg2) } else {
    if cmd == 44 { tpl_count() } else {
    if cmd == 45 { tpl_type_name(wire.warg) } else {
    if cmd == 46 { tpl_field_count(wire.warg) } else {
    if cmd == 47 { tpl_field_name(wire.warg, wire.warg2) } else {
    if cmd == 48 { elay_count() } else {
    if cmd == 49 { elay_type_name(wire.warg) } else {
    if cmd == 50 { elay_variants_count(wire.warg) } else {
    if cmd == 51 { elay_min_payload(wire.warg) } else {
    if cmd == 52 { elay_variant_in_range(wire.warg, wire.warg2) } else {
    if cmd == 53 { elay_variant_name(wire.warg, wire.warg2) } else {
    if cmd == 54 { elay_variant_disc(wire.warg, wire.warg2) } else {
    0 - 95 }}}}}}}}}}}}}}}}}
}

fn dispatch_data(cmd: Word) -> Word {
    if cmd == 55 { data_layout_present() } else {
    if cmd == 56 { data_slot_count() } else {
    if cmd == 57 { data_slot_name(wire.warg) } else {
    if cmd == 58 { data_slot_visibility(wire.warg) } else {
    if cmd == 59 { shared_slot_count() } else {
    if cmd == 60 { shared_slot_offset(wire.warg) } else {
    if cmd == 61 { shared_slot_kind(wire.warg) } else {
    if cmd == 62 { shared_slot_len(wire.warg) } else {
    if cmd == 63 { privcomp_count() } else {
    if cmd == 64 { privcomp_slot(wire.warg) } else {
    if cmd == 65 { privcomp_offset(wire.warg) } else {
    if cmd == 66 { datainit_count() } else {
    if cmd == 67 { datainit_first(wire.warg) } else {
    if cmd == 68 { datainit_range_count(wire.warg) } else {
    0 - 94 }}}}}}}}}}}}}}
}

fn dispatch_module(cmd: Word) -> Word {
    if cmd == 69 { chunk_count() } else {
    if cmd == 70 { chunk_u32(wire.warg, wire.warg2) } else {
    if cmd == 71 { chunk_local_count(wire.warg) } else {
    if cmd == 72 { chunk_param_count(wire.warg) } else {
    if cmd == 73 { chunk_block_type(wire.warg) } else {
    if cmd == 74 { chunk_has_debug(wire.warg) } else {
    if cmd == 75 { native_count() } else {
    if cmd == 76 { native_name(wire.warg) } else {
    if cmd == 77 { native_return_count() } else {
    if cmd == 78 { native_return_shape(wire.warg) } else {
    if cmd == 79 { header_present() } else {
    if cmd == 80 { header_u32(wire.warg) } else {
    if cmd == 81 { header_u8(wire.warg) } else {
    if cmd == 82 { entry_point_absent() } else {
    if cmd == 83 { absent_index() } else {
    0 - 93 }}}}}}}}}}}}}}}
}

fn dispatch_ops(cmd: Word) -> Word {
    if cmd == 84 { byte_parity(wire.warg) } else {
    if cmd == 85 { oprec_parity(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 86 { oprec_write(wire.warg, wire.warg2, wire.warg3, wire.warg4, wire.warg5) } else {
    if cmd == 87 { oprec_id(wire.warg) } else {
    if cmd == 88 { oprec_operand_byte(wire.warg, wire.warg2) } else {
    if cmd == 89 { oprec_operand_u24(wire.warg) } else {
    if cmd == 90 { oprec_stored_parity(wire.warg) } else {
    if cmd == 91 { oprec_parity_ok(wire.warg) } else {
    0 - 92 }}}}}}}}
}

fn dispatch_pool(cmd: Word) -> Word {
    if cmd == 92 { pool_tag(wire.warg) } else {
    if cmd == 93 { pool_stored_parity(wire.warg) } else {
    if cmd == 94 { pool_parity_of(wire.warg) } else {
    if cmd == 95 { pool_parity_ok(wire.warg) } else {
    if cmd == 96 { pool_write_u16_u16(wire.warg, wire.warg2, wire.warg3) } else {
    if cmd == 97 { pool_write_u16_u16_u8(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 98 { pool_write_u16_u16_u16(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 99 { pool_write_u24_u24(wire.warg, wire.warg2, wire.warg3) } else {
    if cmd == 100 { pool_u16(wire.warg, wire.warg2) } else {
    if cmd == 101 { pool_u8_field(wire.warg) } else {
    if cmd == 102 { pool_u24(wire.warg, wire.warg2) } else {
    0 - 91 }}}}}}}}}}}
}

fn dispatch_frame(cmd: Word) -> Word {
    if cmd == 103 { fh_u32(wire.warg) } else {
    if cmd == 104 { fh_u16(wire.warg) } else {
    if cmd == 105 { fh_u8(wire.warg) } else {
    if cmd == 106 { fh_magic_ok() } else {
    if cmd == 107 { fh_version_ok() } else {
    if cmd == 108 { fh_flag_set(wire.warg) } else {
    if cmd == 109 { emit_framing_header(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 110 { set_section(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 111 { seal_artifact(wire.warg) } else {
    if cmd == 112 { artifact_intact(wire.warg) } else {
    if cmd == 113 { magic_word() } else {
    if cmd == 114 { crc32_residue() } else {
    0 - 99 }}}}}}}}}}}}
}

// The schema emitters get their own chain. Folding them into `dispatch_frame`
// would have taken it to twenty-five arms, and the parser rejects an expression
// nested more than twenty-four deep — the same limit that shaped the original
// nine chains, reached again from the other end.
fn dispatch_emit(cmd: Word) -> Word {
    if cmd == 115 { emit_header(); emit_header_record_at(region_base(dir_find(kind_header()))) } else {
    if cmd == 116 { emit_chunk_records(wire.warg, wire.warg2) } else {
    if cmd == 117 { emit_pool_bytes(wire.warg, wire.warg2) } else {
    if cmd == 118 { emit_pool_pad(wire.warg, wire.warg2) } else {
    if cmd == 119 { emit_name_records(wire.warg, wire.warg2) } else {
    if cmd == 120 { emit_data_slot_records(wire.warg, wire.warg2) } else {
    if cmd == 121 { emit_shared_slot_records(wire.warg, wire.warg2) } else {
    if cmd == 122 { emit_shape_records(wire.warg, wire.warg2) } else {
    if cmd == 123 { emit_signature_records(wire.warg, wire.warg2) } else {
    if cmd == 124 { emit_enum_variant_records(wire.warg, wire.warg2) } else {
    if cmd == 125 { emit_enum_layout_records(wire.warg, wire.warg2) } else {
    if cmd == 126 { emit_data_init_records(wire.warg, wire.warg2) } else {
    if cmd == 127 { emit_const_records(wire.warg, wire.warg2) } else {
    if cmd == 128 { emit_struct_aux_records(wire.warg, wire.warg2) } else {
    if cmd == 129 { emit_enum_aux_records(wire.warg, wire.warg2) } else {
    if cmd == 130 { emit_struct_template_records(wire.warg, wire.warg2) } else {
    if cmd == 131 { emit_private_composite_records(wire.warg, wire.warg2) } else {
    if cmd == 132 { emit_native_records(wire.warg, wire.warg2) } else {
    if cmd == 133 { emit_native_return_records(wire.warg, wire.warg2) } else {
    0 - 98 }}}}}}}}}}}}}}}}}}}
}

// The DRIVER's own chain. `dispatch_emit` reached twenty arms with the region
// table added and `wire.kel` stopped compiling — the parser's depth limit again,
// and it presents as a STACK OVERFLOW in the test binary rather than as a parse
// error, which is the third time that symptom has appeared in this file.
//
// Nineteen arms is evidently near the practical ceiling for this chain shape, so
// the driver starts a fresh one rather than borrowing the last slot.
// Emit one region's payload INTO ITS PLACE in a partially built artifact.
//
// THE DRIVER'S SECOND PIECE. `build_region_table` computes the lengths and lays
// the directory; this puts a region's records where that directory says they
// go, by looking the region up rather than being handed an address.
//
// It exists because a whole artifact cannot be built in one call: the host
// re-seeds shared data on every invocation, so the artifact is carried forward
// as bytes between calls and each call fills in one more region. That is the
// same staged shape the residency measurement forced for the large stages,
// exercised here at a size where the whole thing fits.
//
// `at` is recomputed per arm rather than hoisted into
// `st`, because `dir_find` writes `st.cur` itself and borrowing that field
// would read as a bug to anyone tracing a lookup — the same reason `st.pad`
// exists separately.
// SLICE 18: the generic dispatch, positioned by an EXPLICIT offset.
//
// Every arm used to read `at`, an absolute artifact offset,
// which slice 17 established works for no real stage. Taking `at` as a parameter
// lets the same seventeen arms serve both the absolute caller and a low window,
// instead of a second chain that would drift from this one.
//
// It also BUYS DEPTH HEADROOM, which is not incidental. A dispatch chain's cap is
// a budget of 24 shared between chain position and arm-body nesting, and a
// nested-call body like `emit_x(at, n)` costs more of it
// than `emit_x(at, n)`. At seventeen arms this chain was one short of the
// eighteen a nested-call body allows; flattening the argument moves it well clear
// rather than leaving the next kind to discover the ceiling as a SIGABRT.
fn emit_at(k: Word, n: Word, at: Word) -> Word {
    if k == kind_names() { emit_name_records(at, n) } else {
    if k == kind_consts() { emit_const_records(at, n) } else {
    if k == kind_shapes() { emit_shape_records(at, n) } else {
    if k == kind_signatures() { emit_signature_records(at, n) } else {
    if k == kind_chunks() { emit_chunk_records(at, n) } else {
    if k == kind_header() { emit_header_record_at(at) } else {
    if k == kind_string_pool() { emit_pool_bytes(at, n) } else {
    if k == kind_param_types() { emit_pool_bytes(at, n) } else {
    // Added in slice 12. The original eight were exactly the minimal module's
    // regions, and the interner's constructed sources declare enums, so they
    // reach two more. The refusal is what surfaced it rather than a wrong
    // artifact — the guard slice 11 added, doing its job on its first real test.
    if k == kind_enum_variants() { emit_enum_variant_records(at, n) } else {
    if k == kind_enum_layouts() { emit_enum_layout_records(at, n) } else {
    // Added when the coverage upgrade drove these from real sources. The
    // refusal is what surfaced each one — a `-222` rather than a silently
    // mis-sized region — which is now the third time this guard has earned its
    // place on a kind nobody had exercised.
    if k == kind_natives() { emit_native_records(at, n) } else {
    if k == kind_native_returns() { emit_native_return_records(at, n) } else {
    if k == kind_private_composite() { emit_private_composite_records(at, n) } else {
    if k == kind_data_slots() { emit_data_slot_records(at, n) } else {
    if k == kind_shared_layout() { emit_shared_slot_records(at, n) } else {
    if k == kind_data_init() { emit_data_init_records(at, n) } else {
    // DEBUG_POOL reaches this dispatch for the first time here. Slice 9 drove it
    // through a different caller, so the generic path never needed an arm and the
    // stride table has known the kind all along -- `stride_of_kind` returns 0 for
    // it, the byte-pool answer. Only a caller that chooses the kind directly, as
    // the window emitter does, can reach it, which is why a corpus that never sets
    // `emit_debug` left the gap invisible.
    if k == kind_debug_pool() { emit_pool_bytes(at, n) } else {
    0 - 222 }}}}}}}}}}}}}}}}}
}

// The absolute caller, unchanged in meaning. The directory guard lives here
// rather than in `emit_at`, because the window form has no directory to consult.
fn emit_in_region(k: Word, n: Word) -> Word {
    if dir_find(k) < 0 { 0 - 221 } else { emit_at(k, n, region_base(dir_find(k))) }
}

// Bytes a window write of `n` units of kind `k` will span.
//
// `stride_of_kind` RETURNS THREE THINGS AND ONLY TWO OF THEM ARE STRIDES: a
// positive record stride, 0 for a byte pool, and -1 for an unknown kind. Its own
// comment says so. A pool's `n` is already a byte count, so multiplying it by the
// zero would bound every pool write at zero bytes; the caller wants `n` itself.
//
// This function exists because the first version of the guard below wrote
// `stride_of_kind(k) <= 0` and collapsed the pool case into the unknown case,
// refusing `STRING_POOL`, `PARAM_TYPES` and `DEBUG_POOL` outright. A real stage
// caught it immediately -- `PARAM_TYPES` is kind 30 -- but only because the test
// drove every kind the stage reaches rather than a chosen one.
fn window_span(k: Word, n: Word) -> Word {
    if stride_of_kind(k) == 0 { n } else { n * stride_of_kind(k) }
}

// The same dispatch, into a low window the caller positions.
//
// The kind is validated FIRST, and against `< 0` rather than `<= 0`. An unknown
// kind has no stride at all, so a span computed from it is meaningless; checking
// it up front also keeps the multiplication in `window_span` inside a range the
// count guard has already bounded.
fn emit_in_window() -> Word {
    if stride_of_kind(wire.warg) < 0 { 0 - 222 } else {
    if wire.warg3 < 0 { 0 - 264 } else {
    if wire.warg2 > ck_window_capacity() { 0 - 265 } else {
    if wire.warg3 + window_span(wire.warg, wire.warg2) > ck_window_capacity() { 0 - 265 } else {
        emit_at(wire.warg, wire.warg2, wire.warg3) } } } }
}

// --- SLICE 12: THE INTERNER, THE DRIVER'S FIRST COMPUTED VALUE ------------
//
// Everything before this slice RE-EMITTED values the host had decoded out of the
// reference artifact. This computes one instead: given the sequence of names the
// encoder interns, in order, with the mode each call site uses, it produces the
// `STRING_POOL` bytes and the `NAMES` records itself. The host supplies only the
// input sequence, which is genuine input rather than an answer.
//
// THE INTERNER HAS TWO MODES AND BOTH ARE LOAD-BEARING.
//
//   mode 0, `intern`       reuse an existing entry with the same bytes
//   mode 1, `intern_fresh` append unconditionally, even if the bytes exist
//
// A dedup-only port is not a simplification, it is a defect. `intern_fresh`
// exists for CONTIGUITY, not freshness: struct-constant field names and
// enum-variant names must form an unbroken run so that `first + i` addressing
// reaches field or variant `i`. Sharing a repeated name would collapse the run
// and silently misaddress every later element.
//
// The corpus cannot catch that. Four of the five stages measured have no
// duplicate names at all, and only `parse` has any — twenty, out of 58,053 —
// so a deduping-only interner would agree with the reference on four stages
// out of five and then be wrong on the one that matters. The differential
// therefore uses CONSTRUCTED sources, the smallest being two enums that share a
// variant name.
//
// A LAST MATCH WINS, AND THIS IS NOT A FREE CHOICE. The reference keeps a
// bytes-to-index map and `intern_fresh` INSERTS INTO IT, overwriting any
// existing mapping. So when the same bytes have been appended twice, a later
// `intern` yields the SECOND index, not the first. Measured, not inferred: for
// `enum A { X, P } enum B { X, Q } enum X { R }` the reference's third layout
// cites name index 5, the later `X`, while indices 2 and 5 both hold those
// bytes. A forward first-match scan produces an artifact whose `NAMES` and
// `STRING_POOL` are byte-identical and whose `ENUM_LAYOUTS` is wrong — which is
// exactly the silent-divergence class this differential exists to catch, and it
// would have slipped through had the scan been written the obvious way.
//
// THE SCAN IS LINEAR, AND THAT IS A KNOWN DEBT RATHER THAN AN OVERSIGHT.
// The reference used a linear scan once and encoding a mid-sized stage took 782
// seconds; it is a `BTreeMap` now. At the sizes this slice drives — ten names —
// a scan is right, and the structure that replaces it is a separate increment
// with its own measurement. **It must be replaced before the interner is driven
// by a real stage**, where the count reaches 395,804. Recorded here rather than
// only in the plan document, because this is where someone will read it.
//
// COMPACTION IS IN PLACE, AND THE ARGUMENT IS SHORT ENOUGH TO CHECK.
// Input and output share `wire.bin` and `wire.fin`. The output cursor is the sum
// of the emitted names' lengths and the input cursor is the sum of ALL names'
// lengths, over the same prefix; emitted is a subset of all, so the output
// cursor never exceeds the input cursor. Byte ranges therefore never overlap in
// the wrong direction, and the record pairs coincide only when nothing has been
// deduped yet, where the input pair is read before the output pair is written.
private data nm {
    // Byte cursor into the INPUT concatenation in `wire.bin`.
    icur: Word,
    // Byte cursor into the OUTPUT pool, compacted in place over the input.
    ocur: Word,
    // Names emitted so far, which is also the index the next one would take.
    cnt: Word,
    // Start of the name being considered. Needed because the input cursor has
    // already advanced past it by the time the scan runs, and a local cannot
    // carry it: this file uses no locals, for the reason `crc.acc` records.
    ioff: Word,
    // Scan result: the index of a matching emitted name, or -1.
    found: Word,
    // Byte-comparison accumulator.
    eq: Word,
    // Sticky rejection code, 0 while the input is admissible. Sticky rather than
    // an early return because the language is total and the loop bound is
    // static, so there is nothing to break out of.
    err: Word,
    // Discards a call's result where the interesting output is in the fields.
    // A separate field rather than a borrowed one, for the reason `st.pad` is
    // separate from `st.dis`: reusing an accumulator here would read as a bug.
    sink: Word,
}

// The longest name this slice admits, and it is a STATED CAP rather than a
// silent one. It bounds the byte-comparison loop, which is the innermost of
// three nested loops and therefore the whole thing's worst case. Identifiers and
// the generated per-element slot names are far shorter; a longer one is rejected
// with a code instead of being truncated or scanned past its buffer.
fn nm_max_name() -> Word { 256 }

// The most names one call admits.
//
// 256 rather than the 512 that two words per name would allow, because the
// upper half of `wire.fin` carries the input-to-index MAP. That map is the piece
// downstream records actually consume — a chunk cites a name index, not a name —
// and it is also the only way the last-match rule above is observable at all:
// first-match and last-match produce identical `NAMES` and `STRING_POOL`
// regions, so without the map the rule would be logic with no test that could
// fail. Halving the cap to make a rule testable is the right trade.
fn nm_max_names() -> Word { 256 }

// Where the input-to-index map starts in `wire.nout`. Output record pairs occupy
// `[0, 2 * cnt)` and `cnt <= n <= 256`, so they never reach here.
fn nm_map_base() -> Word { 512 }

// Where each INPUT name's byte offset into `bin` lives, one word per name.
//
// Slice 12 never materialised these: it walked `nin` in order with a running
// cursor, so an offset was always the cursor's current value. Slice 13b interns
// during a breadth-first walk, in an order that is not the input order, so an
// arbitrary name's offset has to be recoverable on demand. A prefix sum over
// `nin` computed once is cheaper than widening `nin` to (offset, length, mode)
// triples, which would change every test that feeds the interner.
//
// THE THREE REGIONS OF `nout` TILE IT EXACTLY, WITH NO SLACK, and that is a
// fragility worth spelling out because nothing checks it:
//
//   record pairs   [0, 2 * cnt)      cnt <= 256   ->  [0, 512)
//   input->index   [512, 512 + n)    n   <= 256   ->  [512, 768)
//   byte offsets   [768, 768 + n)    n   <= 256   ->  [768, 1024)
//
// `nout` is 1024 words, so a 256-name run fills it to the last slot. **Raising
// `nm_max_names` breaks all three layouts at once and silently**: the pairs
// would run into the map, the map into the offsets, and the offsets off the end,
// with no bound violated that the language could catch. Raising the cap means
// resizing `nout` and moving both bases, together, or giving each region its own
// array. The `-230` rejection is what keeps the cap honest at runtime; this
// comment is what keeps it honest at edit time.
fn nm_off_base() -> Word { 768 }

// Whether two names in `wire.bin` hold the same bytes.
//
// No early exit, which is not a limitation here: the loop bound must be static
// anyway, so a full compare costs what a bailing one would have to reserve.
// Whether an ALREADY EMITTED name and a CANDIDATE hold the same bytes.
//
// The two arguments address different arrays, and that asymmetry is the point:
// `pool_off` indexes the emitted pool in `bout`, `in_off` indexes the untouched
// input in `bin`. Named rather than left as `a` and `b`, because a caller that
// swapped them would compare a pool offset against the pool and silently find
// the wrong thing.
fn nm_bytes_equal(pool_off: Word, in_off: Word, len: Word) -> Word {
    nm.eq = 1;
    for i in 0..len limit 256 {
        nm.eq = if wire.bout[pool_off + i] != wire.bin[in_off + i] { 0 } else { nm.eq };
    }
    nm.eq
}

// The index of the LAST emitted name whose bytes match, or -1.
//
// Last, not first — see the note above. The idiom differs from `dir_find`, which
// keeps its FIRST hit by guarding the assignment; here the unguarded assignment
// is the correct one, and the difference is deliberate.
fn nm_find(coff: Word, clen: Word, upto: Word) -> Word {
    nm.found = 0 - 1;
    for i in 0..upto limit 512 {
        nm.found = if wire.nout[(i * 2) + 1] == clen
            andalso nm_bytes_equal(wire.nout[i * 2], coff, clen) == 1 { i } else { nm.found };
    }
    nm.found
}

// Append one name to the pool and record its reference. Returns the new count;
// the caller owns the counter, so the increment is not hidden in here.
fn nm_append(ioff: Word, ilen: Word) -> Word {
    for b in 0..ilen limit 256 {
        wire.bout[nm.ocur + b] = wire.bin[ioff + b];
    }
    wire.nout[nm.cnt * 2] = nm.ocur;
    wire.nout[(nm.cnt * 2) + 1] = ilen;
    nm.ocur = nm.ocur + ilen;
    nm.cnt + 1
}

// Run the interner over `n` input names.
//
// Input: `wire.fin[2j]` is name `j`'s length and `wire.fin[2j+1]` its mode;
// `wire.bin` holds the names concatenated in order.
// Output, in place: `wire.fin[2i]` and `wire.fin[2i+1]` are emitted name `i`'s
// pool offset and length, and `wire.bin[0..nm.ocur]` is the pool.
// Byte offsets for every input name, plus the per-name length check.
//
// The length check rides along because both want one pass and because a length
// too large to compare must be rejected BEFORE it is used as a loop bound.
fn nm_offsets(n: Word) -> Word {
    nm.icur = 0;
    for m in 0..n limit 256 {
        wire.nout[nm_off_base() + m] = nm.icur;
        nm.icur = nm.icur + wire.nin[m * 2];
        nm.err = if wire.nin[m * 2] > nm_max_name() { 0 - 231 } else { nm.err };
    }
    nm.icur
}

// Intern the single input name `m`, appending to whatever state already exists.
//
// THE ONE INTERNING PRIMITIVE, and that is the point of this shape. `intern_run`
// calls it for `0..n` in order; slice 13b's walk calls it for whichever name the
// breadth-first order reaches next. One implementation means the sequential path
// and the out-of-order path cannot drift, and it is why the pool needed its own
// output buffer: the two orders would otherwise alias.
//
// Returns the `NAMES` index this input resolved to.
fn nm_intern_at(m: Word) -> Word {
    nm.ioff = wire.nout[nm_off_base() + m];
    nm.found = if wire.nin[(m * 2) + 1] == 0 {
                   nm_find(nm.ioff, wire.nin[m * 2], nm.cnt)
               } else { 0 - 1 };
    // Written BEFORE the count moves: a name about to be appended takes the
    // index `nm.cnt` currently holds.
    wire.nout[nm_map_base() + m] = if nm.found < 0 { nm.cnt } else { nm.found };
    nm.cnt = if nm.found < 0 { nm_append(nm.ioff, wire.nin[m * 2]) } else { nm.cnt };
    wire.nout[nm_map_base() + m]
}

fn intern_run(n: Word) -> Word {
    nm.ocur = 0;
    nm.cnt = 0;
    nm.err = 0;
    nm.sink = nm_offsets(n);
    nm.err = if nm.icur > bin_capacity() { 0 - 232 } else { nm.err };
    for j in 0..n limit 256 {
        nm.sink = if nm.err < 0 { 0 } else { nm_intern_at(j) };
    }
    if nm.err < 0 { nm.err } else { nm.cnt }
}

// The `NAMES` index that input name `j` resolved to.
//
// The interner is a pure function of its input, so re-running it to answer this
// is not a second answer to the same question — it is the same answer, which is
// what makes the host relaying figures between re-seeded calls sound.
fn intern_index_of(n: Word, j: Word) -> Word {
    nm.sink = intern_names(n);
    if nm.err < 0 { nm.err } else {
    if j >= n { 0 - 235 } else { wire.nout[nm_map_base() + j] } }
}

// The count guard is SEPARATE from the loop rather than a condition inside it.
//
// `for j in 0..n limit 512` TRAPS with `LoopLimitExceeded` when the runtime
// range exceeds the static cap, so a sticky error flag would not help: the trap
// happens on entry, before any flag could be read. The oversize case must
// therefore never reach the loop at all.
fn intern_names(n: Word) -> Word {
    if n > nm_max_names() { nm.err = 0 - 230; nm.cnt = 0; nm.ocur = 0; nm.err }
    else { intern_run(n) }
}

// The pool's byte length after interning the same input.
//
// A separate command because a call returns one word and the host must relay
// both figures back: shared data is re-seeded on every call, so the interner's
// output cannot persist into the next one. Re-running is not a second answer to
// the same question — the interner is a pure function of its input.
fn intern_pool_len(n: Word) -> Word {
    nm.sink = intern_names(n);
    if nm.err < 0 { nm.err } else { nm.ocur }
}

// Intern, then write the `NAMES` records into their region. One call, because
// the interner's output lives in shared data that the next call would clear.
// The `NAMES` emitter for interner output.
//
// A near-twin of `emit_name_records`, which reads `fin`. Not folded into one
// function taking a source, because `fin` and `nout` are different arrays rather
// than a parameterisable base, and because slice 5's emitter is driven directly
// by its own tests with `fin`-shaped input. Duplicating four lines is cheaper
// than making the older emitter's tests depend on the newer channel.
fn emit_name_records_from_nout(at: Word, n: Word) -> Word {
    if (n * nameref_fields()) > fin_capacity() { 0 - 202 } else {
        for j in 0..n limit 1024 {
            put_u32(
                at + (j * nameref_stride()) + nameref_off_offset(),
                wire.nout[j * nameref_fields()],
            );
            put_u32(
                at + (j * nameref_stride()) + nameref_off_length(),
                wire.nout[(j * nameref_fields()) + 1],
            );
        }
        n * nameref_stride()
    }
}

fn intern_emit_names(n: Word) -> Word {
    nm.sink = intern_names(n);
    if nm.err < 0 { nm.err } else {
    if dir_find(kind_names()) < 0 { 0 - 233 } else {
        emit_name_records_from_nout(region_base(dir_find(kind_names())), nm.cnt) } }
}

// Intern, then write the `STRING_POOL` bytes and their pad.
//
// The pad is emitted explicitly. Slice 11 got it free because the host passed
// the region's STORED bytes, which are already padded; a computed pool is the
// unpadded length, so the rounding is this function's job.
// The pool emitter for interner output, reading `bout`.
//
// A twin of `emit_pool_bytes`, which reads `bin`, for the same reason
// `emit_name_records_from_nout` is a twin: two arrays, not one array from two
// bases, and slice 4's emitter is driven directly by its own `bin`-shaped tests.
fn emit_pool_bytes_from_bout(at: Word, n: Word) -> Word {
    // ITS OWN CODE, not slice 4's `-201`. Two guards returning one code leave a
    // caller unable to say which buffer overflowed, and these two are reached
    // from different directions entirely.
    //
    // UNREACHABLE BY CONSTRUCTION TODAY, and kept anyway: `nm.ocur` is the sum
    // of the EMITTED names' lengths, which is bounded by the sum of all input
    // lengths, which `intern_run` already refuses above `bin_capacity()`. The
    // guard is here so the emitter does not depend on a caller's invariant —
    // which is also why it has no negative test: nothing this corpus can build
    // reaches it, and a test asserting an unreachable code would be theatre.
    if n > bout_capacity() { 0 - 255 } else {
        for j in 0..n limit 8192 {
            wire.bytes[at + j] = wire.bout[j];
        }
        n
    }
}

fn intern_emit_pool(n: Word) -> Word {
    nm.sink = intern_names(n);
    if nm.err < 0 { nm.err } else {
    if dir_find(kind_string_pool()) < 0 { 0 - 234 } else {
        emit_pool_bytes_from_bout(region_base(dir_find(kind_string_pool())), nm.ocur)
            + emit_pool_pad(region_base(dir_find(kind_string_pool())) + nm.ocur, nm.ocur) } }
}

// --- SLICE 13: THE FLATTENER'S BREADTH-FIRST REORDERING -------------------
//
// The second value the driver computes. `flatten` turns a constant FOREST into
// the flat `CONSTS` table, and the ordering it produces is the whole of the
// difficulty: the roots occupy `0..nroots` in order, and children are numbered
// BREADTH-FIRST after them. That is what guarantees every range points forward,
// which is what lets a reader walk the table in one reverse sweep with no stack.
//
// THE INPUT IS DEPTH-FIRST, ON PURPOSE. A tree arrives as a preorder walk —
// three words per node in `wire.fin`: tag, payload, child count — because that
// is the natural flat serialization of a tree and because handing Keleusma a
// breadth-first input would make the test vacuous. The reordering is the work.
//
// The two orders genuinely differ on the corpus of constructed sources. For
// `const data k { a: [(Word, Word); 2] = [(1, 2), (3, 4)] }` the roots are the
// array and a scalar index, and the orders are:
//
//   breadth-first  Array, Int, Tuple, Tuple, 1, 2, 3, 4     <- the reference
//   depth-first    Array, Tuple, 1, 2, Tuple, 3, 4, Int
//
// so a flattener that emitted its input unchanged would fail on the first
// depth-2 case rather than passing quietly.
//
// SCOPE. Scalars, tuples and arrays — the tags whose records need no name
// interning. `STATIC_STR`, `STRUCT` and `ENUM` also intern as they walk, which
// couples the flattener to the interner and to the two side tables; that is the
// next slice, and it is why this one stops where it does.
//
// THERE IS NO `while`, AND NONE IS NEEDED. The reference loops until the queue
// drains. Here the queue provably ends at exactly `nnodes` entries, since every
// node is enqueued once, so a `for head in 0..nnodes` walks it exactly. A total
// language forces the bound to be stated and in this case the bound was already
// known — the restriction cost nothing.
private data fl {
    // Sibling cursor: a preorder index being advanced past whole subtrees.
    cur: Word,
    // Subtree-size accumulator.
    tot: Word,
    // Queue length, which is ALSO the next breadth-first index to allocate.
    // The reference carries a separate `next_index`; the two are provably equal
    // at every step — both start at `nroots` and both grow by the child count —
    // so keeping one field removes the chance of them disagreeing.
    qn: Word,
    // The breadth-first index of the current node's first child.
    first: Word,
    // Index actually used after clamping, so a malformed input cannot index out
    // of range while the error code is being raised.
    pick: Word,
    // The clamped QUEUE index, separate from `pick`. One field served both roles
    // at first and was correct only because each iteration reassigned before
    // use — the kind of coupling this file keeps apart deliberately, as `st.pad`
    // records. Found by reading the code back, not by a failing test.
    qpick: Word,
    // Sticky rejection code, 0 while the input is well formed.
    err: Word,
    // Discards a call whose result is in the fields.
    sink: Word,
    // A propagated return code. Separate from `sink`, which discards: reusing
    // the discard field for a value that is then TESTED is how a guard quietly
    // stops guarding.
    rc: Word,
    // Running `STRUCT_AUX` index, assigned in breadth-first order like every
    // other index the walk hands out.
    saux: Word,
    // Where `STRUCT_AUX` records go. A field rather than a parameter so
    // `fl_walk` and `fl_put_record` keep the signatures command 141 already
    // uses; 141 never emits a struct, because its scope predicate rejects the
    // tag before the walk starts.
    sauxat: Word,
    // A struct's interned type-name index, held across the field run.
    tn: Word,
    // The name index the field run starts at.
    ffirst: Word,
    // Running `ENUM_AUX` index, and where those records go. Same shape as the
    // struct pair, and separate from it because the two tables are independent.
    eaux: Word,
    eauxat: Word,
}

// `wire.fin` holds six words per node, so 1024 words is 170 nodes. A STATED cap:
// an oversized forest is refused with a code, not truncated.
//
// SIX RATHER THAN THREE, widened for slice 13b. `STATIC_STR`, `STRUCT` and
// `ENUM` each need a name-group start, and an enum additionally needs a flag and
// a SIGNED discriminant — which `payload` cannot carry, because a composite's
// payload is its child range. Widened once, in advance of the two slices that
// consume the new columns, rather than migrating this record and its tests
// twice.
fn fl_max_nodes() -> Word { 170 }

fn fl_fields() -> Word { 6 }

fn fl_tag_of(p: Word) -> Word { wire.fin[p * fl_fields()] }
fn fl_payload_of(p: Word) -> Word { wire.fin[(p * fl_fields()) + 1] }
fn fl_children_of(p: Word) -> Word { wire.fin[(p * fl_fields()) + 2] }
// Index into `nin` of this node's first name. Meaningful only for the three
// interning tags; zero elsewhere.
fn fl_names_first_of(p: Word) -> Word { wire.fin[(p * fl_fields()) + 3] }
fn fl_flags_of(p: Word) -> Word { wire.fin[(p * fl_fields()) + 4] }
fn fl_disc_of(p: Word) -> Word { wire.fin[(p * fl_fields()) + 5] }

// Only these two carry a range in this slice. Struct and enum also do, and are
// deliberately absent: admitting them here would emit a record with `aux` 0,
// which is a plausible-looking wrong answer rather than a refusal.
fn fl_tag_has_range(t: Word) -> Word {
    if t == tag_tuple() { 1 } else {
    if t == tag_array() { 1 } else {
    if t == tag_struct() { 1 } else {
    if t == tag_enum() { 1 } else { 0 } } } }
}

// Slice 13b's scope: everything slice 13 admits, plus `STATIC_STR`, which
// interns a name as the walk reaches it.
//
// A SEPARATE predicate rather than a mode flag on the old one. Command 141 must
// keep rejecting `STATIC_STR` with `-245`, because it never seeds the interner —
// admitting the tag there would intern against an empty table and produce a
// record citing index 0, which is a plausible wrong answer rather than a refusal.
fn fx_tag_in_scope(t: Word) -> Word {
    if t == tag_static_str() { 1 } else {
    if t == tag_struct() { 1 } else {
    if t == tag_enum() { 1 } else { fl_tag_in_scope(t) } } }
}

// Intern an enum node's two names and write its `ENUM_AUX` record. Returns the
// aux index the `CONSTS` record must cite.
//
// BOTH NAMES DEDUP, unlike a struct's field run. Nothing addresses a variant by
// `first + i`, so there is no contiguity to protect and `intern` is correct for
// both. Getting this backwards would append duplicates that the reference
// shares — the mirror image of the struct case, and the reason the two are
// separate functions rather than one parameterised by mode.
//
// The discriminant is written UNCONDITIONALLY, but it is meaningful only when
// the record carries `FLAG_HAS_DISCRIMINANT`. A bare zero here is not the same
// as `Some(0)`, which is why the flag rides the CONSTS record rather than being
// inferred from the value.
fn fx_enum_aux(p: Word) -> Word {
    fl.tn = nm_intern_at(fl_names_first_of(p));
    fl.ffirst = nm_intern_at(fl_names_first_of(p) + 1);
    put_u32(
        fl.eauxat + (fl.eaux * enumaux_stride()) + enumaux_off_type_name(),
        fl.tn,
    );
    put_u32(
        fl.eauxat + (fl.eaux * enumaux_stride()) + enumaux_off_variant(),
        fl.ffirst,
    );
    put_u64(
        fl.eauxat + (fl.eaux * enumaux_stride()) + enumaux_off_discriminant(),
        fl_disc_of(p),
    );
    fl.eaux = fl.eaux + 1;
    fl.eaux - 1
}

// Intern a struct node's names and write its `STRUCT_AUX` record. Returns the
// aux index the `CONSTS` record must cite.
//
// THE ORDER IS THE WHOLE OF IT, and it is measured rather than inferred
// (`wire_schema.rs:412-442`, confirmed end to end against a real artifact where
// `type_name` is 2 and `field_names_first` is 3):
//
//   1. intern the TYPE NAME, with dedup
//   2. THEN read the name count — that is `field_names_first`
//   3. then intern each field name FRESH, so the run stays contiguous
//
// Capturing `field_names_first` before step 1 is off by one on every struct
// whose type name is new, and correct on every struct whose type name is
// already present — which is why a corpus of familiar type names would hide it.
//
// Step 3 is where `intern_fresh` finally has a consumer. A field name repeated
// across two structs MUST appear twice, or `field_names_first + i` stops
// addressing field `i`.
fn fx_struct_aux(p: Word) -> Word {
    fl.tn = nm_intern_at(fl_names_first_of(p));
    fl.ffirst = nm.cnt;
    for k in 0..fl_children_of(p) limit 170 {
        nm.sink = nm_intern_at(fl_names_first_of(p) + 1 + k);
    }
    put_u32(
        fl.sauxat + (fl.saux * structaux_stride()) + structaux_off_type_name(),
        fl.tn,
    );
    put_u32(
        fl.sauxat + (fl.saux * structaux_stride()) + structaux_off_field_names_first(),
        fl.ffirst,
    );
    fl.saux = fl.saux + 1;
    fl.saux - 1
}

fn fx_validate(nnodes: Word) -> Word {
    fl.err = 0;
    for p in 0..nnodes limit 170 {
        fl.err = if fl_children_of(p) > nnodes { 0 - 241 } else {
                 if fx_tag_in_scope(fl_tag_of(p)) == 0 { 0 - 245 } else { fl.err } };
    }
    fl.err
}

fn fl_tag_in_scope(t: Word) -> Word {
    if t == tag_unit() { 1 } else {
    if t == tag_none() { 1 } else {
    if t == tag_bool() { 1 } else {
    if t == tag_int() { 1 } else {
    if t == tag_byte() { 1 } else {
    if t == tag_fixed() { 1 } else {
    if t == tag_float() { 1 } else {
    // SPELLED OUT rather than delegating to `fl_tag_has_range`, which it used
    // to do. That coupling was a defect: adding `STRUCT` to the range predicate
    // for slice 13b-ii silently widened THIS predicate too, so command 141
    // began accepting a struct it cannot intern — the precise failure the
    // separate `fx_tag_in_scope` exists to prevent. Caught by the negative test
    // that asserts 141 still refuses an out-of-scope tag.
    //
    // "Carries a child range" and "is in slice 13's scope" happened to coincide
    // for two tags. Sharing one function for both made a change to either
    // silently change the other.
    if t == tag_tuple() { 1 } else {
    if t == tag_array() { 1 } else { 0 } } }}}}}}}
}

// Advance `fl.cur` past the whole subtree rooted there, returning that
// subtree's size. Clamped: an out-of-range cursor sets the error code AND reads
// index 0 rather than off the end, so the refusal is reported from a
// memory-safe state.
fn fl_step(nnodes: Word) -> Word {
    fl.err = if fl.cur >= nnodes { 0 - 242 } else { fl.err };
    fl.pick = if fl.cur < nnodes { fl.cur } else { 0 };
    fl.cur = fl.cur + wire.fsz[fl.pick];
    wire.fsz[fl.pick]
}

// The subtree size at preorder index `p`, given every index above `p` is sized.
fn fl_size_at(p: Word, nnodes: Word) -> Word {
    fl.cur = p + 1;
    fl.tot = 1;
    for k in 0..fl_children_of(p) limit 170 {
        fl.tot = fl.tot + fl_step(nnodes);
    }
    fl.tot
}

// Size every node, highest preorder index first. The reverse order is what
// makes a single pass sufficient: a node's children all sit above it in
// preorder, so they are already sized when it is reached.
fn fl_size_all(nnodes: Word) -> Word {
    for i in 0..nnodes limit 170 {
        wire.fsz[nnodes - 1 - i] = fl_size_at(nnodes - 1 - i, nnodes);
    }
    fl.err
}

// Every child count must be admissible before any loop uses one as a BOUND.
// `for k in 0..n limit 170` TRAPS when the runtime range exceeds the cap, so a
// count of 9999 in a malformed input would abort the VM rather than be
// reported. Validation therefore precedes sizing, not the other way round.
fn fl_validate(nnodes: Word) -> Word {
    fl.err = 0;
    for p in 0..nnodes limit 170 {
        fl.err = if fl_children_of(p) > nnodes { 0 - 241 } else {
                 if fl_tag_in_scope(fl_tag_of(p)) == 0 { 0 - 245 } else { fl.err } };
    }
    fl.err
}

// Seed the queue with the roots. Root 0 is at preorder 0; each later root sits
// one whole subtree past the previous one.
fn fl_seed_roots(nroots: Word, nnodes: Word) -> Word {
    fl.cur = 0;
    for r in 0..nroots limit 170 {
        wire.fq[r] = fl.cur;
        fl.sink = fl_step(nnodes);
    }
    nroots
}

// THE ROOTS' SUBTREES MUST EXACTLY COVER THE FOREST.
//
// Walking the roots leaves `fl.cur` at the sum of their subtree sizes, which is
// the true node count. If the caller's `nnodes` disagrees, the walk runs past
// the filled part of the queue and re-emits whichever index was left in it —
// silently, with no error. Caught by reading the walk back rather than by a
// test: `nroots = 1`, `nnodes = 3` and one childless root emitted three copies
// of node 0.
//
// It lives in the VALIDATION CHAIN rather than inside `fl_seed_roots`, where it
// was first written. Seeding happens inside the walk, which runs only after the
// region lookup, so a caller with no directory got `-247` and never reached this
// at all — the guard was unreachable in exactly the case its test exercised.
fn fl_cover(nroots: Word, nnodes: Word) -> Word {
    fl.cur = 0;
    for r in 0..nroots limit 170 {
        fl.sink = fl_step(nnodes);
    }
    if fl.cur != nnodes { 0 - 248 } else { 0 }
}

// Write the record for the node at queue position `head`.
fn fl_put_record(at: Word, head: Word) -> Word {
    put_u16(at + (head * const_stride()) + const_off_tag(), fl_tag_of(wire.fq[head]));
    // Only an enum sets a flag today, and it comes from the node record rather
    // than being inferred from the discriminant VALUE: `Some(0)` and `None`
    // both present as zero, and only the flag separates them.
    put_u16(
        at + (head * const_stride()) + const_off_flags(),
        fl_flags_of(wire.fq[head]),
    );
    // A `STATIC_STR`'s `aux` is its NAME INDEX, and interning it HERE is what
    // couples the two computed values: the walk reaches nodes breadth-first, so
    // the name sequence is a function of that order rather than of the input
    // order. Unreachable from command 141, whose validation rejects the tag.
    put_u32(
        at + (head * const_stride()) + const_off_aux(),
        if fl_tag_of(wire.fq[head]) == tag_static_str() {
            nm_intern_at(fl_names_first_of(wire.fq[head]))
        } else {
        if fl_tag_of(wire.fq[head]) == tag_struct() {
            fx_struct_aux(wire.fq[head])
        } else {
        if fl_tag_of(wire.fq[head]) == tag_enum() {
            fx_enum_aux(wire.fq[head])
        } else { 0 } } },
    );
    put_u64(
        at + (head * const_stride()) + const_off_payload(),
        if fl_tag_has_range(fl_tag_of(wire.fq[head])) == 1 {
            fl.first bor (fl_children_of(wire.fq[head]) lsl 32)
        } else {
            fl_payload_of(wire.fq[head])
        },
    )
}

// The breadth-first walk. `fl.qn` is both the queue length and the next index
// to allocate, so a node's first child index is simply the queue length before
// its children are appended.
fn fl_walk(at: Word, nroots: Word, nnodes: Word) -> Word {
    fl.qn = fl_seed_roots(nroots, nnodes);
    for head in 0..nnodes limit 170 {
        fl.first = fl.qn;
        fl.err = if fl.qn + fl_children_of(wire.fq[head]) > nnodes { 0 - 244 } else { fl.err };
        fl.cur = wire.fq[head] + 1;
        for k in 0..fl_children_of(wire.fq[head]) limit 170 {
            fl.qpick = if fl.first + k < nnodes { fl.first + k } else { 0 };
            wire.fq[fl.qpick] = fl.cur;
            fl.sink = fl_step(nnodes);
        }
        fl.qn = fl.qn + fl_children_of(wire.fq[head]);
        // Written AFTER the children are enqueued, because the record's range
        // needs `fl.first`, which is read before the queue grows.
        fl.sink = fl_put_record(at, head);
    }
    if fl.err < 0 { fl.err } else { nnodes * const_stride() }
}

// Flatten the forest in `wire.fin` and write `CONSTS` into its region.
//
// `nnodes` is an input rather than something computed, so the directory can be
// laid before this runs and there is no chicken-and-egg with the region length.
fn flatten_emit_consts(nroots: Word, nnodes: Word) -> Word {
    if nnodes > fl_max_nodes() { 0 - 240 } else {
    if nroots > nnodes { 0 - 246 } else {
    if fl_validate(nnodes) < 0 { fl.err } else {
    if fl_size_all(nnodes) < 0 { fl.err } else {
    if fl_cover(nroots, nnodes) < 0 { 0 - 248 } else {
    if dir_find(kind_consts()) < 0 { 0 - 247 } else {
    // 141 never emits a struct — its scope predicate rejects the tag — but the
    // aux base must still point somewhere harmless rather than at address 0.

        fl.sauxat = fx_scratch_aux();
        fl.eauxat = fx_scratch_eaux();
        fl_walk(region_base(dir_find(kind_consts())), nroots, nnodes) } } } } } }
}

// --- SLICE 13b-i: THE WALK DRIVES THE INTERNER --------------------------
//
// The first place two computed values interact. `flatten` interns as it walks,
// so the name sequence is a function of the BREADTH-FIRST order — and that is
// observable, measured rather than assumed:
//
//   const data k { t: ((Text, Word), Text) = (("aaa", 1), "bbb") }
//     breadth-first  outer, inner, "bbb", "aaa", 1   ->  pool "bbbaaa"
//     depth-first    outer, inner, "aaa", 1, "bbb"   ->  pool "aaabbb"
//
// A single string inside a tuple is visited first under BOTH walks and proves
// nothing, which is the vacuity four of slice 13's five cases had. Two strings
// at different depths are the smallest case that discriminates.
//
// THE INTERNER STARTS PART-WAY THROUGH, NOT EMPTY. `flatten` runs inside
// `SchemaBuilder::finish`, after every `add_chunk` and `add_enum_layouts`, so
// constant names append to a table that already holds the chunk and layout
// names. One call therefore seeds that PREFIX and then walks, because shared
// data is re-seeded between calls and nothing survives.
//
// Arguments ride the `warg` slots: `warg` is the total `nin` entry count,
// `warg2` the prefix length, `warg3` the root count, `warg4` the node count.

// Where a counting pass writes its throwaway `CONSTS` records. Artifacts run to
// about a kilobyte against a 65,536-byte buffer, so the top half is free. A
// counting pass must walk exactly as the emitting pass does — same code, same
// interning — and the cheapest way to guarantee that is to run the SAME
// function at a different address rather than a second function that skips the
// writes.
fn fx_scratch() -> Word { 32768 }

// A second scratch window, for `STRUCT_AUX` records during a pass that is not
// emitting them. Separate from `fx_scratch` so a counting run cannot have its
// throwaway `CONSTS` records overwritten by its own throwaway aux records.
fn fx_scratch_aux() -> Word { 40960 }

// A third scratch window, for `ENUM_AUX` when it is not being emitted.
fn fx_scratch_eaux() -> Word { 49152 }

// Seed the interner with the prefix, leaving it ready for the walk.
fn fx_seed() -> Word {
    fl.saux = 0;
    fl.eaux = 0;
    nm.ocur = 0;
    nm.cnt = 0;
    nm.err = 0;
    nm.sink = nm_offsets(wire.warg);
    nm.err = if nm.icur > bin_capacity() { 0 - 232 } else { nm.err };
    for j in 0..wire.warg2 limit 256 {
        nm.sink = if nm.err < 0 { 0 } else { nm_intern_at(j) };
    }
    nm.err
}

fn fx_prep() -> Word {
    if wire.warg > nm_max_names() { 0 - 250 } else {
    if wire.warg2 > wire.warg { 0 - 251 } else {
    if wire.warg4 > fl_max_nodes() { 0 - 240 } else {
    if wire.warg3 > wire.warg4 { 0 - 246 } else {
    if fx_validate(wire.warg4) < 0 { fl.err } else {
    if fl_size_all(wire.warg4) < 0 { fl.err } else {
    if fl_cover(wire.warg3, wire.warg4) < 0 { 0 - 248 } else {
        fx_seed() } } } } } } }
}

// Validate, seed, and walk, writing `CONSTS` at `at`.
//
// THE SCRATCH PASS MUST NOT LAND INSIDE THE ARTIFACT. `fx_emit_names` and
// `fx_emit_pool` run a counting walk at `fx_scratch()` while an artifact is
// already seeded in `wire.bytes`, so its throwaway `CONSTS` records would
// overwrite live bytes the moment an artifact reached 32768. Today's are about a
// kilobyte, which is exactly why this needs a guard rather than an assumption:
// a hazard that cannot fire on the current corpus is one that ships. `wire.len`
// is the seeded length, so the check is available and cheap.
//
// Found by reading the code back, not by a failing test — the third defect this
// arc that a green suite could not have surfaced.
fn fx_run(at: Word) -> Word {
    // UNCONDITIONAL, not keyed on `at`. Every run writes SOMETHING to a scratch
    // window — `CONSTS` when counting, `STRUCT_AUX` when not emitting it — so a
    // guard that only fired for one of them would leave the other exposed. The
    // first version keyed on `at == fx_scratch()` and did exactly that.
    fl.rc = if wire.len > fx_scratch() { 0 - 252 } else { fx_prep() };
    if fl.rc < 0 { fl.rc } else { fl_walk(at, wire.warg3, wire.warg4) }
}

// The three figures the host must relay back before the directory can be laid.
// Deterministic re-runs of one function, not three answers to one question.
fn fx_names() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else { nm.cnt }
}

// How many `STRUCT_AUX` records the walk produces. A fourth figure the host
// relays back before the directory can be laid.
fn fx_saux_count() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else { fl.saux }
}

fn fx_emit_saux() -> Word {
    if dir_find(kind_struct_aux()) < 0 { 0 - 253 } else {
        fl.sauxat = region_base(dir_find(kind_struct_aux()));
        fl.eauxat = fx_scratch_eaux();
        fl.rc = fx_run(fx_scratch());
        if fl.rc < 0 { fl.rc } else { fl.saux * structaux_stride() } }
}

fn fx_poollen() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else { nm.ocur }
}

fn fx_emit_consts() -> Word {
    if dir_find(kind_consts()) < 0 { 0 - 247 } else {
        fl.sauxat = fx_scratch_aux();
        fl.eauxat = fx_scratch_eaux();
        fx_run(region_base(dir_find(kind_consts()))) }
}

fn fx_emit_names() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else {
    if dir_find(kind_names()) < 0 { 0 - 233 } else {
        emit_name_records_from_nout(region_base(dir_find(kind_names())), nm.cnt) } }
}

fn fx_emit_pool() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else {
    if dir_find(kind_string_pool()) < 0 { 0 - 234 } else {
        emit_pool_bytes_from_bout(region_base(dir_find(kind_string_pool())), nm.ocur)
            + emit_pool_pad(region_base(dir_find(kind_string_pool())) + nm.ocur, nm.ocur) } }
}

fn fx_eaux_count() -> Word {
    fl.sauxat = fx_scratch_aux();
    fl.eauxat = fx_scratch_eaux();
    fl.rc = fx_run(fx_scratch());
    if fl.rc < 0 { fl.rc } else { fl.eaux }
}

fn fx_emit_eaux() -> Word {
    if dir_find(kind_enum_aux()) < 0 { 0 - 254 } else {
        fl.sauxat = fx_scratch_aux();
        fl.eauxat = region_base(dir_find(kind_enum_aux()));
        fl.rc = fx_run(fx_scratch());
        if fl.rc < 0 { fl.rc } else { fl.eaux * enumaux_stride() } }
}

// --- SLICE 14: PER-CHUNK RANGES, THE DRIVER'S THIRD COMPUTED VALUE --------
//
// A chunk record carries three `(first, count)` ranges — its constants, its
// struct templates, its parameter types — and each `first` is an ALLOCATION
// RESULT rather than a property of the chunk. The reference produces them by
// calling `add_constant_pool`, `add_struct_template_pool` and `add_param_types`
// once per chunk in chunk order, each returning the running length before it
// appended (`wire_schema.rs:620`, `:2542-2544`). So each `first` is a running
// total over the preceding chunks' counts, and the three accumulate
// independently.
//
// The host therefore supplies COUNTS and the driver computes the OFFSETS. That
// is the whole of the slice, and it is the smallest of the driver's remaining
// obligations — but it is also the one that turns a chunk record from something
// transcribed into something derived.
//
// Eleven input words per chunk rather than fourteen: the three `first` fields
// are exactly what is no longer passed in.

fn ck_fields() -> Word { 11 }

// `wire.fin` is 1024 words, so eleven per chunk is 93. A STATED cap of 90,
// refused with a code rather than truncated. Real stages have far more chunks
// than this and will need the batching slice 3's emitter already uses; the
// constructed cases here have one to three.
fn ck_max() -> Word { 90 }

fn ck_in(j: Word, f: Word) -> Word { wire.fin[(j * ck_fields()) + f] }

// Running totals, one per range. Three fields rather than one reused, because
// they advance independently and sharing would couple them silently.
private data ck {
    consts: Word,
    templates: Word,
    ptypes: Word,
    // The REGION-relative record index, `first + i`. A separate field rather than
    // recomputing the sum at each of the fourteen writes, so the batch offset is
    // applied in exactly one place.
    j: Word,
    sink: Word,
}

// SLICE 16: the same emitter, over a BATCH.
//
// `wire.fin` is 1024 words and a chunk costs eleven, so 93 records fill it and a
// real stage has more -- `parse` has 94, which is the smallest count in the whole
// corpus that cannot be emitted in one call. That is why batching is built here
// rather than inside `NAMES`, where the same mechanism would first be exercised
// across 774 batches with nothing legible to read when it went wrong.
//
// THE THREE RUNNING TOTALS ARE THE WHOLE DIFFICULTY, and they are the reason this
// is not simply "call it twice". A chunk's `consts_first` is where the previous
// chunk's range ended, counted from the FIRST chunk of the region rather than of
// the batch. Shared data is re-seeded on every call, so nothing survives from one
// batch to the next: the carry has to come in as an argument and go out as an
// answer the host can relay. A batch that restarted its accumulators at zero
// would emit a structurally valid region in which every range after the first
// batch points at the wrong place.
//
// `first` is a RECORD index, not a byte offset, so the caller does not have to
// know the stride. Record `j` of this batch is record `first + j` of the region.
fn emit_chunks_batch(at: Word, n: Word, first: Word, c0: Word, t0: Word, p0: Word) -> Word {
    if n > ck_max() { 0 - 260 } else {
        ck.consts = c0;
        ck.templates = t0;
        ck.ptypes = p0;
        for i in 0..n limit 90 {
            ck.j = first + i;
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_name(), ck_in(i, 0));
            // Each `first` is written BEFORE its accumulator advances: a chunk's
            // range starts where the previous chunk's ended.
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_consts_first(), ck.consts);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_consts_count(), ck_in(i, 1));
            ck.consts = ck.consts + ck_in(i, 1);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_templates_first(), ck.templates);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_templates_count(), ck_in(i, 2));
            ck.templates = ck.templates + ck_in(i, 2);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_param_types_first(), ck.ptypes);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_param_types_count(), ck_in(i, 3));
            ck.ptypes = ck.ptypes + ck_in(i, 3);
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_debug_first(), ck_in(i, 4));
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_debug_len(), ck_in(i, 5));
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_op_byte_offset(), ck_in(i, 6));
            put_u32(at + (ck.j * chunk_stride()) + chunk_off_op_record_count(), ck_in(i, 7));
            put_u16(at + (ck.j * chunk_stride()) + chunk_off_local_count(), ck_in(i, 8));
            put_u8(at + (ck.j * chunk_stride()) + chunk_off_param_count(), ck_in(i, 9));
            put_u8(at + (ck.j * chunk_stride()) + chunk_off_block_type(), ck_in(i, 10));
        }
        n * chunk_stride()
    }
}

// The single-batch case, unchanged in meaning: start at record zero with every
// accumulator at zero. Kept as its own name so slice 14's callers and tests are
// untouched by the batching that wraps them.
fn emit_chunks_computed(at: Word, n: Word) -> Word {
    emit_chunks_batch(at, n, 0, 0, 0, 0)
}

fn ck_emit() -> Word {
    if dir_find(kind_chunks()) < 0 { 0 - 261 } else {
        emit_chunks_computed(region_base(dir_find(kind_chunks())), wire.warg) }
}

// One batch, positioned by `first` and seeded by the three carries.
fn ck_emit_batch() -> Word {
    if dir_find(kind_chunks()) < 0 { 0 - 261 } else {
        emit_chunks_batch(region_base(dir_find(kind_chunks())), wire.warg, wire.warg2,
                          wire.warg3, wire.warg4, wire.warg5) }
}

// SLICE 17: the same batch, emitted into a LOW WINDOW.
//
// `ck_emit_batch` positions records at `region_base(i) + rec * stride`, an
// ABSOLUTE artifact offset, and `wire.bytes` is 65,536. Measured 2026-08-11, that
// works for no real stage: `verify_datalayout` is the smallest of the ten and its
// `NAMES` region starts at byte 81,160, while `verify_yield` has `CHUNKS` at
// 143,096. Absolute positioning holds for artifacts under 65,536 bytes, which is
// the constructed corpus and nothing else.
//
// So the driver writes the batch at a caller-chosen offset and the host places
// the result at the true one, patching the directory afterwards. The buffer stops
// being a picture of the artifact and becomes a window onto one region of it.
//
// **THE WINDOW BASE MAKES THE FIRST-RECORD INDEX REDUNDANT**, which is worth
// stating because the plan asked for both and this file's own handoff went as far
// as recording that a sixth argument slot would be needed. It is not. `first`
// existed only to position a record inside the region; once the host places the
// window, the driver writes records `0..n` and the host adds
// `region_base + first * stride` itself. The carries still come in explicitly,
// because they are cross-batch STATE rather than position. Five arguments, and
// the argument vector does not have to grow.
fn ck_window_capacity() -> Word { 65536 }

fn ck_emit_window() -> Word {
    // THE RECORD-COUNT CHECK COMES FIRST, AND THE ORDER IS LOAD-BEARING. The
    // window bound below multiplies `n` by the stride, so an absurd `n` would be
    // multiplied before anything had rejected it. `emit_chunks_batch` does refuse
    // `n > ck_max()`, but it does so AFTER this function has already computed that
    // product. Checking the count here keeps the multiplication inside a range the
    // cap has already bounded, rather than relying on how a Word behaves when the
    // product leaves it.
    if wire.warg > ck_max() { 0 - 260 } else {
    if wire.warg5 < 0 { 0 - 262 } else {
    // Checked before any write, not after: the emitter would otherwise index off
    // the end of `wire.bytes` while computing the offset that proves it should
    // not have.
    if wire.warg5 + (wire.warg * chunk_stride()) > ck_window_capacity() { 0 - 263 } else {
        emit_chunks_batch(wire.warg5, wire.warg, 0, wire.warg2, wire.warg3, wire.warg4) } } }
}

// The window form's carries. Separate from the region form's because the two read
// their arguments in different positions -- `ck_emit_batch` takes `first` where
// this takes the first carry -- and a shared body would silently read one as the
// other.
fn ck_window_consts() -> Word {
    ck.sink = ck_emit_window();
    if ck.sink < 0 { ck.sink } else { ck.consts }
}

fn ck_window_templates() -> Word {
    ck.sink = ck_emit_window();
    if ck.sink < 0 { ck.sink } else { ck.templates }
}

fn ck_window_ptypes() -> Word {
    ck.sink = ck_emit_window();
    if ck.sink < 0 { ck.sink } else { ck.ptypes }
}

// The carry OUT of the same batch, one command per accumulator.
//
// Three commands rather than one returning a triple, and a re-run rather than
// retained state, both for the reason `intern_pool_len` gives: a call returns one
// word, and shared data is re-seeded on the next call, so the emitter's totals
// cannot persist for the host to read. Re-running is not a second answer to the
// same question -- the emitter is a pure function of its input and carries.
//
// The host must NOT compute these by summing the counts it passed in. That is the
// accumulation this slice exists to move onto the Keleusma side, and a host that
// did it would leave the batched path testing nothing the single-batch path did
// not already cover.
fn ck_carry_consts() -> Word {
    ck.sink = ck_emit_batch();
    if ck.sink < 0 { ck.sink } else { ck.consts }
}

fn ck_carry_templates() -> Word {
    ck.sink = ck_emit_batch();
    if ck.sink < 0 { ck.sink } else { ck.templates }
}

fn ck_carry_ptypes() -> Word {
    ck.sink = ck_emit_batch();
    if ck.sink < 0 { ck.sink } else { ck.ptypes }
}

// ---------------------------------------------------------------------------
// SLICE 15: the interning SEQUENCE, derived from a module description.
// ---------------------------------------------------------------------------
//
// The fifth and last value the driver owed. Every slice before this consumed a
// (name, mode) sequence that a Rust helper had already put into the encoder's
// order; here Keleusma is handed the module's names GROUPED BY KIND and works
// that order out itself.
//
// THE INPUT IS IN DECLARATION ORDER AND THE OUTPUT IS IN INTERNING ORDER, which
// is the whole of the derivation and the reason a name's sequence position and
// its pool offset come apart. `bin` holds every layout's names first -- type
// name then its variants, per layout -- and the chunk names last. The encoder
// interns the other way round: chunk names first, then each layout's type name
// and variants. `nm_intern_at` reads a name's offset from `nout`, so this slice
// writes those offsets directly rather than letting `nm_offsets` recompute them
// as a prefix sum over `nin`, which assumes the two orders agree.
//
// IT IS A ROTATION, NOT A GENERAL PERMUTATION, and saying so is more useful than
// letting the surrounding prose imply otherwise: interning position `m` is chunk
// `m` while `m < nc`, and layout name `m - nc` after that. What it is not is the
// IDENTITY, which is what a same-order input encoding would have reduced it to,
// and that is the reason the input is grouped this way rather than pre-ordered.
//
// The MODE column is the other half and is the part with teeth. A layout's type
// name dedups and its variants do not, so a port that used one mode throughout
// produces a name count the reference does not -- pinned already by the
// dedup-only and append-only must-fire tests, which this slice reuses.

fn sq_max_layouts() -> Word { 64 }

fn sq_max_chunks() -> Word { 128 }

// Bounds the INNER loop of the build pass. A count above this would trap on
// `for v in 0..count limit 64` rather than report, so it is validated in the
// scan pass before any of it is used as a bound.
fn sq_max_variants() -> Word { 64 }

// `wire.fin` is 1024 words and a layout record is VARIABLE LENGTH, so the caps
// above do not bound the input on their own: 64 layouts of 64 variants each
// would want 4,224 words. The scan pass therefore checks the cursor against this
// on every step rather than deriving safety from the caps.
fn sq_fin_capacity() -> Word { 1024 }

private data sq {
    nl: Word,
    nc: Word,
    err: Word,
    cur: Word,
    lnames: Word,
    boff: Word,
    k: Word,
    sink: Word,
}

// Validate the description and count the names the layouts contribute.
//
// A separate pass from the build because every bound the build uses is checked
// here first. `for v in 0..n limit 64` TRAPS when the runtime range exceeds the
// cap, so a malformed variant count has to be refused before it reaches a loop
// header; a sticky flag set inside the build would be set too late to help.
fn sq_scan() -> Word {
    sq.cur = 2;
    sq.lnames = 0;
    sq.err = 0;
    for j in 0..sq.nl limit 64 {
        // Bounds-check the cursor BEFORE dereferencing it. The read below sits
        // in the `else` arm so it is not evaluated when the guard has fired.
        sq.err = if sq.cur + 1 >= sq_fin_capacity() { 0 - 272 } else { sq.err };
        sq.err = if sq.err < 0 { sq.err } else {
                 if wire.fin[sq.cur + 1] > sq_max_variants() { 0 - 273 } else { sq.err } };
        sq.lnames = if sq.err < 0 { sq.lnames } else { sq.lnames + 1 + wire.fin[sq.cur + 1] };
        sq.cur = if sq.err < 0 { sq.cur } else { sq.cur + 2 + wire.fin[sq.cur + 1] };
    }
    // The chunk-length block follows the layouts, so the cursor must still be
    // addressable after every layout has been walked.
    sq.err = if sq.cur + sq.nc > sq_fin_capacity() { 0 - 272 } else { sq.err };
    if sq.err < 0 { sq.err } else { sq.lnames }
}

// Write one name's length, mode and pool offset at interning position `m`.
//
// The offset is the DECLARATION-order running total, which is why it is passed
// rather than derived: the caller advances it in input order while writing to
// output-order slots, and folding the two together is exactly the confusion this
// slice exists to keep straight.
fn sq_put(m: Word, len: Word, mode: Word) -> Word {
    wire.nin[m * 2] = len;
    wire.nin[(m * 2) + 1] = mode;
    wire.nout[nm_off_base() + m] = sq.boff;
    sq.boff = sq.boff + len;
    sq.err = if len > nm_max_name() { 0 - 231 } else { sq.err };
    m + 1
}

// Emit the sequence: layouts into the slots ABOVE the chunks, chunks below.
//
// The loops run in DECLARATION order so `sq.boff` accumulates correctly, while
// each write lands at its INTERNING-order index. Writing the chunk block second
// is therefore not a stylistic choice: its pool offsets start after every layout
// name, and running it first would give every name the wrong offset while
// leaving the lengths and modes right -- a failure that reads as corrupt pool
// bytes rather than as a wrong count.
fn sq_build() -> Word {
    sq.boff = 0;
    sq.cur = 2;
    sq.k = 0;
    for j in 0..sq.nl limit 64 {
        sq.sink = sq_put(sq.nc + sq.k, wire.fin[sq.cur], 0);
        sq.k = sq.k + 1;
        for v in 0..wire.fin[sq.cur + 1] limit 64 {
            sq.sink = sq_put(sq.nc + sq.k, wire.fin[sq.cur + 2 + v], 1);
            sq.k = sq.k + 1;
        }
        sq.cur = sq.cur + 2 + wire.fin[sq.cur + 1];
    }
    for c in 0..sq.nc limit 128 {
        sq.sink = sq_put(c, wire.fin[sq.cur + c], 0);
    }
    sq.nc + sq.k
}

// Intern the built sequence.
//
// A near-twin of `intern_run` with ONE difference that is the reason it is not
// that function: it does not call `nm_offsets`. That helper recomputes every
// offset as a prefix sum over `nin`, which is correct only while the input and
// interning orders agree -- precisely the assumption this slice breaks. It also
// carried the per-name length check, which `sq_put` now performs instead.
fn sq_run(n: Word) -> Word {
    nm.ocur = 0;
    nm.cnt = 0;
    nm.err = sq.err;
    nm.err = if sq.boff > bin_capacity() { 0 - 232 } else { nm.err };
    for j in 0..n limit 256 {
        nm.sink = if nm.err < 0 { 0 } else { nm_intern_at(j) };
    }
    if nm.err < 0 { nm.err } else { nm.cnt }
}

// Read the counts, validate, build and intern. Every entry point runs the whole
// thing because shared data is re-seeded on every call, so no state survives to
// be reused.
fn sq_names() -> Word {
    if wire.fin[0] > sq_max_layouts() { 0 - 270 } else {
    if wire.fin[1] > sq_max_chunks() { 0 - 271 } else {
        sq.nl = wire.fin[0];
        sq.nc = wire.fin[1];
        sq.sink = sq_scan();
        if sq.sink < 0 { sq.sink } else {
        if sq.lnames + sq.nc > nm_max_names() { 0 - 274 } else {
            sq.sink = sq_build();
            sq_run(sq.sink) } } } }
}

fn sq_poollen() -> Word {
    sq.sink = sq_names();
    if sq.sink < 0 { sq.sink } else { nm.ocur }
}

fn sq_emit_names() -> Word {
    sq.sink = sq_names();
    if sq.sink < 0 { sq.sink } else {
    if dir_find(kind_names()) < 0 { 0 - 275 } else {
        emit_name_records_from_nout(region_base(dir_find(kind_names())), nm.cnt) } }
}

fn sq_emit_pool() -> Word {
    sq.sink = sq_names();
    if sq.sink < 0 { sq.sink } else {
    if dir_find(kind_string_pool()) < 0 { 0 - 276 } else {
        emit_pool_bytes_from_bout(region_base(dir_find(kind_string_pool())), nm.ocur) } }
}

// A SECOND driver chain rather than four more arms on the first, and the reason
// is measured rather than stylistic.
//
// `MAX_PARSE_DEPTH` is 24 and it is a budget SHARED between a chain's position
// and the nesting of whatever its arms call -- it is not an arm count. Measured
// against this chain in the test harness, which is the binding context because
// that is where this file is compiled: 20 arms with a no-argument body, 19 with
// one like `emit_in_region(wire.warg, wire.warg2)`, 18 with a nested call.
// `dispatch_driver` stands at 18, so four more arms would overrun it.
//
// Exceeding it in the harness is a STACK OVERFLOW and SIGABRT, not a parse
// error: a 2 MB test thread blows before the depth guard can report. Through the
// CLI the same source is rejected cleanly at 23 arms, so a chain sized from a CLI
// reading runs two to three arms too generous.
fn dispatch_driver2(cmd: Word) -> Word {
    if cmd == 152 { sq_names() } else {
    if cmd == 153 { sq_poollen() } else {
    if cmd == 154 { sq_emit_names() } else {
    if cmd == 155 { sq_emit_pool() } else {
    if cmd == 156 { ck_emit_batch() } else {
    if cmd == 157 { ck_carry_consts() } else {
    if cmd == 158 { ck_carry_templates() } else {
    if cmd == 159 { ck_carry_ptypes() } else {
    if cmd == 160 { ck_emit_window() } else {
    if cmd == 161 { ck_window_consts() } else {
    if cmd == 162 { ck_window_templates() } else {
    if cmd == 163 { ck_window_ptypes() } else {
    if cmd == 164 { emit_in_window() } else {
    0 - 98 }}}}}}}}}}}}}
}

fn dispatch_driver(cmd: Word) -> Word {
    if cmd == 134 { build_region_table(wire.nregions) } else {
    if cmd == 135 { emit_in_region(wire.warg, wire.warg2) } else {
    if cmd == 136 { intern_names(wire.warg) } else {
    if cmd == 137 { intern_pool_len(wire.warg) } else {
    if cmd == 138 { intern_emit_names(wire.warg) } else {
    if cmd == 139 { intern_emit_pool(wire.warg) } else {
    if cmd == 140 { intern_index_of(wire.warg, wire.warg2) } else {
    if cmd == 141 { flatten_emit_consts(wire.warg, wire.warg2) } else {
    if cmd == 142 { fx_names() } else {
    if cmd == 143 { fx_poollen() } else {
    if cmd == 144 { fx_emit_consts() } else {
    if cmd == 145 { fx_emit_names() } else {
    if cmd == 146 { fx_emit_pool() } else {
    if cmd == 147 { fx_saux_count() } else {
    if cmd == 148 { fx_emit_saux() } else {
    if cmd == 149 { fx_eaux_count() } else {
    if cmd == 150 { fx_emit_eaux() } else {
    if cmd == 151 { ck_emit() } else {
    0 - 97 }}}}}}}}}}}}}}}}}}
}

// THE HIGHEST LIVE COMMAND, AND IT IS LOAD-BEARING RATHER THAN DOCUMENTATION.
// `main` refuses anything above it, so a command added past this number is
// UNREACHABLE and its own test fails immediately. The fall-through sweep reads
// this value out of the source instead of restating a bound, which is what it
// did for four consecutive slices — and got wrong once.
fn highest_command() -> Word { 164 }

fn main(cmd: Word) -> Word {
    if cmd < 13 { dispatch_container(cmd) } else {
    if cmd < 26 { dispatch_schema(cmd) } else {
    if cmd < 38 { dispatch_consts(cmd) } else {
    if cmd < 55 { dispatch_runs(cmd) } else {
    if cmd < 69 { dispatch_data(cmd) } else {
    if cmd < 84 { dispatch_module(cmd) } else {
    if cmd < 92 { dispatch_ops(cmd) } else {
    if cmd < 103 { dispatch_pool(cmd) } else {
    if cmd > highest_command() { 0 - 99 } else {
    if cmd < 115 { dispatch_frame(cmd) } else {
    if cmd < 134 { dispatch_emit(cmd) } else {
    if cmd < 152 { dispatch_driver(cmd) } else { dispatch_driver2(cmd) } } } } } } } } } } } }
}
