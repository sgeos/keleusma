// src/selfhost/kel/wire.kel — the wire format, written in Keleusma.
//
// Step 6 of the six-step wire-format programme: the format the Rust runtime
// reads and writes must also be producible by the self-hosted compiler, so the
// emitted artifact is made end to end by the Keleusma-written path. The plan and
// its slices are in docs/decisions/WIRE_FORMAT_SELFHOST_PLAN.md; the format
// itself is specified in docs/spec/WIRE_FORMAT.md.
//
// SLICE 1 (this file, so far): CRC-32/ISO-HDLC. A pure function over a byte
// range, computed bitwise with no lookup table, so it needs no data-dependent
// load and eight fixed iterations per byte. It is deliberately the smallest
// slice: its job is to establish the byte-buffer harness every later slice
// reuses, not to be interesting on its own. Later slices add the container
// primitives and prologue, the region directory, record tables and byte pools,
// the schema layer, the opcode stream, and the framing header.
//
// This file is NOT yet a pipeline stage. `src/selfhost/mod.rs`'s `read_stage`
// deliberately does not list it, because the self-hosted compile driver does not
// run it; `tests/selfhost_wire.rs` compiles it directly. It moves into the
// driver when it emits an artifact rather than a checksum.

// WORD WIDTH. This is `>= 64`, not the `>= 32` every pipeline stage declares, and
// the difference is load-bearing rather than cautious. The accumulator holds a
// 32-bit unsigned value in a SIGNED word, so a 32-bit word cannot represent it:
// both the initial value and the polynomial exceed the positive range of a signed
// 32-bit integer. Nothing else catches this. A source carrying those literals
// compiles for a 32-bit target without complaint when no `require` is present,
// which was verified against the reference rather than assumed, so the guard has
// to be written here or the miscompile is silent.
require word >= 64;

// The artifact buffer, used both as the input a checksum runs over and as the
// output the emitters write into. The host fills or reads `bytes`, sets the
// inputs, and drives `main` with a command.
//
// `len` may be shorter than the array; a `len` LONGER than the array does not
// read out of bounds, because the loop's `limit` caps iteration at the array size
// and the overrun then traps as `LoopLimitExceeded` rather than truncating
// silently.
//
// SLOT ORDER MATTERS TO THE HOST. `set_shared` addresses slots, not byte
// offsets, so `len` is slot 0 and `bytes[i]` is slot `1 + i`. New scalars are
// appended AFTER the array so that mapping does not shift; `lexer.kel` orders its
// shared block the same way and for the same reason.
//
// The capacity is 65536, which clears the header area at the format's 1024-region
// ceiling (48 + 48 * 1024 = 49200 bytes) with room for a small payload. The
// shared segment's own ceiling is 16 MB, so this is not close to a limit.
shared data wire {
    len: Word,
    bytes: [Byte; 65536],
    nregions: Word,
    // Per-region inputs to the directory emitter, indexed 0..nregions. `rlen` is
    // the payload length in BYTES; the emitter converts to words. `rcovers` is
    // meaningful only for a parity plane and is zero otherwise.
    rkind: [Word; 1024],
    rflags: [Word; 1024],
    rlen: [Word; 1024],
    rcovers: [Word; 1024],
    // General arguments for commands that take them: a region index, a kind to
    // look up, a record stride, a record index, a field offset. Appended last so
    // no existing slot index moves.
    warg: Word,
    warg2: Word,
    warg3: Word,
    warg4: Word,
}

// The running checksum. It lives in a data block because locals are immutable:
// `a = a bxor b` on a local is rejected outright with "assignment is only
// supported for data block fields", so an accumulator has nowhere else to live.
// The consequence for callers is that the checksum is STATEFUL — `crc_begin`
// must run before each independent message.
private data crc {
    acc: Word,
}

// Scratch for the disagreement scan, which needs an accumulator across loop
// iterations for the same reason the checksum does.
private data st {
    dis: Word,
    // The running word cursor while emitting the directory. A local cannot carry
    // it across iterations, for the same reason the checksum accumulator cannot.
    cur: Word,
}

// THE RANGE INVARIANT, which is why no masking appears below.
//
// `acc` is always in [0, 2^32). It starts at 2^32 - 1; folding a byte xors in a
// value under 256; a logical shift right by one leaves it under 2^31; and xoring
// the polynomial, itself under 2^32, keeps it under 2^32. So the emulated
// unsigned-32 arithmetic never needs a `band` against a 32-bit mask, and adding
// one would be dead work rather than a safety net.
//
// The invariant is what makes the shift choice non-load-bearing: `acc` is never
// negative, so `asr` would compute the same values as `lsr` here. `lsr` is still
// the correct spelling, because it is the operation the algorithm calls for and
// it stays correct if the invariant is ever weakened. A test pins the equivalence
// so that a reader who notices it finds it recorded as deliberate.

// Begin a new message. Returns the seeded accumulator so the function has a
// useful value rather than a placeholder.
fn crc_begin() -> Word {
    crc.acc = 0xFFFFFFFF;
    crc.acc
}

// Fold one byte into the running checksum and return the new accumulator.
// `byte` is expected in [0, 255]; a wider value simply xors more bits in, which
// is the caller's error rather than a fault here.
//
// The eight-iteration inner loop is a fixed range, so it needs no `limit` and
// contributes a constant factor to the worst-case bound.
fn crc_fold(byte: Word) -> Word {
    crc.acc = crc.acc bxor byte;
    for j in 0..8 {
        crc.acc = if (crc.acc band 1) == 1 {
            (crc.acc lsr 1) bxor 0xEDB88320
        } else {
            crc.acc lsr 1
        };
    }
    crc.acc
}

// Finish a message. The final complement is separate from `crc_fold` so an
// incremental producer can keep folding bytes and take the checksum only at the
// end, which is the shape the region emitters in later slices need.
fn crc_end() -> Word {
    crc.acc bxor 0xFFFFFFFF
}

// Checksum `wire.bytes[at .. at + n]`.
//
// The `limit` equals the array capacity, so the loop is statically bounded at
// 65536 iterations of eight inner steps. An `n` beyond the capacity overruns the
// cap and traps, which is the fail-loud default and is preferable to checksumming
// a silently truncated prefix.
fn crc_range(at: Word, n: Word) -> Word {
    crc_begin();
    for i in 0..n limit 65536 {
        crc_fold(wire.bytes[at + i] as Word);
    }
    crc_end()
}

// SLICE 2: container primitives, the prologue, and the majority-of-three vote.
//
// The container layout is specified in docs/spec/WIRE_FORMAT.md and implemented
// by `keleusma-wire`. The prologue is 16 bytes held in three copies at the fixed
// offsets 0, 16 and 32:
//
//   0  u32  magic, 0x4B415558, which is "KAUX" read little-endian
//   4  u16  byte-order marker, 0xFEFF
//   6  u16  format version, 2
//   8  u16  region count
//   10 u16  flags, currently zero
//   12 u32  CRC-32 of bytes 0..12
//
// The copies sit at fixed offsets BY DEFINITION rather than at offsets derived
// from a field, which is what makes them votable with no prior knowledge. A
// directory placed inside the voted block would make locating the copies depend
// on `region_count`, a field inside the block those copies exist to repair.

// --- Little-endian place-value writers -----------------------------------
//
// `as Byte` TRUNCATES silently rather than faulting: `300 as Byte` is 44. The
// explicit `band 255` is therefore not redundant with the cast. It states the
// intent at the point the byte is formed, so a value that does not fit is
// narrowed where a reader can see it rather than at an implicit conversion.

fn put_u16(at: Word, v: Word) -> Word {
    wire.bytes[at] = (v band 255) as Byte;
    wire.bytes[at + 1] = ((v lsr 8) band 255) as Byte;
    at + 2
}

fn put_u32(at: Word, v: Word) -> Word {
    wire.bytes[at] = (v band 255) as Byte;
    wire.bytes[at + 1] = ((v lsr 8) band 255) as Byte;
    wire.bytes[at + 2] = ((v lsr 16) band 255) as Byte;
    wire.bytes[at + 3] = ((v lsr 24) band 255) as Byte;
    at + 4
}

// --- Little-endian place-value readers -----------------------------------
//
// `Byte as Word` zero-extends, so no masking is needed on the way in either.

fn get_u16(at: Word) -> Word {
    (wire.bytes[at] as Word) + ((wire.bytes[at + 1] as Word) lsl 8)
}

fn get_u32(at: Word) -> Word {
    (wire.bytes[at] as Word)
        + ((wire.bytes[at + 1] as Word) lsl 8)
        + ((wire.bytes[at + 2] as Word) lsl 16)
        + ((wire.bytes[at + 3] as Word) lsl 24)
}

// --- Emission ------------------------------------------------------------

// Write the three prologue copies for `n` regions and return the number of bytes
// written. The checksum covers the first twelve bytes of the record, so it is
// computed after those fields are in place and before the record is replicated.
fn emit_prologue(n: Word) -> Word {
    put_u32(0, 0x4B415558);
    put_u16(4, 0xFEFF);
    put_u16(6, 2);
    put_u16(8, n);
    put_u16(10, 0);
    put_u32(12, crc_range(0, 12));
    for i in 0..16 {
        wire.bytes[16 + i] = wire.bytes[i];
        wire.bytes[32 + i] = wire.bytes[i];
    }
    48
}

// --- The majority-of-three vote ------------------------------------------

// Per-BIT majority, which is what the reference computes. It is not "pick the
// value that appears at least twice": where all three copies differ, this
// synthesises a byte from the per-bit majorities, which is the stronger result
// because independent single-bit faults in different copies are all repaired.
fn maj3(a: Word, b: Word, c: Word) -> Word {
    ((a band b) bor (a band c)) bor (b band c)
}

// One voted byte of prologue copy-space.
fn voted_byte(i: Word) -> Word {
    maj3(
        wire.bytes[i] as Word,
        wire.bytes[16 + i] as Word,
        wire.bytes[32 + i] as Word,
    )
}

fn voted_u16(at: Word) -> Word {
    voted_byte(at) + (voted_byte(at + 1) lsl 8)
}

fn voted_u32(at: Word) -> Word {
    voted_byte(at)
        + (voted_byte(at + 1) lsl 8)
        + (voted_byte(at + 2) lsl 16)
        + (voted_byte(at + 3) lsl 24)
}

// Checksum the first `n` VOTED bytes.
//
// This is deliberately not `crc_range`, and the difference is load-bearing. The
// reference checks the prologue's CRC against the voted record, so a vote that
// repaired a byte is confirmed rather than merely trusted. Checksumming the raw
// first copy would reject an artifact the vote had already fixed.
fn crc_voted(n: Word) -> Word {
    crc_begin();
    for i in 0..n limit 16 {
        crc_fold(voted_byte(i));
    }
    crc_end()
}

// 1 when `a` and `b` differ, 0 otherwise. Used instead of a bare `if` statement
// so the disagreement scan is straight-line arithmetic with no branching.
fn neq(a: Word, b: Word) -> Word {
    if a == b { 0 } else { 1 }
}

// 1 when any prologue copy disagrees with the vote.
//
// The artifact still reads correctly, which is what the vote is for, but it has
// taken damage and the margin that lets the NEXT fault also be survivable is
// gone. Unreported damage accumulates silently until a second fault in the same
// position defeats the vote, so this is a scrub trigger rather than a failure.
fn prologue_disagreed() -> Word {
    st.dis = 0;
    for i in 0..16 {
        st.dis = st.dis
            bor neq(wire.bytes[i] as Word, voted_byte(i))
            bor neq(wire.bytes[16 + i] as Word, voted_byte(i))
            bor neq(wire.bytes[32 + i] as Word, voted_byte(i));
    }
    st.dis
}

// Validate the voted prologue and return the region count, or a negative code.
//
// The checks and their ORDER follow the reference exactly, because the code a
// caller sees for a doubly-malformed artifact is part of the observable
// behaviour: magic, then byte order, then version, then the checksum, then the
// region ceiling.
//
//   -1  bad magic
//   -2  foreign byte order
//   -3  unsupported version
//   -4  bad prologue checksum
//   -5  region count above the format ceiling of 1024
fn parse_prologue() -> Word {
    if voted_u32(0) != 0x4B415558 { 0 - 1 } else {
    if voted_u16(4) != 0xFEFF { 0 - 2 } else {
    if voted_u16(6) != 2 { 0 - 3 } else {
    if crc_voted(12) != voted_u32(12) { 0 - 4 } else {
    if voted_u16(8) > 1024 { 0 - 5 } else {
    voted_u16(8) } } } } }
}


// --- SLICE 3: the region directory ----------------------------------------
//
// Three copies of an n-entry table live at byte 48, each entry 16 bytes:
//
//   0  u16  kind          8  u32  word length
//   2  u16  flags        12  u16  covers (parity planes only)
//   4  u32  word offset  14  u16  reserved, zero
//
// THE BOOTSTRAP IS THE PART THAT MATTERS. The directory's stride is
// `region_count * 16`, and `region_count` lives in the prologue. So the
// directory can only be located after the PROLOGUE vote has recovered that
// field. Taking the stride from an unvoted copy would desynchronise the search
// for the very copies that repair it, which is the reason the prologue is a
// separate fixed-size record in the first place.

// Words occupied by the whole header area: three copies of an n-entry directory
// plus the three 16-byte prologues. `48 + 48n` is always a multiple of 8, so
// this is exact and needs no rounding, unlike a payload length.
fn header_words(n: Word) -> Word {
    6 * (n + 1)
}

// Bytes in one directory copy.
fn dir_span() -> Word {
    wire.nregions lsl 4
}

// Payload bytes rounded up to whole words. The rounding is the part a
// transliteration drops: it is correct for a multiple of eight either way, and
// wrong for everything else.
fn words_for(nbytes: Word) -> Word {
    (nbytes + 7) lsr 3
}

// Write the three directory copies and return the header area's byte length.
// Offsets accumulate in emit order, starting past the header, exactly as the
// reference does before it writes a single byte.
fn emit_directory(n: Word) -> Word {
    st.cur = header_words(n);
    for i in 0..n limit 1024 {
        put_u16(48 + (i lsl 4), wire.rkind[i]);
        put_u16(48 + (i lsl 4) + 2, wire.rflags[i]);
        put_u32(48 + (i lsl 4) + 4, st.cur);
        put_u32(48 + (i lsl 4) + 8, words_for(wire.rlen[i]));
        put_u16(48 + (i lsl 4) + 12, wire.rcovers[i]);
        put_u16(48 + (i lsl 4) + 14, 0);
        st.cur = st.cur + words_for(wire.rlen[i]);
    }
    for i in 0..(n lsl 4) limit 16384 {
        wire.bytes[48 + (n lsl 4) + i] = wire.bytes[48 + i];
        wire.bytes[48 + ((n lsl 4) lsl 1) + i] = wire.bytes[48 + i];
    }
    48 + (3 * (n lsl 4))
}

// One voted byte of directory copy-space, at entry `i`, field offset `off`.
fn dir_voted_byte(i: Word, off: Word) -> Word {
    maj3(
        wire.bytes[48 + (i lsl 4) + off] as Word,
        wire.bytes[48 + dir_span() + (i lsl 4) + off] as Word,
        wire.bytes[48 + (dir_span() lsl 1) + (i lsl 4) + off] as Word,
    )
}

fn dir_u16(i: Word, off: Word) -> Word {
    dir_voted_byte(i, off) + (dir_voted_byte(i, off + 1) lsl 8)
}

fn dir_u32(i: Word, off: Word) -> Word {
    dir_voted_byte(i, off)
        + (dir_voted_byte(i, off + 1) lsl 8)
        + (dir_voted_byte(i, off + 2) lsl 16)
        + (dir_voted_byte(i, off + 3) lsl 24)
}

// 1 when any directory copy disagrees with the vote. Same scrub trigger as the
// prologue's, over the whole copy-space rather than one record.
fn directory_disagreed() -> Word {
    st.dis = 0;
    for i in 0..dir_span() limit 16384 {
        st.dis = st.dis
            bor neq(
                wire.bytes[48 + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            )
            bor neq(
                wire.bytes[48 + dir_span() + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            )
            bor neq(
                wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                maj3(
                    wire.bytes[48 + i] as Word,
                    wire.bytes[48 + dir_span() + i] as Word,
                    wire.bytes[48 + (dir_span() lsl 1) + i] as Word,
                ),
            );
    }
    st.dis
}

// Emit the whole header area: the three prologue copies, then the three
// directory copies. One call because the two share a buffer and a caller has no
// reason to want half a header; also the shape a real emitter takes, which fills
// the header before any payload.
fn emit_header() -> Word {
    emit_prologue(wire.nregions);
    emit_directory(wire.nregions)
}

// Index of the first region with `kind`, or 0 - 1 when absent. A linear scan is
// right here: the ceiling is 1024, the container assigns no ordering to kinds,
// and a bounded scan keeps the worst case obvious.
fn dir_find(kind: Word) -> Word {
    st.cur = 0 - 1;
    for i in 0..wire.nregions limit 1024 {
        st.cur = if st.cur == 0 - 1 {
            if dir_u16(i, 0) == kind { i } else { 0 - 1 }
        } else {
            st.cur
        };
    }
    st.cur
}

// --- SLICE 4: record tables and byte pools --------------------------------
//
// A region's payload is either a table of fixed-stride records or a
// byte-addressed pool; the container assigns no meaning beyond that, which is
// what keeps it reusable. Both are located from the VOTED directory, so every
// address here rests on slices 2 and 3 having repaired the header first.
//
// Element `i` of a table is at `base + i * stride`. The format constrains every
// record to a whole number of words specifically so that a stride which is also
// a power of two makes this a shift; the multiply is kept here because the
// container permits any word multiple, and a reader must handle the general
// case rather than the convenient one.

// A region's payload location, in bytes, from the voted directory.
fn region_base(i: Word) -> Word {
    dir_u32(i, 4) lsl 3
}

fn region_bytes(i: Word) -> Word {
    dir_u32(i, 8) lsl 3
}

// A stride is valid when it is non-zero and a whole number of words. Zero is
// rejected first and separately, because the divisibility test below divides by
// it and division by zero TRAPS rather than yielding a sentinel.
fn stride_ok(stride: Word) -> Word {
    if stride != 0 andalso (stride band 7) == 0 { 1 } else { 0 }
}

// Whether `stride` divides `total`. Expressed through division rather than a
// mask because a stride is only required to be a multiple of eight, not a power
// of two, so `band (stride - 1)` would silently give the wrong answer for a
// stride like 24.
fn divides(total: Word, stride: Word) -> Word {
    if (total / stride) * stride == total { 1 } else { 0 }
}

// Records in region `i` at `stride`, or 0 - 1 when the stride is inadmissible.
//
// The guard relies on `andalso` SHORT-CIRCUITING: `divides` divides by `stride`,
// so evaluating it with a zero stride would trap. A test pins the short circuit
// rather than trusting it.
fn rec_count(i: Word, stride: Word) -> Word {
    if stride_ok(stride) == 1 andalso divides(region_bytes(i), stride) == 1 {
        region_bytes(i) / stride
    } else {
        0 - 1
    }
}

// Byte address of field `off` within record `rec` of region `i`.
fn rec_at(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    region_base(i) + (rec * stride) + off
}

fn rec_u8(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    wire.bytes[rec_at(i, stride, rec, off)] as Word
}

fn rec_u16(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    get_u16(rec_at(i, stride, rec, off))
}

fn rec_u32(i: Word, stride: Word, rec: Word, off: Word) -> Word {
    get_u32(rec_at(i, stride, rec, off))
}

fn put_rec_u16(i: Word, stride: Word, rec: Word, off: Word, v: Word) -> Word {
    put_u16(rec_at(i, stride, rec, off), v)
}

fn put_rec_u32(i: Word, stride: Word, rec: Word, off: Word, v: Word) -> Word {
    put_u32(rec_at(i, stride, rec, off), v)
}

// A byte pool is the same region viewed without a stride.
fn pool_u8(i: Word, off: Word) -> Word {
    wire.bytes[region_base(i) + off] as Word
}

// Fill region `i` with `n` two-word records whose fields are a function of the
// record index. The pattern is computed rather than supplied so the emitter can
// be compared byte-for-byte against a reference that computes the same thing,
// which tests the ADDRESSING arithmetic without also testing a data channel.
fn emit_pattern_records(i: Word, n: Word) -> Word {
    for r in 0..n limit 1024 {
        put_rec_u32(i, 16, r, 0, (r * 7) + 1);
        put_rec_u32(i, 16, r, 4, (r * 13) + 2);
        put_rec_u16(i, 16, r, 8, (r band 255) + 3);
        put_rec_u16(i, 16, r, 10, 0);
        put_rec_u32(i, 16, r, 12, 0);
    }
    n
}

// --- SLICE 5: the schema layer -------------------------------------------
//
// Slices 2 to 4 gave a container with no opinions: a prologue, a directory of
// numbered regions, and fixed-stride records inside them. The schema is what
// assigns meaning to those numbers, and it lives HERE rather than in the
// container so the container stays reusable by a project with different
// content. `src/wire_schema.rs` is the Rust side of the same layer.
//
// THE OFFSETS BELOW ARE TRANSCRIBED, NOT DERIVED, AND THAT IS DELIBERATE.
// `#[derive(WireRecord)]` packs fields with NO implicit padding and then rounds
// the stride up to a whole word, which is not what a C layout would give. The
// numbers therefore cannot be recomputed from the field types by eye. A test
// asserts every constant below against the derive's generated `OFFSET_*` and
// `STRIDE`, so a mistranscription fails immediately and a record that later
// gains a field fails then rather than silently reading the wrong bytes.
//
// Slice 5a covers the two records nothing else depends on. 5b to 5e follow, in
// docs/decisions/WIRE_FORMAT_SELFHOST_PLAN.md.

// Region kinds, from `wire_schema::kind`. Numbered from 0x0010 so a zeroed
// directory entry names no real region.
fn kind_string_pool() -> Word { 0x0010 }
fn kind_names() -> Word { 0x0011 }
fn kind_shapes() -> Word { 0x0015 }

// NameRef: a slice of the string pool. offset u32 @0, length u32 @4.
fn nameref_stride() -> Word { 8 }
fn nameref_off_offset() -> Word { 0 }
fn nameref_off_length() -> Word { 4 }

// ShapeRecord: a flat operand shape. tag u16 @0, kind u8 @2, reserved u8 @3,
// size u32 @4. It fits ONE word, which is why shapes need no side table where
// struct and enum constants do.
fn shape_stride() -> Word { 8 }
fn shape_off_tag() -> Word { 0 }
fn shape_off_kind() -> Word { 2 }
fn shape_off_reserved() -> Word { 3 }
fn shape_off_size() -> Word { 4 }

// Resolving a region BY KIND rather than by index is what makes this a schema
// layer. A reader asks for "the names table", not "region 4", so the artifact's
// region ordering is not part of the contract. Absent regions return 0 - 1 from
// `dir_find`, and the accessors below propagate that rather than reading from a
// negative base.
fn name_count() -> Word {
    if dir_find(kind_names()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_names()), nameref_stride())
    }
}

fn name_offset(i: Word) -> Word {
    rec_u32(dir_find(kind_names()), nameref_stride(), i, nameref_off_offset())
}

fn name_length(i: Word) -> Word {
    rec_u32(dir_find(kind_names()), nameref_stride(), i, nameref_off_length())
}

// Byte `j` of name `i`, resolved through the string pool. Two regions and a
// record are consulted to answer it, which is the whole point of the layer.
fn name_byte(i: Word, j: Word) -> Word {
    pool_u8(dir_find(kind_string_pool()), name_offset(i) + j)
}

fn shape_count() -> Word {
    if dir_find(kind_shapes()) == 0 - 1 { 0 } else {
        rec_count(dir_find(kind_shapes()), shape_stride())
    }
}

fn shape_tag(i: Word) -> Word {
    rec_u16(dir_find(kind_shapes()), shape_stride(), i, shape_off_tag())
}

fn shape_kind(i: Word) -> Word {
    rec_u8(dir_find(kind_shapes()), shape_stride(), i, shape_off_kind())
}

fn shape_size(i: Word) -> Word {
    rec_u32(dir_find(kind_shapes()), shape_stride(), i, shape_off_size())
}

// The host drives the module through a one-argument entry point, so the argument
// selects the operation. An unrecognised command returns a distinct code rather
// than a plausible value, so a caller that passes the wrong one finds out.
//
//   0  checksum `bytes[0..len]`
//   1  emit the prologue for `nregions`, returning bytes written
//   2  validate the voted prologue, returning the region count or a negative code
//   3  report whether any prologue copy disagreed with the vote
//   4  emit the directory for `nregions`, returning the header byte length
//   5  find the region index whose kind is `warg`, or 0 - 1
//   6  report whether any directory copy disagreed with the vote
//   7  the voted word offset of region `warg`
//   8  the voted word length of region `warg`
//   9  the voted kind of region `warg`
//  10  emit the whole header area, returning its byte length
//  11  byte base of region `warg`'s payload
//  12  payload bytes of region `warg`
//  13  record count of region `warg` at stride `warg2`, or 0 - 1
//  14  u32 field `warg4` of record `warg3`, region `warg`, stride `warg2`
//  15  u16 field `warg4` of record `warg3`, region `warg`, stride `warg2`
//  16  byte `warg2` of region `warg` viewed as a pool
//  17  fill region `warg` with `warg2` pattern records, then re-emit nothing
//  18  number of names, 0 when the region is absent
//  19  byte offset of name `warg` into the string pool
//  20  byte length of name `warg`
//  21  byte `warg2` of name `warg`
//  22  number of shapes, 0 when the region is absent
//  23  tag of shape `warg`
//  24  kind of shape `warg`
//  25  size of shape `warg`
// THE DISPATCH IS SPLIT IN TWO, AND THE REASON IS A HARD LANGUAGE LIMIT.
//
// The parser rejects an expression nested more than 24 deep, with
// "parser recursion depth 24 exceeded; deeply nested expressions are rejected
// to prevent stack overflow". A single `if / else if / ...` chain is
// right-nested, so one arm costs one level of depth, and this module passed 24
// commands while growing. The rejection is a clean diagnostic rather than a
// crash, which is the language behaving well — but it does cap a flat dispatch
// at roughly two dozen arms.
//
// Splitting on a threshold keeps each chain far below the limit and leaves room
// for slices 5b to 5e. The threshold is arbitrary and only has to keep both
// halves short.

fn dispatch_container(cmd: Word) -> Word {
    if cmd == 0 { crc_range(0, wire.len) } else {
    if cmd == 1 { emit_prologue(wire.nregions) } else {
    if cmd == 2 { parse_prologue() } else {
    if cmd == 3 { prologue_disagreed() } else {
    if cmd == 4 { emit_directory(wire.nregions) } else {
    if cmd == 5 { dir_find(wire.warg) } else {
    if cmd == 6 { directory_disagreed() } else {
    if cmd == 7 { dir_u32(wire.warg, 4) } else {
    if cmd == 8 { dir_u32(wire.warg, 8) } else {
    if cmd == 9 { dir_u16(wire.warg, 0) } else {
    if cmd == 10 { emit_header() } else {
    if cmd == 11 { region_base(wire.warg) } else {
    if cmd == 12 { region_bytes(wire.warg) } else {
    0 - 98 }}}}}}}}}}}}}
}

fn dispatch_schema(cmd: Word) -> Word {
    if cmd == 13 { rec_count(wire.warg, wire.warg2) } else {
    if cmd == 14 { rec_u32(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 15 { rec_u16(wire.warg, wire.warg2, wire.warg3, wire.warg4) } else {
    if cmd == 16 { pool_u8(wire.warg, wire.warg2) } else {
    if cmd == 17 { emit_header(); emit_pattern_records(wire.warg, wire.warg2) } else {
    if cmd == 18 { name_count() } else {
    if cmd == 19 { name_offset(wire.warg) } else {
    if cmd == 20 { name_length(wire.warg) } else {
    if cmd == 21 { name_byte(wire.warg, wire.warg2) } else {
    if cmd == 22 { shape_count() } else {
    if cmd == 23 { shape_tag(wire.warg) } else {
    if cmd == 24 { shape_kind(wire.warg) } else {
    if cmd == 25 { shape_size(wire.warg) } else {
    0 - 99 }}}}}}}}}}}}}
}

fn main(cmd: Word) -> Word {
    if cmd < 13 { dispatch_container(cmd) } else { dispatch_schema(cmd) }
}
