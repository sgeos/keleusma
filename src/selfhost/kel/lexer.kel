// compiler/kel/lexer.kel — Stage 1 of the self-hosted compiler.
//
// Increment 1: a streaming byte tokenizer. Real Keleusma code that compiles and
// verifies on the current runtime. See docs/roadmap/V0_3_0_SELF_HOSTING.md and
// compiler/MILESTONES.md (roadmap Step 1).
//
// Model. Keleusma forbids unbounded inner loops in `fn` and `yield`, so the one
// top-level `loop` IS the scan over the source: one byte is processed per
// iteration and the in-progress token is assembled in the `private data` state,
// which persists across the loop's per-iteration RESET. A completed token is
// yielded when a token boundary is reached; intermediate bytes yield a PENDING
// marker that the host skips. This is the recursion-free, work-at-a-time
// discipline the whole pipeline uses.
//
// Source. The host places the source in the `shared data` byte array `src.bytes`
// and its length in `src.len`, then drives the loop with resume. Byte work is
// plain array indexing (R3.3); no `Text` native is needed for this increment.
//
// Token wire (increment 5, unified vocabulary). Each yielded Word is
// `tok + payload*256` (P11 Option E: 8-bit token radix), where `tok` is the parser's `Tok` discriminant and
// `payload` is the token's datum, so the lexer's output stream IS the parser's
// input stream and the two stages can be composed with no host-side adapter. Two
// out-of-band markers ride above the Tok range (0..53), so they never collide
// with `Tok::Fn = 0`:
//   63 PENDING  no complete token this iteration; the host skips it
//   62 EOF      end of source
// Payloads: an Ident (Tok 1) carries its interned id; an IntLit (Tok 12) carries
// its parsed value; every other token has payload 0. The Tok discriminants:
// fn 0, Ident 1, LBrace 2, RBrace 3, Yield 5, Loop 6, LParen 7, RParen 8,
// Colon 9, Comma 10, IntLit 12, data 13, shared 14, private 15, const 16, Eq 17,
// use 19, Plus 21, Minus 22, Star 23, Slash 24, Percent 25, EqEq 26, NotEq 27,
// Lt 28, Gt 29, LtEq 30, GtEq 31, not 32, band 33, bor 34, bxor 35, andalso 36,
// orelse 37, let 38, Semicolon 39, Dot 40, LBracket 41, RBracket 42, if 43,
// else 44, for 45, in 46, DotDot 47, match 48, FatArrow 49, Underscore 50,
// ColCol 51, as 52, enum 53, when 64; the catch-all 4 absorbs the `->` arrow and any
// unrecognized punctuation, which the parser skips.
//
// This wire is reached incrementally: increment 2 added maximal munch over the
// two-byte operators (`==`, `<=`, `::`, `..`, `=>`, and now `->`), increment 3
// keyword classification, increment 4 identifier interning, and increment 5 folds
// all of these plus the single-byte punctuation into the one `Tok`-coded wire via
// `op2_tok`, `punct_tok`, and `ident_token`. A lone `_` is the Underscore token,
// while `_foo` is an ordinary identifier. Increment 6 skips `//` line comments: on
// the two slashes the scanner enters kind 5 and drops bytes to the newline that
// ends the comment (or end of source), so a comment never tokenizes -- a
// prerequisite for tokenizing comment-dense real stage files.
// Spans, string interning of literals, and the richer `Token` struct in
// prelude.kel land in later increments once struct-valued yields are wired.

// The self-hosted compiler is a full-width host tool. Its token encoding does
// byte-level arithmetic that overflows a narrow word, so it declares a 32-bit
// floor. Compiling it for a narrower target is refused rather than silently
// miscompiled.
require word >= 32;

// The host places the source in `len`/`bytes` before driving the loop, and reads
// the identifier intern table (`istart`/`ilen`/`icount`) back out after: an Ident
// token's payload id indexes it, and each entry's `(istart, ilen)` locates the
// name's bytes in `bytes`, so the host recovers the id-to-spelling map the parser
// stage's `limit`/`require`/chunk-name inputs are expressed in without re-lexing.
// The table lives in shared data (not private) precisely so the host can read it.
// Sized to hold parse.kel, measured above 400 KB after checked-outcome parsing.
// The source buffer is bounded independently of the intern table. The wire-format V2 twenty-four-bit data operands raised the shared
// segment ceiling from 64KB to 16MB, so `bytes` may exceed 64KB and the intern
// arrays sit past a 64KB byte offset; the whole `src` block stays far under 16MB.
shared data src {
    len: Word,
    bytes: [Byte; 524288],
    istart: [Word; 1280],
    ilen: [Word; 1280],
    icount: Word,
    // Token 65 indexes a full-width integer under its interned source spelling.
    values: [Word; 1280],
}

// The scanner's cross-iteration state. `kind` is the token being built: 0 none,
// 2 identifier, 3 integer. `start` is the byte offset the current token began at
// and `val` accumulates its length (identifier) or value (integer).
private data st {
    cursor: Word,
    kind: Word,
    start: Word,
    val: Word,
    // Digits consumed since a radix prefix. `0x` with no digit following is an error in
    // the reference, and without a count it is indistinguishable from the literal zero.
    ndig: Word,
}

// Scratch accumulators for the interning content comparison (increment 4), which
// cannot use immutable locals. The intern table itself (`istart`/`ilen`/`icount`)
// lives in the shared `src` block so the host can read it back; capacity 1280
// distinct identifiers, and a source that exceeds it fails closed at the interning
// scan's `limit` rather than aliasing.
private data intern {
    found: Word,
    mism: Word,
}

// Byte-class predicates. Atomic total `fn`, so bounded by construction.
fn is_digit(b: Word) -> Word {
    if b >= 48 { if b <= 57 { 1 } else { 0 } } else { 0 }
}

// The value of a hexadecimal digit byte, or -1 for a byte that is not one. Both letter
// cases are accepted, matching the reference. Returning the VALUE rather than a boolean
// keeps the accumulation branch-free at the call site.
fn hex_val(b: Word) -> Word {
    if b >= 48 andalso b <= 57 {
        b - 48
    } else {
    if b >= 97 andalso b <= 102 {
        b - 87
    } else {
    if b >= 65 andalso b <= 70 {
        b - 55
    } else {
        0 - 1
    } } }
}

fn is_alpha(b: Word) -> Word {
    // Lowercase [97,122], uppercase [65,90], or underscore (95). The underscore is
    // checked on its own rather than inside the uppercase branch, since 95 is above
    // the uppercase range and would otherwise be misclassified as a non-letter.
    if b >= 97 andalso b <= 122 { 1 } else {
    if b >= 65 andalso b <= 90 { 1 } else {
    if b == 95 { 1 } else { 0 } } }
}

// An identifier continues with a letter, an underscore, or a digit (but must begin
// with a letter or underscore, which the start branch enforces with `is_alpha`).
// Without the digit, `kw2` would split into the identifier `kw` and the integer 2.
fn is_ident_cont(b: Word) -> Word {
    if is_alpha(b) == 1 { 1 } else { if is_digit(b) == 1 { 1 } else { 0 } }
}

fn is_space(b: Word) -> Word {
    if b == 32 { 1 } else {
    if b == 9 { 1 } else {
    if b == 10 { 1 } else {
    if b == 13 { 1 } else { 0 } } } }
}

// The source byte at `pos`, or 0 when `pos` is past the end. Lets the punctuation
// scan look one byte ahead for a two-character operator without indexing out of
// bounds at the final byte. Reads the shared source array.
fn peek_at(pos: Word) -> Word {
    if pos < src.len { src.bytes[pos] as Word } else { 0 }
}

// Classify a two-byte operator by its first byte `b` and the byte after it,
// `next`. Returns the compound code plus one (1..8) so 0 cleanly means "not a
// two-byte operator"; the caller subtracts one to recover the code. Factored out
// of the loop so the per-iteration body stays shallow (the parser stage learned
// that deep loop nesting overflows the host compiler's recursion-depth limit).
// Codes: 0 `==`, 1 `!=`, 2 `<=`, 3 `>=`, 4 `::`, 5 `..`, 6 `=>`, 7 `->`, 8 `|>`.
fn compound_code(b: Word, next: Word) -> Word {
    if b == 61 {
        // `=` begins `==` (code 0) or `=>` (code 6); otherwise a lone `=`.
        if next == 61 { 1 } else { if next == 62 { 7 } else { 0 } }
    } else {
    if b == 33 { if next == 61 { 2 } else { 0 } } else {   // `!=`
    if b == 60 { if next == 61 { 3 } else { 0 } } else {   // `<=`
    if b == 62 { if next == 61 { 4 } else { 0 } } else {   // `>=`
    if b == 58 { if next == 58 { 5 } else { 0 } } else {   // `::`
    if b == 46 { if next == 46 { 6 } else { 0 } } else {   // `..`
    if b == 45 { if next == 62 { 8 } else { 0 } } else {   // `->`
    if b == 124 { if next == 62 { 9 } else { 0 } } else {  // `|>`
    0 } } } } } } } }
}

// Keyword recognition (increment 3). An identifier run whose bytes spell one of
// the language's keywords is classified to the parser's `Tok` code for that
// keyword rather than emitted as a plain IDENT. The match is split into one
// helper per run length so each stays a flat `andalso` chain of byte equalities,
// keeping every function well under the host compiler's recursion-depth limit.
// A run of a length no keyword has, or a non-matching run, returns the -1
// sentinel (0 is a valid Tok code, `fn`, so 0 cannot mean "no match"). Byte
// values are ASCII: the run's bytes are read through `peek_at`, which yields the
// past-the-end sentinel 0 for a run that is shorter than the length probed.

fn kw2(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    if a == 102 andalso b == 110 { 0 } else {    // fn
    if a == 105 andalso b == 102 { 43 } else {   // if
    if a == 105 andalso b == 110 { 46 } else {   // in
    if a == 97 andalso b == 115 { 52 } else {    // as
    0 - 1 } } } }
}

fn kw3(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    let c = peek_at(start + 2);
    if a == 108 andalso b == 101 andalso c == 116 { 38 } else {   // let
    if a == 102 andalso b == 111 andalso c == 114 { 45 } else {   // for
    if a == 117 andalso b == 115 andalso c == 101 { 19 } else {   // use
    if a == 110 andalso b == 111 andalso c == 116 { 32 } else {   // not
    if a == 98 andalso b == 111 andalso c == 114 { 34 } else {    // bor
    if a == 108 andalso b == 115 andalso c == 108 { 59 } else {   // lsl
    if a == 97 andalso b == 115 andalso c == 108 { 60 } else {    // asl
    if a == 97 andalso b == 115 andalso c == 114 { 61 } else {    // asr
    if a == 108 andalso b == 115 andalso c == 114 { 20 } else {   // lsr
    if a == 120 andalso b == 111 andalso c == 114 { 18 } else {   // xor
    0 - 1 } } } } } } } } } }
}

fn kw4(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    let c = peek_at(start + 2);
    let d = peek_at(start + 3);
    if a == 101 andalso b == 108 andalso c == 115 andalso d == 101 { 44 } else {  // else
    if a == 108 andalso b == 111 andalso c == 111 andalso d == 112 { 6 } else {   // loop
    if a == 100 andalso b == 97 andalso c == 116 andalso d == 97 { 13 } else {    // data
    if a == 101 andalso b == 110 andalso c == 117 andalso d == 109 { 53 } else {  // enum
    if a == 98 andalso b == 97 andalso c == 110 andalso d == 100 { 33 } else {    // band
    if a == 98 andalso b == 120 andalso c == 111 andalso d == 114 { 35 } else {   // bxor
    if a == 119 andalso b == 104 andalso c == 101 andalso d == 110 { 64 } else {  // when
    if a == 105 andalso b == 109 andalso c == 112 andalso d == 108 { 56 } else {  // impl
    if a == 98 andalso b == 110 andalso c == 111 andalso d == 116 { 11 } else {   // bnot
    if a == 112 andalso b == 117 andalso c == 114 andalso d == 101 { 70 } else {  // pure
    0 - 1 } } } } } } } } } }
}

fn kw5(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    let c = peek_at(start + 2);
    let d = peek_at(start + 3);
    let e = peek_at(start + 4);
    if a == 99 andalso b == 111 andalso c == 110 andalso d == 115 andalso e == 116 { 16 } else {   // const
    if a == 109 andalso b == 97 andalso c == 116 andalso d == 99 andalso e == 104 { 48 } else {    // match
    if a == 121 andalso b == 105 andalso c == 101 andalso d == 108 andalso e == 100 { 5 } else {   // yield
    if a == 116 andalso b == 114 andalso c == 97 andalso d == 105 andalso e == 116 { 55 } else {   // trait
    if a == 98 andalso b == 114 andalso c == 101 andalso d == 97 andalso e == 107 { 57 } else {    // break
    0 - 1 } } } } }
}

fn kw6(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    let c = peek_at(start + 2);
    let d = peek_at(start + 3);
    let e = peek_at(start + 4);
    let f = peek_at(start + 5);
    if a == 115 andalso b == 104 andalso c == 97 andalso d == 114 andalso e == 101 andalso f == 100 { 14 } else {   // shared
    if a == 111 andalso b == 114 andalso c == 101 andalso d == 108 andalso e == 115 andalso f == 101 { 37 } else {  // orelse
    if a == 115 andalso b == 116 andalso c == 114 andalso d == 117 andalso e == 99 andalso f == 116 { 54 } else {   // struct
    if a == 115 andalso b == 105 andalso c == 103 andalso d == 110 andalso e == 101 andalso f == 100 { 69 } else {  // signed
    0 - 1 } } } }
}

fn kw7(start: Word) -> Word {
    let a = peek_at(start);
    let b = peek_at(start + 1);
    let c = peek_at(start + 2);
    let d = peek_at(start + 3);
    let e = peek_at(start + 4);
    let f = peek_at(start + 5);
    let g = peek_at(start + 6);
    if a == 112 andalso b == 114 andalso c == 105 andalso d == 118 andalso e == 97 andalso f == 116 andalso g == 101 { 15 } else {  // private
    if a == 97 andalso b == 110 andalso c == 100 andalso d == 97 andalso e == 108 andalso f == 115 andalso g == 111 { 36 } else {   // andalso
    0 - 1 } }
}

// Dispatch keyword matching by run length; a length no keyword has returns -1.
fn keyword_code(start: Word, len: Word) -> Word {
    if len == 2 { kw2(start) } else {
    if len == 3 { kw3(start) } else {
    if len == 4 { kw4(start) } else {
    if len == 5 { kw5(start) } else {
    if len == 6 { kw6(start) } else {
    if len == 7 { kw7(start) } else {
    if len == 8 { kw8(start) } else {
    if len == 9 { kw9(start) } else {
    0 - 1 } } } } } } } }
}

// `external`, the one eight-letter keyword, Tok 72.
fn kw8(start: Word) -> Word {
    if peek_at(start) == 101 andalso peek_at(start + 1) == 120 andalso peek_at(start + 2) == 116
        andalso peek_at(start + 3) == 101 andalso peek_at(start + 4) == 114 andalso peek_at(start + 5) == 110
        andalso peek_at(start + 6) == 97 andalso peek_at(start + 7) == 108 {
        72
    } else { 0 - 1 }
}

// `ephemeral`, the one nine-letter keyword, Tok 71.
fn kw9(start: Word) -> Word {
    if peek_at(start) == 101 andalso peek_at(start + 1) == 112 andalso peek_at(start + 2) == 104
        andalso peek_at(start + 3) == 101 andalso peek_at(start + 4) == 109 andalso peek_at(start + 5) == 101
        andalso peek_at(start + 6) == 114 andalso peek_at(start + 7) == 97 andalso peek_at(start + 8) == 108 {
        71
    } else { 0 - 1 }
}

// Intern a non-keyword identifier run at source offset `start` of `len` bytes and
// return its stable id. The run is compared byte for byte against each existing
// entry of the same length; a match returns that entry's index and a miss appends
// a new entry and returns its index. Both loops are `for .. limit`, so the work is
// statically bounded and an identifier longer than the inner cap (64) fails closed
// at that limit rather than being silently truncated to an aliasing key. `found`
// and `mism` are data fields because a `for` body cannot mutate a local; ids are
// unique, so the last (and only) matching index the scan records is the answer.
fn intern_id(start: Word, len: Word) -> Word {
    intern.found = 0 - 1;
    for i in 0..src.icount limit 1280 {
        if src.ilen[i] == len {
            intern.mism = 0;
            for j in 0..len limit 64 {
                if peek_at(src.istart[i] + j) != peek_at(start + j) {
                    intern.mism = intern.mism + 1;
                }
            }
            if intern.mism == 0 {
                intern.found = i;
            }
        }
    }
    if intern.found >= 0 {
        intern.found
    } else {
        let id = src.icount;
        src.istart[id] = start;
        src.ilen[id] = len;
        src.icount = src.icount + 1;
        id
    }
}

// Map a two-byte operator's compound code (0..7) to its parser `Tok` code. The
// arrow `->` has no dedicated Tok variant (the runtime tokenizer's Arrow folds to
// the catch-all 4, which the parser skips between the parameter list and the
// return type), so code 7 maps to 4 like any other unrecognized punctuation.
fn op2_tok(code: Word) -> Word {
    if code == 0 { 26 } else {   // ==  EqEq
    if code == 1 { 27 } else {   // !=  NotEq
    if code == 2 { 30 } else {   // <=  LtEq
    if code == 3 { 31 } else {   // >=  GtEq
    if code == 4 { 51 } else {   // ::  ColCol
    if code == 5 { 47 } else {   // ..  DotDot
    if code == 6 { 49 } else {   // =>  FatArrow
    if code == 8 { 68 } else {   // |>  Pipe, Tok 68
    4 } } } } } } } }            // ->  Arrow (catch-all)
}

// Map a single punctuation byte to its parser `Tok` code, split into a delimiter
// group and an operator group so each helper stays a shallow if-else chain. An
// unrecognized byte becomes Tok 67, which the parser refuses as unsupported syntax.
// It used to become the arrow's catch-all Tok 4, which the body walk skips, so
// `6 |> double()` read as `6 > double()` and was rejected as a type error, and an
// unknown byte between two operands could vanish from the program altogether.
fn punct_tok(b: Word) -> Word {
    let t = punct_delim(b);
    if t >= 0 { t } else { punct_op(b) }
}

fn punct_delim(b: Word) -> Word {
    if b == 123 { 2 } else {    // {  LBrace
    if b == 125 { 3 } else {    // }  RBrace
    if b == 40 { 7 } else {     // (  LParen
    if b == 41 { 8 } else {     // )  RParen
    if b == 91 { 41 } else {    // [  LBracket
    if b == 93 { 42 } else {    // ]  RBracket
    if b == 58 { 9 } else {     // :  Colon
    if b == 44 { 10 } else {    // ,  Comma
    if b == 59 { 39 } else {    // ;  Semicolon
    0 - 1 } } } } } } } } }
}

fn punct_op(b: Word) -> Word {
    if b == 61 { 17 } else {    // =  Eq
    if b == 43 { 21 } else {    // +  Plus
    if b == 45 { 22 } else {    // -  Minus
    if b == 42 { 23 } else {    // *  Star
    if b == 47 { 24 } else {    // /  Slash
    if b == 37 { 25 } else {    // %  Percent
    if b == 60 { 28 } else {    // <  Lt
    if b == 62 { 29 } else {    // >  Gt
    if b == 46 { 40 } else {    // .  Dot
    punct_label(b) } } } } } } } } }
}

// The information-flow label punctuation, Order 6. `@` introduces a label, Tok 74, and a
// lone `!` negates one, Tok 75, since `!=` is matched as a compound before this. Any other
// byte stays Tok 67, which the parser refuses.
fn punct_label(b: Word) -> Word {
    if b == 64 { 74 } else { if b == 33 { 75 } else { 67 } }
}

// The token word for a completed identifier run at `start` of `len` bytes, in the
// unified wire `tok + payload*256`: a lone `_` is the Underscore token (Tok 50); a
// keyword run is its Tok code with no payload; any other run is an Ident (Tok 1)
// carrying its interned id as the payload.
fn ident_token(start: Word, len: Word) -> Word {
    if len == 1 andalso peek_at(start) == 95 {
        50
    } else {
        let kc = keyword_code(start, len);
        if kc >= 0 { kc } else { 1 + intern_id(start, len) * 256 }
    }
}

// Validate before multiplying so malformed literals never wrap into valid values.
fn integer_digit(digit: Word, radix: Word) -> Word {
    let maximum = bnot 0 lsr 1;
    if st.val > (maximum - digit) / radix { st.kind = 8; } else {
        st.val = st.val * radix + digit;
    }
    0
}
// A float literal, `digits.digits`, Tok 73 carrying the interned text of the literal. The
// host converts that text to an `f64` with the parser the reference lexer uses, since a
// correctly rounded decimal conversion is not something to reimplement here. A suffix,
// `Float` or `Fixed<N>`, is refused as Tok 67 for now.
fn float_token() -> Word {
    st.kind = 0;
    if is_alpha(peek_at(st.cursor)) == 1 { 67 } else {
        73 + intern_id(st.start, st.cursor - st.start) * 256
    }
}

fn integer_token() -> Word {
    let valid = st.kind == 3 orelse st.ndig > 0;
    st.kind = 0;
    if not valid { 66 + st.cursor * 256 } else {
        if st.val <= (bnot 0 lsr 1) / 256 { 12 + st.val * 256 } else {
            let id = intern_id(st.start, st.cursor - st.start);
            src.values[id] = st.val;
            65 + id * 256
        }
    }
}

// One raw token, or 63 while a token is still being built, or 62 at the end of input.
// This was the body of `loop main` until Order 6 slice 3, which put the destructuring
// filter between it and the parser. Every former `yield` was in tail position.
fn lex_raw() -> Word {
    if st.kind == 8 { 66 + st.cursor * 256 } else {
    if st.cursor >= src.len {
        // End of source: flush a token still being built, then report EOF (62).
        if st.kind == 0 {
            62
        } else {
        if st.kind == 2 {
            // A keyword or identifier ending exactly at end of input.
            st.kind = 0;
            ident_token(st.start, st.val)
        } else {
        if st.kind == 10 { float_token() } else {
        if st.kind == 3 orelse st.kind == 6 orelse st.kind == 7 {
            integer_token()
        } else {
            // A `//` comment ran to end of source with no trailing newline: no token.
            62
        } } } }
    } else {
        let b = src.bytes[st.cursor] as Word;
        if st.kind == 2 {
            // Extending an identifier, or ending it at a non-identifier byte. The
            // continuation set includes digits, so `kw2` is one identifier.
            if is_ident_cont(b) == 1 {
                st.cursor = st.cursor + 1;
                st.val = st.val + 1;
                63
            } else {
                // The run ended: classify it as a keyword or emit it as an IDENT.
                st.kind = 0;
                ident_token(st.start, st.val)
            }
        } else {
        if st.kind == 3 orelse st.kind == 10 {
            // Extending an integer, or ending it at a non-digit byte. A `.` followed by a
            // digit continues it as a float literal (kind 10), as the reference lexes one.
            if is_digit(b) == 1 {
                st.cursor = st.cursor + 1;
                if st.kind == 3 { integer_digit(b - 48, 10); }
                63
            } else {
            if st.kind == 3 andalso b == 46 andalso is_digit(peek_at(st.cursor + 1)) == 1 {
                st.kind = 10;
                st.cursor = st.cursor + 1;
                63
            } else {
            if st.kind == 10 { float_token() } else {
                // IntLit (Tok 12), the parsed value as the payload.
                integer_token()
            } } }
        } else {
        if st.kind == 6 {
            // Extending a hexadecimal integer, or ending it at a non-hex-digit byte.
            let d = hex_val(b);
            if d >= 0 {
                st.cursor = st.cursor + 1;
                integer_digit(d, 16);
                st.ndig = st.ndig + 1;
                63
            } else {
                // The token helper refuses a prefix without digits.
                integer_token()
            }
        } else {
        if st.kind == 7 {
            // Extending a binary integer, or ending it at a non-binary-digit byte.
            if b == 48 orelse b == 49 {
                st.cursor = st.cursor + 1;
                integer_digit(b - 48, 2);
                st.ndig = st.ndig + 1;
                63
            } else {
                integer_token()
            }
        } else {
        if st.kind == 5 {
            // Inside a `//` line comment: skip bytes until the newline that ends it
            // (or end of source), then resume normal tokenizing.
            if b == 10 {
                st.kind = 0;
            }
            st.cursor = st.cursor + 1;
            63
        } else {
        if st.kind == 4 {
            // Inside a string literal: extend until the closing `"` (byte 34), then intern the
            // RAW content bytes (dedup, reusing the identifier intern table) and emit a Str token
            // (Tok 58) carrying the intern id. A backslash (byte 92) escapes the next byte: the
            // pair is skipped as raw content (so `\"` does not terminate and `\\` is one unit), and
            // the host unescapes the raw bytes when building the StaticStr, matching the reference.
            if b == 92 {
                st.cursor = st.cursor + 2;
                st.val = st.val + 2;
                63
            } else {
            if b == 34 {
                let id = intern_id(st.start, st.val);
                st.kind = 0;
                st.cursor = st.cursor + 1;
                58 + id * 256
            } else {
                st.cursor = st.cursor + 1;
                st.val = st.val + 1;
                63
            } }
        } else {
            // No token in progress: start one, skip whitespace, or emit punctuation.
            if b == 34 {
                // Opening quote: start a string literal; its content begins at the next byte.
                st.kind = 4;
                st.start = st.cursor + 1;
                st.val = 0;
                st.cursor = st.cursor + 1;
                63
            } else {
            if is_space(b) == 1 {
                st.cursor = st.cursor + 1;
                63
            } else {
            if is_alpha(b) == 1 {
                st.kind = 2;
                st.start = st.cursor;
                st.val = 1;
                st.cursor = st.cursor + 1;
                63
            } else {
            if is_digit(b) == 1 {
                // A RADIX PREFIX, and the third arm is the one a reasonable guess gets
                // wrong. `0x`/`0X` is always hexadecimal and `0b` is always binary, but
                // `0B` is binary ONLY when a binary digit follows: otherwise the `B`
                // begins the `Byte` numeric suffix, so `0Byte` is the byte literal zero
                // rather than a malformed binary literal. Taken from the reference lexer,
                // not inferred from the corpus, which uses `0x` exclusively.
                let p1 = peek_at(st.cursor + 1);
                let p2 = peek_at(st.cursor + 2);
                if b == 48 andalso (p1 == 120 orelse p1 == 88) {
                    st.kind = 6;
                    st.start = st.cursor;
                    st.val = 0;
                    st.ndig = 0;
                    st.cursor = st.cursor + 2;
                    63
                } else {
                if b == 48 andalso (p1 == 98 orelse (p1 == 66 andalso (p2 == 48 orelse p2 == 49))) {
                    st.kind = 7;
                    st.start = st.cursor;
                    st.val = 0;
                    st.ndig = 0;
                    st.cursor = st.cursor + 2;
                    63
                } else {
                st.kind = 3;
                st.start = st.cursor;
                st.val = b - 48;
                st.cursor = st.cursor + 1;
                63
                } }
            } else {
            if b == 47 andalso peek_at(st.cursor + 1) == 47 {
                // A `//` line comment: skip both slashes and read the rest in kind 5.
                st.kind = 5;
                st.cursor = st.cursor + 2;
                63
            } else {
                // Punctuation: a two-byte operator by maximal munch, else one byte,
                // each mapped to its parser Tok code (payload 0).
                let cc = compound_code(b, peek_at(st.cursor + 1));
                if cc > 0 {
                    st.cursor = st.cursor + 2;
                    op2_tok(cc - 1)
                } else {
                    st.cursor = st.cursor + 1;
                    punct_tok(b)
                }
            } } } } }
        } } } } } }
    }
}
}

// THE DESTRUCTURING FILTER, Order 6 slice 3.
//
// `let (a, _, b) = e;` reaches the parser as the plain lets the reference lowers it to:
// `let T = e; let a = T.0; T.1; let b = T.2;`. The reference stores the value in a fresh
// local, then reads each element with `GetTupleField` and binds it or pops it, and those
// statements produce exactly those operations, slot for slot. Rewriting the tokens keeps
// the parser's single-token pushback intact, which a queue inside the parser would not.
//
// The hidden binding `T` is interned from the bytes of the `let` keyword itself. Its
// string is therefore `let`, which no identifier can be, so it shadows nothing, and the
// host recovers it from source bytes like any other name.
//
// A struct pattern takes the same path, Order 6 follow-up of 2026-10-31. `let P { x, y: b,
// z: _ } = e;` reaches the parser as `let T = e; let x = T.x; let b = T.y; T.z;`, which is
// the reference's lowering of a struct `let` statement for statement. The struct name is
// dropped, because the reference type checker has matched it against the value's type
// before any self-hosted output is accepted.
//
// A NESTED pattern and a variant pattern of a single-variant enum take it too, the
// operator's ruling of 2026-10-31. The reference stores each nested value in a fresh local
// of its own before reading its elements, depth first in source order, so `let (a, (b, c))
// = e;` becomes `let T = e; let a = T.0; let U = T.1; let b = U.0; let c = U.1;`. The
// binding at depth d is interned from the `let` keyword's bytes and the d bytes after it.
// The byte after `let` cannot continue an identifier, so no such string is an identifier,
// and the lengths differ, so the bindings of different depths are distinct. A binding of
// one depth is shadowed only by a later sibling at that depth, after the earlier sibling's
// reads are done, which is the reference's fresh local for each nested pattern. `let
// W::A(x, y) = e;` becomes `let T = e; let x = T.0; let y = T.1;`, and the parser reads
// `T.N` of a value of a single-variant enum as that variant's payload field N, which is the
// reference's `GetEnumField`. A grouping parenthesis, `(p)`, is transparent as in the
// reference, so `p` takes its place.
//
// Anything else becomes Tok 67, which the parser refuses as unsupported syntax: a literal or
// typed pattern, `()` and `(p,)`, more than twenty-four pattern items or six open patterns, a
// `let` inside the destructured value, and input that ends inside the statement.
//
// States: 0 passing, 1 a `let` held, 2 awaiting a pattern element, 3 awaiting `=`, 4 inside
// the value, where `depth` counts open brackets so the statement's own `;` can be found, 5
// after `let _`, awaiting the `=` that is dropped with it, 6 after `let Name`, holding the
// name, 7 awaiting a struct field or `}`, 8 after a field name, 9 after a name inside the
// pattern, 10 after a complete element, 11 after `Name::`, and 12 after the variant name.
private data dq {
    q: [Word; 192],
    pos: Word,
    len: Word,
    state: Word,
    depth: Word,
    let_at: Word,
    held: Word,
    // The pattern items in source order. Kind 0 binds the name `it_val`, 1 is a wildcard,
    // 2 opens a nested pattern, 3 closes one, and 4 is a grouping parenthesis that reads
    // nothing. `it_acc` is the token naming the element in its enclosing pattern.
    ni: Word,
    it_kind: [Word; 24],
    it_val: [Word; 24],
    it_acc: [Word; 24],
    // The open patterns, innermost last. Kind 0 is a tuple, 1 a struct and 2 a variant.
    sp: Word,
    fr_kind: [Word; 6],
    fr_count: [Word; 6],
    fr_comma: [Word; 6],
    fr_open: [Word; 6],
    // The pending struct field, the first item read, and the walk's depth and cursor.
    acc: Word,
    first: Word,
    d: Word,
    c: Word,
}

fn dq_push(t: Word) -> Word {
    if dq.len < 192 { dq.q[dq.len] = t; dq.len = dq.len + 1; }
    0
}

fn dq_take() -> Word {
    let t = dq.q[dq.pos];
    dq.pos = dq.pos + 1;
    if dq.pos >= dq.len { dq.pos = 0; dq.len = 0; }
    t
}

fn dq_refuse() -> Word {
    dq.state = 0;
    67
}

// The hidden binding of depth `d` as an identifier token.
fn dq_temp(d: Word) -> Word {
    1 + intern_id(dq.let_at, 3 + d) * 256
}

// Queue the element statements once the value's `;` has passed. A name reads its element
// into a binding, a wildcard reads it as an expression statement, and a nested pattern reads
// it into the hidden binding one depth down.
fn dq_elements() -> Word {
    dq.d = 0;
    for i in 0..dq.ni limit 24 {
        let kind = dq.it_kind[i];
        if i >= dq.first andalso kind == 3 { dq.d = dq.d - 1; }
        if i >= dq.first andalso kind != 3 andalso kind != 4 {
            let from = dq_temp(dq.d);
            if kind == 0 { dq_push(38); dq_push(1 + dq.it_val[i] * 256); dq_push(17); }
            if kind == 2 { dq_push(38); dq_push(dq_temp(dq.d + 1)); dq_push(17); dq.d = dq.d + 1; }
            dq_push(from); dq_push(40); dq_push(dq.it_acc[i]); dq_push(39);
        }
    }
    0
}

// The first item after `o` that is not a grouping parenthesis.
fn dq_first_after(o: Word) -> Word {
    dq.c = 0 - 1;
    for j in 0..dq.ni limit 24 {
        if j > o andalso dq.c < 0 andalso dq.it_kind[j] != 4 { dq.c = j; }
    }
    dq.c
}

// Record an element of the innermost open pattern, with the token that names it there.
fn dq_item(kind: Word, val: Word) -> Word {
    if dq.ni >= 24 { dq_refuse() } else {
        let s = dq.sp - 1;
        dq.it_kind[dq.ni] = kind;
        dq.it_val[dq.ni] = val;
        dq.it_acc[dq.ni] = 0;
        if s >= 0 {
            dq.it_acc[dq.ni] = if dq.fr_kind[s] == 1 { dq.acc } else { 12 + dq.fr_count[s] * 256 };
            dq.fr_count[s] = dq.fr_count[s] + 1;
        }
        dq.ni = dq.ni + 1;
        63
    }
}

// Open a tuple, struct or variant pattern as an element of the enclosing one.
fn dq_open(kind: Word) -> Word {
    let at = dq.ni;
    if dq.sp >= 6 { dq_refuse() } else {
    if dq_item(2, 0) == 67 { 67 } else {
        dq.fr_kind[dq.sp] = kind;
        dq.fr_count[dq.sp] = 0;
        dq.fr_comma[dq.sp] = 0;
        dq.fr_open[dq.sp] = at;
        dq.sp = dq.sp + 1;
        dq.state = if kind == 1 { 7 } else { 2 };
        63
    } }
}

// Close the innermost open pattern. A tuple of one element without a comma is a grouping
// parenthesis, so its element takes its place. `()` and `(p,)` are refused.
fn dq_close() -> Word {
    let s = dq.sp - 1;
    let tuple = dq.fr_kind[s] == 0;
    if tuple andalso dq.fr_count[s] == 1 andalso dq.fr_comma[s] == 0 {
        let o = dq.fr_open[s];
        dq.it_kind[o] = 4;
        dq.it_acc[dq_first_after(o)] = dq.it_acc[o];
        dq.sp = s;
        dq.state = if s == 0 { 3 } else { 10 };
        63
    } else {
    if tuple andalso dq.fr_count[s] < 2 { dq_refuse() } else {
    if dq.ni >= 24 { dq_refuse() } else {
        dq.it_kind[dq.ni] = 3;
        dq.ni = dq.ni + 1;
        dq.sp = s;
        dq.state = if s == 0 { 3 } else { 10 };
        63
    } } }
}

// Begin a pattern after `let`, with no item and no open pattern.
fn dq_begin(kind: Word) -> Word {
    dq.ni = 0;
    dq.sp = 0;
    dq_open(kind)
}

fn dq_filter(t: Word) -> Word {
    let k = t % 256;
    if t == 62 {
        // End of input. A held `let` is released, and anything deeper is refused.
        if dq.state == 1 { dq.state = 0; dq_push(62); 38 } else {
        if dq.state > 1 { dq_refuse() } else { 62 } }
    } else {
    if t == 63 { 63 } else {
    if dq.state >= 6 { dq_pattern(t, k) } else {
    if dq.state == 2 { dq_elem(t, k) } else {
    if dq.state == 0 {
        if k == 38 { dq.state = 1; dq.let_at = st.start; 63 } else { t }
    } else {
    if dq.state == 1 {
        if k == 7 { dq_begin(0) } else {
        if k == 50 { dq.state = 5; 63 } else {
        if k == 1 { dq.state = 6; dq.held = t; 63 } else { dq.state = 0; dq_push(t); 38 } } }
    } else {
    if dq.state == 5 {
        // `let _ = e;` is the expression statement `e;` to the reference, operation for
        // operation, so the three tokens are dropped. An annotated wildcard is refused.
        dq.state = 0;
        if k == 17 { 63 } else { 67 }
    } else {
    if dq.state == 3 { dq_assign(k) } else {
        if k == 38 { dq_refuse() } else {
        if k == 7 orelse k == 41 orelse k == 2 { dq.depth = dq.depth + 1; t } else {
        if k == 8 orelse k == 42 orelse k == 3 {
            if dq.depth == 0 { dq_refuse() } else { dq.depth = dq.depth - 1; t }
        } else {
        if k == 39 andalso dq.depth == 0 { dq.state = 0; dq_elements(); t } else { t } } } }
    } } } } } } } }
}

// The `=` after a complete pattern. A pattern that is a name in grouping parentheses is
// the plain `let` of that name, a grouped wildcard drops the `let` as `let _` does, and
// any other stores the value in the hidden binding of depth zero.
fn dq_assign(k: Word) -> Word {
    if k == 17 {
        dq.state = 4;
        dq.depth = 0;
        let top = dq_first_after(0 - 1);
        dq.first = top + 1;
        if dq.it_kind[top] == 0 {
            dq.first = dq.ni;
            dq_push(1 + dq.it_val[top] * 256);
            dq_push(17);
            38
        } else {
        if dq.it_kind[top] == 1 { dq.first = dq.ni; 63 } else {
            dq_push(dq_temp(0));
            dq_push(17);
            38
        } }
    } else { dq_refuse() }
}

// State 2, awaiting an element of a tuple or variant pattern, or the pattern of a field.
// A `)` closes a tuple or variant after a trailing comma or a variant with no payload.
fn dq_elem(t: Word, k: Word) -> Word {
    if k == 1 { dq.held = t; dq.state = 9; 63 } else {
    if k == 50 { dq.state = 10; dq_item(1, 0) } else {
    if k == 7 { dq_open(0) } else {
    if k == 8 andalso dq.sp > 0 andalso dq.fr_kind[dq.sp - 1] != 1 { dq_close() } else { dq_refuse() } } } }
}

// State 10, after a complete element: a comma awaits the next element and the closing
// bracket of the innermost pattern closes it.
fn dq_after(k: Word) -> Word {
    let s = dq.sp - 1;
    let fs = dq.fr_kind[s] == 1;
    if k == 10 {
        dq.fr_comma[s] = 1;
        dq.state = if fs { 7 } else { 2 };
        63
    } else {
    if (k == 8 andalso not fs) orelse (k == 3 andalso fs) { dq_close() } else { dq_refuse() } }
}

// A name inside the pattern is a binding unless `{` makes it a struct's or `::` an enum's.
fn dq_name(k: Word) -> Word {
    if k == 2 { dq_open(1) } else {
    if k == 51 { dq.state = 11; 63 } else {
    if dq_item(0, dq.held / 256) == 67 { 67 } else { dq_after(k) } } }
}

// After the variant name. A `(` opens its payload pattern, and a bare variant is a variant
// pattern with no payload, whose following token is read again in the state it leaves.
fn dq_variant(k: Word) -> Word {
    if k == 7 { dq_open(2) } else {
    if dq_open(2) == 67 { 67 } else {
    if dq_close() == 67 { 67 } else {
    if dq.sp == 0 { dq_assign(k) } else { dq_after(k) } } } }
}

// The pattern states from 6. After `let Name`, a `{` opens a struct pattern, a `::` a
// variant pattern, and anything else releases the held `let` and name as an ordinary
// binding. A field binds its own name unless a `:` gives it a pattern.
fn dq_pattern(t: Word, k: Word) -> Word {
    if dq.state == 6 {
        if k == 2 { dq_begin(1) } else {
        if k == 51 { dq.ni = 0; dq.sp = 0; dq.state = 11; 63 } else { dq.state = 0; dq_push(dq.held); dq_push(t); 38 } }
    } else {
    if dq.state == 7 {
        if k == 1 { dq.acc = t; dq.held = t; dq.state = 8; 63 } else {
        if k == 3 { dq_close() } else { dq_refuse() } }
    } else {
    if dq.state == 8 {
        if k == 9 { dq.state = 2; 63 } else {
        if k == 10 orelse k == 3 {
            if dq_item(0, dq.held / 256) == 67 { 67 } else { dq_after(k) }
        } else { dq_refuse() } }
    } else {
    if dq.state == 9 { dq_name(k) } else {
    if dq.state == 10 { dq_after(k) } else {
    if dq.state == 11 {
        if k == 1 { dq.state = 12; 63 } else { dq_refuse() }
    } else { dq_variant(k) } } } } } }
}

fn next_token() -> Word {
    if dq.len > 0 { dq_take() } else {
    // A shebang line at the very start of the source is skipped, as the reference lexer
    // skips it, by entering the line-comment state past the `#!`.
    if st.cursor == 0 andalso st.kind == 0 andalso peek_at(0) == 35 andalso peek_at(1) == 33 {
        st.kind = 5;
        st.cursor = 2;
        63
    } else { dq_filter(lex_raw()) } }
}

loop main(resume: Word) -> Word {
    yield next_token()
}
