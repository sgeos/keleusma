    if en.mode != 0 andalso (cmd < 65 orelse cmd > 70) { emit_error() } else {
    if bf.mode != 0 andalso (cmd < 71 orelse cmd > 77) andalso not (bf.mode == 4 andalso cmd >= 65 andalso cmd <= 70) { emit_error() } else {
    if ec.template_mode != 0 andalso cmd != 82 andalso (cmd < 65 orelse cmd > 70) { emit_error() } else {
    if fr.mode != 0 andalso (cmd < 57 orelse cmd > 63) { frame_error() } else {
