    if cmd == 94 { shared_run_begin() } else {
    if cmd == 95 { shared_run_head_reply() } else {
    if cmd == 96 { shared_run_batch_reply() } else {
    if cmd == 97 { shared_run_next() } else { run_error() }}}}}}}}}
}

fn signatures_dispatch(cmd: Word) -> Word {
    if cmd == 0 { tables_begin() } else {
    if cmd == 1 { signature_check() } else {
    if cmd == 2 { tables_finish() } else {
    if cmd == 3 { shape_reply() } else {
    if cmd == 4 { signature_begin() } else {
