    if pt.mode != 0 andalso (cmd < 41 orelse cmd > 43) { 0 - 310 } else {
    if dr.mode != 0 andalso (cmd < 44 orelse cmd > 47) andalso not (dr.mode == 3 andalso dr.phase == 1 andalso (cmd == 10 orelse cmd == 11)) { debug_error() } else {
    if dl.mode != 0 andalso (cmd < 30 orelse cmd > 40) andalso not (cmd >= 8 andalso cmd <= 11 andalso dl.mode == 3) { data_error() } else {
    if lt.mode != 0 andalso (cmd < 22 orelse cmd > 29) andalso not (cmd >= 8 andalso cmd <= 11 andalso lt.mode == 5) { layout_error() } else {
    if cs.mode != 0 andalso (cmd < 12 orelse cmd > 21) andalso not (cmd >= 8 andalso cmd <= 11 andalso cs.mode == 6) { constant_error() } else {
    if nr.mode != 0 andalso (cmd < 8 orelse cmd > 11) andalso not (cmd == 28 andalso lt.mode == 5 andalso io.arg[0] == 0) { 0 - 296 } else {
    if sg.mode != 0 andalso cmd >= 8 { schema_error() } else { route(cmd) }}}}}}}}}}}}}}}
}

loop main(cmd: Word) -> Word { yield dispatch(cmd) }
