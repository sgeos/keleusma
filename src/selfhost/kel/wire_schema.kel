// Module metadata orchestration. Payload readers use separate schema instances,
// except names, whose nested transaction is permitted while a name is pending.
private data mo {
    mode: Word,
    names: Word,
    chunks: Word,
    natives: Word,
    chunk_at: Word,
    native_at: Word,
    params: Word,
    debug: Word,
